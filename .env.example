# Variables de entorno requeridas para el proyecto
# Copiá este archivo como .env y completá los valores

# Resend - API para envío de emails desde el formulario de contacto
# Obtené tu API key en https://resend.com/api-keys
RESEND_API_KEY=

# Email donde se reciben los mensajes del formulario de contacto
CONTACT_EMAIL=

# Google Analytics ID (opcional, formato G-XXXXXXXXXX)
# PUBLIC_GA_ID=

# Supabase - Auth y base de datos del panel admin
# Obtené las credenciales en https://app.supabase.com/project/_/settings/api
PUBLIC_SUPABASE_URL=
PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Secret para el endpoint /api/keep-alive (Vercel Cron → ping diario a Supabase)
# String random de 16+ caracteres. Vercel lo envía solo como Authorization: Bearer
# CRON_SECRET=
