---
import ChatPreview from './ChatPreview';

const accent = '#2BB673';
const bg = '#0A0B0D';
const surface = '#121316';
const textSoft = 'rgba(250,250,250,0.72)';
const line = 'rgba(250,250,250,0.08)';

const features = [
  { title: "Chatbots agénticos",    desc: "Bots que razonan y actúan por sí mismos. No siguen un árbol de decisión, deciden." },
  { title: "Chatbots que venden",   desc: "Cierran ventas mientras dormís. Toman pedidos, confirman, derivan al humano." },
  { title: "Base de conocimiento",  desc: "Aprenden de tu negocio. Cargás tu catálogo, FAQ y políticas — y listo." },
  { title: "Respuestas 24/7",       desc: "Atienden consultas sin esperas. WhatsApp, web, Instagram — todo en un sitio." },
  { title: "Dashboard en vivo",     desc: "Métricas en tiempo real. Conversaciones, leads calientes, fuga de clientes." },
  { title: "Multi-bot multiusuario",desc: "Gestioná varios bots y varios equipos desde un único panel." },
];
---

<section id="chatbots" class="relative" style={`background:${bg}; padding:clamp(64px, 8vw, 120px) 0;`}>
  <div class="max-w-[1320px] mx-auto px-6 md:px-10">

    <!-- Top: 2 columns — copy+cards+CTAs | chat -->
    <div class="grid grid-cols-1 lg:grid-cols-[1fr_1fr] gap-16 lg:gap-20 items-stretch">

      <!-- Left: kicker + title + subtitle + 6 cards + CTAs (al bottom) -->
      <div class="flex flex-col">
        <div class="text-center lg:text-left">
          <div class="inline-flex items-center gap-2.5 mb-[18px]">
            <span class="w-3.5 h-px" style={{ background: accent }}></span>
            <span class="text-[11px] tracking-[2.5px] uppercase" style={{ color: accent, fontFamily: "'JetBrains Mono', monospace" }}>
              04 ─── Inteligencia artificial
            </span>
          </div>

          <h2 class="font-geist font-semibold text-white leading-[1.02] tracking-tight mb-[20px]"
            style="font-size:clamp(36px, 4.5vw, 56px); letter-spacing:-0.025em;">
            Chatbots con IA que<br><span style={{ color: accent }}>trabajan por vos.</span>
          </h2>

          <p class="text-[17px] leading-[1.55] mb-8"
            style={{ color: textSoft, fontFamily: "'Inter', system-ui, sans-serif" }}>
            No son bots de plantilla con respuestas guionadas. Desarrollo asistentes agénticos que entienden tu negocio, cierran ventas y aprenden con el tiempo.
          </p>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-2.5">
          {features.map((f) => (
            <div class="flex flex-col gap-2 p-3.5 transition-colors hover:border-[rgba(43,182,115,0.3)]"
              style={{ background: surface, border: `1px solid ${line}`, borderRadius: '10px' }}>
              <div class="flex items-center gap-2">
                <span class="w-1.5 h-1.5 flex-shrink-0"
                  style={{ background: accent, borderRadius: '50%', boxShadow: `0 0 8px ${accent}` }}></span>
                <h3 class="text-[13px] font-semibold text-white tracking-tight"
                  style={{ fontFamily: "'Geist', 'Inter', system-ui, sans-serif" }}>{f.title}</h3>
              </div>
              <p class="text-[11.5px] leading-snug"
                style={{ color: textSoft, fontFamily: "'Inter', system-ui, sans-serif" }}>{f.desc}</p>
            </div>
          ))}
        </div>

        <!-- CTAs empujados al bottom de la columna -->
        <div class="flex flex-wrap gap-3 mt-auto pt-8">
          <a href="#contacto"
            class="inline-flex items-center gap-2 px-6 py-3.5 text-sm font-semibold transition-all hover:brightness-110"
            style={{ background: accent, color: '#06140C', fontFamily: "'Inter', system-ui, sans-serif", borderRadius: '10px' }}>
            Pedir demo gratis
          </a>
          <a href="#contacto"
            class="inline-flex items-center gap-2 px-6 py-3.5 text-sm font-semibold transition-all hover:brightness-105"
            style={{ background: surface, color: '#FAFAFA', border: `1px solid rgba(250,250,250,0.18)`, fontFamily: "'Inter', system-ui, sans-serif", borderRadius: '10px' }}>
            Ver Megabot en vivo →
          </a>
        </div>
      </div>

      <!-- Right: animated chat preview — desktop only -->
      <div class="hidden md:block w-full">
        <ChatPreview client:visible />
      </div>
    </div>

  </div>
</section>
