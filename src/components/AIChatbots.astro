---
import { Bot, MessageSquare, Brain, Zap, BarChart3, Shield } from 'lucide-react';

const capabilities = [
  {
    icon: Bot,
    title: "Chatbots agénticos",
    description: "Bots que razonan, deciden y actúan por sí mismos. No son simples autoresponders: entienden contexto y ejecutan tareas complejas."
  },
  {
    icon: MessageSquare,
    title: "Chatbots que venden",
    description: "Tus clientes ya están chateando. Tu bot les responde y cierra ventas ahí mismo, sin esperas ni demoras."
  },
  {
    icon: Brain,
    title: "Base de conocimiento",
    description: "El bot aprende de tu negocio: productos, horarios, políticas, precios. Responde con precisión."
  },
  {
    icon: Zap,
    title: "Respuestas 24/7",
    description: "Atiende consultas, agenda turnos, toma pedidos y califica leads mientras vos dormís."
  },
  {
    icon: BarChart3,
    title: "Dashboard de gestión",
    description: "Panel para ver conversaciones, métricas de atención y rendimiento de tus bots en tiempo real."
  },
  {
    icon: Shield,
    title: "Multi-bot y multiusuario",
    description: "Un dashboard para gestionar varios bots. Ideal si tenés más de un negocio o línea de servicio."
  }
];
---

<section class="ai-section" id="chatbots">
  <div class="ai-grid-bg"></div>
  <div class="ai-ambient-glow"></div>

  <div class="ai-container">
    <div class="ai-header">
      <h2 class="ai-title font-heading">
        Chatbots con IA que <em>trabajan por vos</em>
      </h2>
      <p class="ai-subtitle">
        No son bots de plantilla. Desarrollo chatbots agénticos que entienden tu negocio,
        atienden clientes y generan resultados reales.
      </p>
    </div>

    <div class="ai-body">
      <div class="ai-video-col">
        <div class="ai-video-frame">
          <video
            id="aiVideo"
            autoPlay
            loop
            muted
            playsInline
            class="ai-video"
          >
            <source src="https://res.cloudinary.com/djtvjkcu6/video/upload/v1778524165/SelvaDigital/A_seamless_ultra-slow_cinematic_loop_202605111528_dw1rop.mp4" type="video/mp4" />
          </video>
          <div class="ai-video-scanline"></div>
          <div class="ai-video-border"></div>
        </div>
      </div>

      <div class="ai-cards-col">
        <div class="ai-cards-grid">
          {capabilities.map((cap, i) => (
            <div class={`ai-card ai-card-${i}`}>
              <div class="ai-card-inner">
                <div class="ai-card-icon">
                  <cap.icon className="ai-card-icon-svg" />
                </div>
                <h3 class="ai-card-title">{cap.title}</h3>
                <p class="ai-card-desc">{cap.description}</p>
                <div class="ai-card-corner"></div>
              </div>
            </div>
          ))}
        </div>

        <div class="ai-cta-box">
          <div class="ai-cta-content">
            <h3 class="ai-cta-title font-heading">Querés verlo en acción?</h3>
            <p class="ai-cta-text">
              Tenés bots funcionando 24/7 para negocios reales. Te muestro cómo trabajan.
            </p>
          </div>
          <a href="#contacto" class="ai-cta-btn">
            <MessageSquare className="ai-cta-btn-icon" />
            <span>Pedir demo gratis</span>
          </a>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .ai-section {
    position: relative;
    padding: 5rem 0;
    background: #000;
    overflow: hidden;
  }

  @media (min-width: 640px) {
    .ai-section { padding: 7rem 0; }
  }

  .ai-grid-bg {
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(rgba(139, 92, 246, 0.03) 1px, transparent 1px),
      linear-gradient(90deg, rgba(139, 92, 246, 0.03) 1px, transparent 1px);
    background-size: 60px 60px;
    mask-image: radial-gradient(ellipse 80% 70% at 50% 50%, black 30%, transparent 100%);
    -webkit-mask-image: radial-gradient(ellipse 80% 70% at 50% 50%, black 30%, transparent 100%);
  }

  .ai-ambient-glow {
    position: absolute;
    top: 20%;
    left: 5%;
    width: 500px;
    height: 500px;
    background: radial-gradient(circle, rgba(139, 92, 246, 0.08) 0%, transparent 70%);
    pointer-events: none;
  }

  .ai-container {
    position: relative;
    z-index: 10;
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 1rem;
  }

  @media (min-width: 640px) {
    .ai-container { padding: 0 1.5rem; }
  }

  .ai-header {
    text-align: center;
    margin-bottom: 3.5rem;
  }

  @media (min-width: 640px) {
    .ai-header { margin-bottom: 5rem; }
  }

  .ai-title {
    font-size: 1.875rem;
    color: #fff;
    margin-bottom: 1rem;
    line-height: 1.15;
  }

  .ai-title em {
    font-style: normal;
    color: #a78bfa;
    position: relative;
  }

  @media (min-width: 640px) {
    .ai-title { font-size: 3rem; }
  }

  .ai-subtitle {
    color: #9ca3af;
    font-size: 0.95rem;
    max-width: 560px;
    margin: 0 auto;
    line-height: 1.7;
  }

  @media (min-width: 640px) {
    .ai-subtitle { font-size: 1.1rem; }
  }

  .ai-body {
    display: flex;
    flex-direction: column;
    gap: 3rem;
  }

  @media (min-width: 1024px) {
    .ai-body {
      flex-direction: row;
      gap: 3rem;
      align-items: stretch;
    }
  }

  /* VIDEO COLUMN */
  .ai-video-col {
    display: none;
  }

  @media (min-width: 1024px) {
    .ai-video-col {
      display: flex;
      flex-shrink: 0;
      width: 280px;
    }
  }

  .ai-video-frame {
    position: relative;
    border-radius: 0;
    overflow: hidden;
    width: 100%;
    display: flex;
    border: 1px solid rgba(139, 92, 246, 0.1);
  }

  @media (min-width: 1024px) {
    .ai-video-frame {
      flex: 1;
    }
  }

  .ai-video {
    width: 100%;
    height: auto;
    min-height: 320px;
    object-fit: cover;
    display: block;
  }

  @media (min-width: 1024px) {
    .ai-video {
      height: 100%;
      min-height: 100%;
    }
  }

  .ai-video-scanline {
    position: absolute;
    inset: 0;
    height: 100%;
    background: repeating-linear-gradient(
      0deg,
      transparent,
      transparent 2px,
      rgba(0, 0, 0, 0.1) 2px,
      rgba(0, 0, 0, 0.1) 4px
    );
    pointer-events: none;
    z-index: 2;
  }

  .ai-video-border {
    position: absolute;
    inset: -1px;
    border: 1px solid rgba(139, 92, 246, 0.2);
    pointer-events: none;
    z-index: 3;
  }

  .ai-video-border::before {
    content: '';
    position: absolute;
    top: -1px; left: -1px;
    width: 15px; height: 15px;
    border-top: 2px solid #8B5CF6;
    border-left: 2px solid #8B5CF6;
  }

  /* CARDS COLUMN */
  .ai-cards-col {
    flex: 1;
    min-width: 0;
    display: flex;
    flex-direction: column;
  }

  .ai-cards-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1rem;
    margin-bottom: 2.5rem;
    flex: 1;
  }

  @media (min-width: 640px) {
    .ai-cards-grid {
      grid-template-columns: 1fr 1fr;
      gap: 1.25rem;
    }
  }

  .ai-card {
    position: relative;
    border-radius: 0;
    background: rgba(255, 255, 255, 0.01);
  }

  .ai-card-inner {
    position: relative;
    background: rgba(139, 92, 246, 0.02);
    border: 1px solid rgba(139, 92, 246, 0.08);
    border-radius: 0;
    padding: 1.5rem;
    height: 100%;
    transition: all 0.3s ease;
  }

  .ai-card:hover .ai-card-inner {
    background: rgba(139, 92, 246, 0.04);
    border-color: rgba(139, 92, 246, 0.3);
    box-shadow: 0 0 20px rgba(139, 92, 246, 0.05);
  }

  .ai-card-corner {
    position: absolute;
    bottom: -1px;
    right: -1px;
    width: 8px;
    height: 8px;
    border-bottom: 2px solid rgba(139, 92, 246, 0.2);
    border-right: 2px solid rgba(139, 92, 246, 0.2);
    transition: border-color 0.3s ease;
  }

  .ai-card:hover .ai-card-corner {
    border-color: #8B5CF6;
  }

  .ai-card-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 32px;
    margin-bottom: 1rem;
  }

  :global(.ai-card-icon-svg) {
    width: 20px;
    height: 20px;
    color: #a78bfa;
  }

  .ai-card-title {
    color: #f3f4f6;
    font-size: 1rem;
    font-weight: 600;
    font-family: -apple-system, BlinkMacSystemFont, 'Inter', 'Segoe UI', system-ui, sans-serif;
    margin-bottom: 0.5rem;
  }

  .ai-card-desc {
    color: #9ca3af;
    font-size: 0.85rem;
    line-height: 1.6;
  }

  /* CTA BOX */
  .ai-cta-box {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    align-items: flex-start;
    background: rgba(139, 92, 246, 0.04);
    border: 1px solid rgba(139, 92, 246, 0.15);
    border-radius: 0;
    padding: 1.5rem;
  }

  @media (min-width: 640px) {
    .ai-cta-box {
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
      padding: 2rem;
    }
  }

  .ai-cta-content {
    flex: 1;
  }

  .ai-cta-title {
    color: #fff;
    font-size: 1.25rem;
    margin-bottom: 0.5rem;
  }

  .ai-cta-text {
    color: #9ca3af;
    font-size: 0.9rem;
    line-height: 1.5;
  }

  .ai-cta-btn {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    background: #8B5CF6;
    color: #fff;
    font-weight: 600;
    font-size: 0.9rem;
    padding: 0.875rem 2rem;
    border-radius: 0;
    text-decoration: none;
    transition: all 0.3s ease;
    white-space: nowrap;
    border: 1px solid transparent;
  }

  .ai-cta-btn:hover {
    background: transparent;
    border-color: #8B5CF6;
    color: #8B5CF6;
    box-shadow: 0 0 20px rgba(139, 92, 246, 0.2);
  }

  :global(.ai-cta-btn-icon) {
    width: 18px;
    height: 18px;
  }

  /* STAGGERED ENTRANCE */
  .ai-card-0 { animation: aiFadeIn 0.5s ease both 0.1s; }
  .ai-card-1 { animation: aiFadeIn 0.5s ease both 0.2s; }
  .ai-card-2 { animation: aiFadeIn 0.5s ease both 0.3s; }
  .ai-card-3 { animation: aiFadeIn 0.5s ease both 0.4s; }
  .ai-card-4 { animation: aiFadeIn 0.5s ease both 0.5s; }
  .ai-card-5 { animation: aiFadeIn 0.5s ease both 0.6s; }

  @keyframes aiFadeIn {
    from {
      opacity: 0;
      transform: translateY(16px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
</style>

<script>
  const video = document.getElementById('aiVideo');
  if (video) video.playbackRate = 0.5;
</script>
