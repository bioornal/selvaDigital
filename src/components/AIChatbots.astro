---
import { Bot, MessageSquare, Brain, Zap, BarChart3, Shield } from 'lucide-react';

const capabilities = [
  { icon: Bot, title: "Chatbots agénticos", desc: "Bots que razonan y actúan por sí mismos." },
  { icon: MessageSquare, title: "Chatbots que venden", desc: "Cierran ventas mientras dormís." },
  { icon: Brain, title: "Base de conocimiento", desc: "Aprenden de tu negocio." },
  { icon: Zap, title: "Respuestas 24/7", desc: "Atienden consultas sin esperas." },
  { icon: BarChart3, title: "Dashboard", desc: "Métricas en tiempo real." },
  { icon: Shield, title: "Multi-bot", desc: "Gestiona varios bots." }
];
---

<section id="chatbots" class="py-16 sm:py-24 bg-black relative">
  <div class="absolute inset-0 opacity-5 pointer-events-none"
       style="background-image: linear-gradient(rgba(139,92,246,0.1) 1px, transparent 1px), linear-gradient(90deg, rgba(139,92,246,0.1) 1px, transparent 1px); background-size: 40px 40px;">
  </div>

  <div class="container mx-auto px-4 relative z-10">
    <div class="text-center mb-10 sm:mb-14">
      <h2 class="text-2xl sm:text-4xl font-heading text-white mb-3">
        Chatbots con IA que <em class="text-violet-400">trabajan por vos</em>
      </h2>
      <p class="text-gray-400 text-sm sm:text-base max-w-xl mx-auto">
        No son bots de plantilla. Desarrollo chatbots agénticos que entienden tu negocio.
      </p>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4 mb-8">
      {capabilities.map((cap) => (
        <div class="p-5 bg-white/5 border border-violet-500/20 rounded-none hover:border-violet-500/50 transition-colors">
          <cap.icon className="w-6 h-6 text-violet-400 mb-3" />
          <h3 class="text-sm font-bold text-white mb-1">{cap.title}</h3>
          <p class="text-xs text-gray-400">{cap.desc}</p>
        </div>
      ))}
    </div>

    <div class="text-center">
      <a href="#contacto" class="inline-flex items-center gap-2 bg-violet-600 text-white px-6 py-3 text-sm font-semibold rounded-none hover:bg-violet-500 transition-colors">
        <MessageSquare className="w-4 h-4" />
        <span>Pedir demo gratis</span>
      </a>
    </div>
  </div>
</section>

<style>
  .font-heading {
    font-family: 'Nova Square', sans-serif;
  }
</style>