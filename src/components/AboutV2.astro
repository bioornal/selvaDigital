---
import { whatsappLink } from '../lib/constants';
import WaIcon from './ui/WaIcon';


const steps = [
  { n: '01', t: 'Hablamos de tu idea',            d: 'Me contás qué vendés y a quién. Salís de la llamada sabiendo si esto te sirve, sin compromiso ni "te confirmo después".' },
  { n: '02', t: 'Te paso un plan claro',          d: 'Recibís precio cerrado, alcance y fecha de entrega por escrito. Sabés exactamente cuánto pagás y qué obtenés antes de decir que sí.' },
  { n: '03', t: 'Construyo con avances semanales', d: 'Ves el sitio crecer cada semana y pedís cambios cuando los necesitás. No esperás 6 semanas para descubrir que algo no era lo que pensabas.' },
  { n: '04', t: 'Lanzamos y quedás operando',     d: 'Tu negocio queda online y vendiendo. Te muestro cómo recibir las consultas y a quién contactar si algo necesita atención.' },
];
const WA_ABOUT = whatsappLink('¡Hola Christian! Quiero hablar con vos sobre mi proyecto.');
---
<section id="sobre" class="section on-deep" aria-labelledby="about-title">
  <div class="wrap">
    <h2 id="about-title" class="h2 about-title">Hablás conmigo de punta a punta.</h2>
    <div class="about-grid">
      <figure class="about-photo">
        <img src="https://res.cloudinary.com/djtvjkcu6/image/upload/c_fill,g_face,w_800,h_1000,q_auto,f_auto/v1778507882/SelvaDigital/yo_perfil_ekrrxc.jpg" alt="Christian Speziali" width="800" height="1000" loading="lazy" decoding="async" />
      </figure>
      <div class="about-content">
        <h3 class="h3 about-name">Soy Christian Speziali.</h3>
        <p class="about-bio hidden md:block">Soy desarrollador web freelance desde Córdoba. Ayudo a dueños de PyMEs argentinas a dejar de perder ventas online y recuperar horas de su semana con herramientas hechas para su negocio.</p>
        <p class="about-bio md:hidden">Desarrollador freelance desde Córdoba. Hago webs y sistemas para que tu negocio venda más y te ocupe menos.</p>
        <div class="about-direct" aria-label="Disponibilidad">
          <p>Te respondo en menos de 24 h.</p>
          <p class="direct-capacity">Tomo máximo 3 proyectos a la vez.</p>
          <a href={WA_ABOUT} target="_blank" rel="noopener noreferrer" class="btn btn-primary about-cta"><WaIcon size={18} /> Hablemos de tu proyecto</a>
        </div>
        <ul class="about-commitments" aria-label="Mis compromisos">
          <li>Aprobás la propuesta visual antes de que empiece a programar.</li>
          <li>Tu dominio y tus contenidos son siempre tuyos, pagues con abono o de una vez.</li>
        </ul>
      </div>
    </div>
    <div class="about-process" aria-labelledby="process-title">
      <h3 id="process-title" class="h3">De la idea al lanzamiento, en cuatro pasos.</h3>
      <ol class="process-desktop">
        {steps.map(s => (
          <li><span class="mono process-number">{s.n}</span><h4>{s.t}</h4><p>{s.d}</p></li>
        ))}
      </ol>
      <div class="process-mobile">
        {steps.map((s, i) => (
          <details open={i === 0}>
            <summary><span class="mono process-number">{s.n}</span><span class="process-label">{s.t}</span><span class="process-icon" aria-hidden="true"></span></summary>
            <p>{s.d}</p>
          </details>
        ))}
      </div>
    </div>
  </div>
</section>
<style>
  .about-title { margin: 0 0 clamp(32px, 4vw, 56px); max-width: 20ch; font-size: var(--fs-h2-compact); }
  .about-grid { display: grid; gap: 24px; }
  .about-content { min-width: 0; }
  .about-photo { margin: 0; }
  .about-photo img { display: block; width: 112px; height: 140px; object-fit: cover; border: 1px solid var(--line-petrol-strong); border-radius: 0; }
  .about-name { margin: 0 0 16px; }
  .about-bio { margin: 0 0 28px; font-size: var(--fs-body); line-height: 1.55; color: var(--on-petrol-soft); max-width: 62ch; }
  .about-direct { padding: clamp(24px, 3vw, 40px); background: var(--petrol-raised); color: var(--ice); border: 1px solid var(--line-petrol-strong); }
  .about-direct p { margin: 0; max-width: 45ch; font-size: var(--fs-body); line-height: 1.5; }
  .about-direct .direct-capacity { margin-top: 12px; font-size: var(--fs-small); font-weight: 700; }
  .about-cta { margin-top: 28px; width: 100%; padding: 12px 16px; text-align: center; }
  .about-cta:focus-visible { outline-color: var(--petrol); }
  .about-commitments { list-style: none; padding: 0; margin: 24px 0; }
  .about-commitments li { padding-block: 14px; border-bottom: 1px solid var(--line-petrol); font-size: var(--fs-small); line-height: 1.5; color: var(--on-petrol-soft); }
  .about-process { margin-top: clamp(56px, 7vw, 96px); }
  .about-process > h3 { margin: 0 0 28px; }
  .process-desktop { display: none; list-style: none; padding: 0; margin: 0; }
  .process-number { color: var(--on-petrol-dim); }
  .process-desktop h4 { font-size: var(--fs-title); font-weight: 700; line-height: 1.2; margin: 20px 0 14px; }
  .process-desktop p, .process-mobile p { font-size: var(--fs-small); line-height: 1.6; color: var(--on-petrol-soft); margin: 0; }
  .process-mobile details { border-top: 1px solid var(--line-petrol-strong); }
  .process-mobile details:last-child { border-bottom: 1px solid var(--line-petrol-strong); }
  .process-mobile summary { display: grid; grid-template-columns: 26px minmax(0, 1fr) 16px; gap: 12px; align-items: center; cursor: pointer; list-style: none; padding: 20px 0; }
  .process-mobile summary::-webkit-details-marker { display: none; }
  .process-label { font-size: var(--fs-body); font-weight: 700; line-height: 1.25; }
  .process-mobile p { padding: 0 0 24px 38px; }
  .process-icon { position: relative; width: 16px; height: 16px; }
  .process-icon::before, .process-icon::after { content: ''; position: absolute; background: currentColor; width: 14px; height: 1px; top: 7px; left: 1px; }
  .process-icon::after { transform: rotate(90deg); }
  details[open] .process-icon::after { transform: rotate(0); }
  @media (min-width: 768px) {
    .about-grid { grid-template-columns: repeat(12, minmax(0, 1fr)); gap: clamp(24px, 4vw, 64px); align-items: start; }
    .about-photo { grid-column: span 4; }
    .about-photo img { width: 100%; height: auto; aspect-ratio: 4 / 5; }
    .about-content { grid-column: span 8; }
    .about-cta { width: auto; }
    .process-desktop { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 28px; }
    .process-desktop li { border-top: 1px solid var(--line-petrol-strong); padding-top: 20px; }
    .process-mobile { display: none; }
  }
</style>
