---
const accent = '#2BB673';
const bg = '#0A0B0D';
const surface = '#121316';
const white = '#FAFAFA';
const textSoft = 'rgba(250,250,250,0.72)';
const textDim = 'rgba(250,250,250,0.46)';
const line = 'rgba(250,250,250,0.08)';
const lineStr = 'rgba(250,250,250,0.18)';

const kpi = [
  { n: '15+', k: 'proyectos en producción', s: 'Argentina' },
  { n: '6',   k: 'años desarrollando', s: 'full-stack' },
  { n: '100%',k: 'código propio', s: 'sin templates' },
];

const stack = ['React','Next.js','Astro','TypeScript','Node.js','PostgreSQL','MongoDB','Firebase','Tailwind','Vercel','VPS','MercadoPago','OpenAI','Anthropic'];

const steps = [
  { n: '01', t: 'Hablamos de tu idea',            d: 'Me contás qué vendés y a quién. Salís de la llamada sabiendo si esto te sirve, sin compromiso ni "te confirmo después".' },
  { n: '02', t: 'Te paso un plan claro',          d: 'Recibís precio cerrado, alcance y fecha de entrega por escrito. Sabés exactamente cuánto pagás y qué obtenés antes de decir que sí.' },
  { n: '03', t: 'Construyo con avances semanales', d: 'Ves el sitio crecer cada semana y pedís cambios cuando los necesitás. No esperás 6 semanas para descubrir que algo no era lo que pensabas.' },
  { n: '04', t: 'Lanzamos y quedás operando',     d: 'Tu negocio queda online y vendiendo. Te muestro cómo recibir las consultas y a quién contactar si algo necesita atención.' },
];
---

<section id="sobre" class="relative" style={`background:${bg}; padding:clamp(64px, 8vw, 120px) 0;`}>
  <div class="max-w-[1320px] mx-auto px-6 md:px-10">
    <div class="grid md:grid-cols-[1.2fr_0.85fr] gap-8 md:gap-16 items-start">
      {/* Left content */}
      <div>
        <div class="text-left">
          <div class="inline-flex items-center gap-2.5 mb-[18px]">
            <span class="w-3.5 h-px" style={{ background: accent }}></span>
            <span class="text-[11px] tracking-[2.5px] uppercase" style={{ color: accent, fontFamily: "'JetBrains Mono', monospace" }}>
              08 ─── Sobre mí
            </span>
          </div>

          <h2 class="font-geist font-semibold text-white leading-[1] tracking-tight mb-4"
            style="font-size:clamp(36px, 4vw, 64px); letter-spacing:-0.03em;">
            Un solo interlocutor.<br>
            <span style={{ color: accent }}>De la idea al deploy.</span>
          </h2>

          {/* Desktop: bajada extendida */}
          <p class="hidden md:block text-[17px] leading-[1.55] mb-8 max-w-[620px] md:mx-0" style={{ color: textSoft, fontFamily: "'Inter', system-ui, sans-serif" }}>
            Soy Christian Speziali, desarrollador web freelance desde Córdoba. Hace 6 años que ayudo a dueños de PyMEs argentinas a dejar de perder ventas online, recuperar horas de su semana y aparecer primeros en Google — sin tarifas mensuales escondidas.
          </p>

          {/* Mobile: bajada compacta */}
          <p class="md:hidden text-[15px] leading-[1.55] mb-6" style={{ color: textSoft, fontFamily: "'Inter', system-ui, sans-serif" }}>
            Desarrollador freelance desde Córdoba. Hablás directo conmigo de principio a fin — sin agencias ni intermediarios. <strong class="text-white font-semibold">Tomo máximo 3 proyectos a la vez.</strong>
          </p>
        </div>

        {/* Desktop only: párrafos secundarios */}
        <div class="hidden md:flex flex-col gap-3.5 mb-10">
          <p class="text-[15.5px] leading-relaxed max-w-[620px]" style={{ color: textSoft, fontFamily: "'Inter', system-ui, sans-serif" }}>
            Trabajo solo. Eso significa que vos hablás conmigo de principio a fin —
            presupuesto, diseño, programación, deploy y soporte. Sin agencia
            intermediando, sin equipos rotando, sin mensajes que rebotan entre
            cinco personas distintas.
          </p>
          <p class="text-[15.5px] leading-relaxed max-w-[620px]" style={{ color: textSoft, fontFamily: "'Inter', system-ui, sans-serif" }}>
            Pero también significa que <strong class="text-white font-semibold">no tomo más de 3
            proyectos en simultáneo</strong>. Si te interesa trabajar conmigo,
            conversemos rápido para ver si entrás en la próxima ventana.
          </p>
        </div>

        {/* Process */}
        <div>
          <div class="text-[11px] tracking-[2px] mb-4" style={{ color: textDim, fontFamily: "'JetBrains Mono', monospace" }}>CÓMO TRABAJO</div>
          <div class="flex flex-col process-steps" style={{ border: `1px solid ${line}`, borderRadius: '10px', overflow: 'hidden' }}>
            {steps.map((s, i) => (
              <>
                {/* Mobile: accordion <details> nativo */}
                <details
                  class="md:hidden process-step-mobile"
                  open={i === 0}
                  style={{
                    background: surface,
                    borderBottom: i < 3 ? `1px solid ${line}` : 'none'
                  }}
                >
                  <summary class="grid grid-cols-[44px_1fr_auto] gap-4 items-center px-5 py-3.5 cursor-pointer list-none">
                    <span class="text-xs tracking-[1px]" style={{ color: accent, fontFamily: "'JetBrains Mono', monospace" }}>{s.n}</span>
                    <span class="font-geist font-semibold text-white text-sm">{s.t}</span>
                    <span class="process-step-chevron text-xs transition-transform" style={{ color: textDim }}>▾</span>
                  </summary>
                  <div class="px-5 pb-3.5 pl-[68px] text-[13px]" style={{ color: textSoft, fontFamily: "'Inter', system-ui, sans-serif" }}>
                    {s.d}
                  </div>
                </details>

                {/* Desktop: tabla con 3 columnas, idéntico al estado previo */}
                <div class="hidden md:grid grid-cols-[60px_1fr_1.6fr] gap-6 items-center px-6 py-3.5" style={{
                  background: surface,
                  borderBottom: i < 3 ? `1px solid ${line}` : 'none'
                }}>
                  <span class="text-xs tracking-[1px]" style={{ color: accent, fontFamily: "'JetBrains Mono', monospace" }}>{s.n}</span>
                  <span class="font-geist font-semibold text-white text-base">{s.t}</span>
                  <span class="text-[13px]" style={{ color: textSoft, fontFamily: "'Inter', system-ui, sans-serif" }}>{s.d}</span>
                </div>
              </>
            ))}
          </div>
        </div>

        <div class="hidden md:flex gap-3 mt-8 justify-center md:justify-start">
          <a href="#contacto" class="inline-flex items-center gap-2 px-6 py-3.5 text-sm font-semibold transition-all hover:brightness-110"
            style={{ background: accent, color: '#06140C', fontFamily: "'Inter', system-ui, sans-serif", borderRadius: '10px' }}>
            Conversemos →
          </a>
          <a href="#portfolio" class="inline-flex items-center gap-2 px-6 py-3.5 text-sm font-medium transition-all"
            style={{ background: surface, color: white, border: `1px solid ${lineStr}`, fontFamily: "'Inter', system-ui, sans-serif", borderRadius: '10px' }}>
            Ver portfolio →
          </a>
        </div>
      </div>

      {/* Right: Photo + KPIs + Stack — desktop only */}
      <div class="hidden md:flex relative flex-col gap-7">
        {/* Green halo */}
        <div class="absolute pointer-events-none" style="inset:-30px; background:radial-gradient(circle at 30% 40%, rgba(43,182,115,0.12), transparent 65%); filter:blur(8px); z-index:0;"></div>

        <div class="relative w-full overflow-hidden" style={{ aspectRatio: '4/5', background: surface, border: `1px solid ${lineStr}`, borderRadius: '18px' }}>
          <img
            src="https://res.cloudinary.com/djtvjkcu6/image/upload/c_fill,w_900,h_1100,g_face,q_auto,f_auto/v1778507882/SelvaDigital/yo_perfil_ekrrxc.jpg"
            alt="Christian A. Speziali"
            class="w-full h-full object-cover"
          />
          <div class="absolute inset-0" style={{ background: 'linear-gradient(180deg, transparent 55%, rgba(10,11,13,0.75))' }}></div>

          {/* Top badge */}
          <div class="absolute top-4 left-4 right-4 flex justify-between items-center">
            <span class="inline-flex items-center gap-1.5 text-[10px] tracking-[1.5px] px-2.5 py-1.5" style={{
              color: accent,
              background: 'rgba(10,11,13,0.8)',
              backdropFilter: 'blur(8px)',
              border: `1px solid ${lineStr}`,
              fontFamily: "'JetBrains Mono', monospace",
              borderRadius: '999px'
            }}>
              <span class="w-1.5 h-1.5 inline-block" style={{ background: accent, borderRadius: '50%', boxShadow: `0 0 8px ${accent}` }}></span>
              ONLINE
            </span>
            <span class="text-[9px] tracking-[1.5px]" style={{ color: textDim, fontFamily: "'JetBrains Mono', monospace" }}>FOUNDER // SELVA</span>
          </div>

          {/* Bottom badge */}
          <div class="absolute flex justify-between items-end" style="left:24px; bottom:24px; right:24px;">
            <div>
              <div class="text-[10px] tracking-[2px] mb-1.5" style={{ color: accent, fontFamily: "'JetBrains Mono', monospace" }}>
                <span class="w-1.5 h-1.5 inline-block mr-2" style={{ background: accent, borderRadius: '50%', boxShadow: `0 0 8px ${accent}`, verticalAlign: 'middle' }}></span>
                ONLINE
              </div>
              <div class="font-geist font-semibold text-white tracking-tight" style="font-size:22px; letter-spacing:-0.01em;">Christian A.<br/>Speziali</div>
              <div class="text-[12.5px] mt-1.5" style={{ color: textSoft, fontFamily: "'Inter', system-ui, sans-serif" }}>Founder & Developer · Selva Digital</div>
              <div class="text-[10px] tracking-[1px] mt-0.5" style={{ color: textDim, fontFamily: "'JetBrains Mono', monospace" }}>CÓRDOBA, AR</div>
            </div>
            <a href="https://wa.me/5493548550334" target="_blank" class="text-xs font-medium px-3.5 py-2" style={{
              background: 'rgba(10,11,13,0.8)',
              backdropFilter: 'blur(8px)',
              border: `1px solid ${lineStr}`,
              color: white,
              fontFamily: "'Inter', system-ui, sans-serif",
              borderRadius: '999px',
              textDecoration: 'none'
            }}>WhatsApp →</a>
          </div>
        </div>

        {/* KPIs en columna derecha — desktop only */}
        <div class="hidden md:grid grid-cols-3 gap-2 md:gap-2.5">
          {kpi.map(s => (
            <div class="kpi-card" style={{ background: surface, border: `1px solid ${line}`, borderRadius: '10px' }}>
              <div class="font-geist font-semibold text-white leading-none kpi-num" style={{ letterSpacing: '-0.025em' }}>
                {s.n}
              </div>
              <div class="text-[10.5px] md:text-[11.5px] mt-1.5 leading-tight" style={{ color: textSoft, fontFamily: "'Inter', system-ui, sans-serif" }}>{s.k}</div>
              <div class="text-[9px] tracking-[1px] mt-1" style={{ color: textDim, fontFamily: "'JetBrains Mono', monospace" }}>{s.s.toUpperCase()}</div>
            </div>
          ))}
        </div>

        {/* Stack en columna derecha — desktop only */}
        <div class="hidden md:block relative">
          <div class="text-[10.5px] tracking-[2px] mb-3" style={{ color: textDim, fontFamily: "'JetBrains Mono', monospace" }}>STACK PRINCIPAL // 2026</div>
          <div class="flex flex-wrap gap-1.5" data-stack-wrap>
            {stack.map((t, i) => (
              <span class={`text-[11px] tracking-wide px-2.5 py-1.5 ${i >= 6 ? 'stack-extra' : ''}`} style={{
                color: textSoft,
                background: surface,
                border: `1px solid ${line}`,
                fontFamily: "'JetBrains Mono', monospace",
                borderRadius: '7px'
              }}>{t}</span>
            ))}
            <button
              type="button"
              class="md:hidden stack-toggle text-[11px] tracking-wide px-2.5 py-1.5"
              style={{
                color: accent,
                background: 'rgba(43,182,115,0.08)',
                border: `1px solid rgba(43,182,115,0.3)`,
                fontFamily: "'JetBrains Mono', monospace",
                borderRadius: '7px',
                cursor: 'pointer'
              }}
              data-stack-toggle
              aria-expanded="false"
            >
              Ver todo (+{stack.length - 6}) →
            </button>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  /* En mobile, ocultamos los tags >6 hasta que el usuario toque "Ver todo" */
  @media (max-width: 767px) {
    .stack-extra { display: none; }
    [data-stack-wrap].is-expanded .stack-extra { display: inline-flex; }
    [data-stack-wrap].is-expanded .stack-toggle { display: none; }
  }

  /* Process steps accordion (mobile) — chevron rota cuando expande */
  .process-step-mobile summary::-webkit-details-marker { display: none; }
  .process-step-mobile[open] .process-step-chevron {
    transform: rotate(180deg);
  }
  .process-step-mobile summary:hover .process-step-chevron {
    color: #2BB673;
  }

  /* KPIs compactos en mobile */
  .kpi-card { padding: 12px 10px; }
  .kpi-num { font-size: clamp(22px, 6vw, 28px); }
  @media (min-width: 768px) {
    .kpi-card { padding: 14px 14px; }
    .kpi-num { font-size: 28px; }
  }
</style>

<script>
  // Stack tags collapse — mobile only
  document.querySelectorAll<HTMLElement>('[data-stack-wrap]').forEach(wrap => {
    const btn = wrap.querySelector<HTMLButtonElement>('[data-stack-toggle]');
    if (!btn) return;
    btn.addEventListener('click', () => {
      wrap.classList.add('is-expanded');
      btn.setAttribute('aria-expanded', 'true');
    });
  });
</script>
