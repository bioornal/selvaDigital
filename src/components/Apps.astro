---
import { Smartphone, Server, Bell, Lock } from 'lucide-react';

const appFeatures = [
  { icon: Server, title: "Backend propio", description: "API y base de datos dedicados" },
  { icon: Bell, title: "Notificaciones push", description: "Alertas en tiempo real" },
  { icon: Lock, title: "Autenticación segura", description: "Roles y permisos personalizados" },
  { icon: Smartphone, title: "Apps web y móviles", description: "Funcionan en cualquier dispositivo" }
];
---

<section id="apps" class="py-10 sm:py-20 bg-black relative overflow-hidden">
  <!-- Grid overlay -->
  <div class="absolute inset-0 opacity-[0.03] pointer-events-none" 
       style="background-image: linear-gradient(rgba(59,130,246,1) 1px, transparent 1px), linear-gradient(90deg, rgba(59,130,246,1) 1px, transparent 1px); background-size: 50px 50px;">
  </div>

  <div class="container mx-auto px-3 sm:px-4 relative z-10">
    <div class="max-w-5xl mx-auto">
      <div class="hud-container p-5 sm:p-10">
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-6 sm:gap-10 items-center">
          <div class="relative">
            <div class="absolute inset-0 bg-gradient-to-br from-azure-radiance-500/10 via-ai-violet-500/5 to-transparent blur-2xl"></div>
            <img 
              src="https://res.cloudinary.com/djtvjkcu6/image/upload/v1778524165/SelvaDigital/ChatGPT_Image_11_may_2026_02_54_16_p.m._i6lpzu.png" 
              alt="Tecnología móvil con IA"
              class="relative w-full h-auto opacity-90"
              loading="lazy"
            />
          </div>

          <div>
            <div class="flex items-center gap-2 mb-4">
              <Smartphone className="w-4 h-4 text-azure-radiance-400" />
              <span class="text-azure-radiance-400 text-xs font-mono uppercase tracking-[0.15em]">Apps a medida</span>
            </div>
            <h2 class="text-2xl sm:text-4xl font-heading text-white mb-3 sm:mb-4">
              Necesitás algo más que una web?
            </h2>
            <p class="text-gray-400 text-sm sm:text-base mb-6 leading-relaxed">
              Desarrollo aplicaciones completas con backend propio, panel de administración 
              y base de datos dedicada. Desde un sistema de gestión hasta una app para tus clientes.
            </p>

            <div class="grid grid-cols-2 gap-3 mb-6">
              {appFeatures.map((feat) => (
                <div class="flex items-center gap-2.5">
                  <feat.icon className="w-4 h-4 text-azure-radiance-400 flex-shrink-0" />
                  <div>
                    <p class="text-white text-xs font-medium">{feat.title}</p>
                    <p class="text-gray-500 text-[10px]">{feat.description}</p>
                  </div>
                </div>
              ))}
            </div>

            <a 
              href="#contacto" 
              class="inline-flex items-center gap-2 bg-azure-radiance-500 hover:bg-azure-radiance-600 text-white px-5 py-2.5 rounded-none font-medium text-sm transition-all duration-300 hover:scale-105"
            >
              Contame tu idea
            </a>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
