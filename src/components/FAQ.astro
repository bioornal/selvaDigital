---
const accent = '#2BB673';
const bg = '#0A0B0D';
const surface = '#121316';
const white = '#FAFAFA';
const textSoft = 'rgba(250,250,250,0.72)';
const textDim = 'rgba(250,250,250,0.46)';
const line = 'rgba(250,250,250,0.08)';

const qs = [
  { q: 'Cuánto tarda un proyecto web?',
    a: 'Una landing page: 5 a 7 días hábiles. Un sitio completo: 2 a 3 semanas. Un e-commerce o sistema a medida: 4 a 8 semanas según alcance. Antes de arrancar te paso un cronograma por escrito con fechas tentativas semana a semana.' },
  { q: 'El precio es único o hay mensualidades?',
    a: 'Pago único, modalidad 50% al inicio y 50% contra entrega. No hay cuotas mensuales mías. El hosting y el dominio se contratan aparte y quedan a tu nombre: no quedás atado a mí, pagás directo al proveedor.' },
  { q: 'Cuánto cuesta el hosting y el dominio?',
    a: 'En Hostinger ronda los AR$ 9.300/mes con dominio .com incluido el primer año. Yo te ayudo a elegir el plan y el plazo que más te conviene según tu proyecto.' },
  { q: '¿Y si no quiero contratar Hostinger?',
    a: 'No hay problema. Podés elegir el proveedor de hosting que prefieras — yo trabajo con Hostinger porque me parece la mejor relación precio/servicio para PyMEs, pero la decisión final es tuya.' },
  { q: '¿Y si después de la entrega necesito cambios o sumar funciones?',
    a: 'Los ajustes menores los primeros 15 días después del lanzamiento van sin cargo (errores, retoques visuales). Cambios más grandes o funciones nuevas se cotizan aparte — siempre con presupuesto cerrado antes de arrancar, sin sorpresas.' },
  { q: '¿Qué pasa si no me gusta el diseño?',
    a: 'Antes de programar una sola línea de código te muestro una propuesta visual completa. Sobre esa propuesta hacemos hasta dos rondas de cambios sin costo hasta que estés conforme. Recién ahí arranca la programación: nunca te entrego algo que no aprobaste primero.' },
  { q: 'Hago el diseño yo o lo hacés vos?',
    a: 'Lo hago yo. Diseño y programo cada proyecto desde cero — no son plantillas. Antes de programar te muestro una propuesta visual; sobre eso iteramos hasta que esté.' },
  { q: 'Trabajás solo o tenés equipo?',
    a: 'Trabajo solo. Vos hablás directo conmigo de principio a fin: presupuesto, diseño, programación, deploy, soporte. Eso es más rápido y más barato que una agencia — pero significa que no tomo más de 3 proyectos en simultáneo.' },
  { q: 'Trabajás solo en Argentina?',
    a: 'Sí, trabajo exclusivamente con clientes en Argentina. El foco está en PyMEs argentinas que quieren digitalizar su negocio sin tarifas mensuales escondidas.' },
];
---

<section id="faq" class="faq-section relative" style={`background:${bg};`}>
  <div class="max-w-[1080px] mx-auto px-6 md:px-10">
    <div class="grid md:grid-cols-[1fr_1.4fr] gap-8 md:gap-20 items-stretch">
      {/* Left column — heading + decorative image que rellena el alto del FAQ */}
      <div class="faq-heading flex flex-col text-center md:text-left reveal reveal-slide-up">
        <div class="inline-flex items-center gap-2.5 mb-[14px] md:mb-[18px]">
          <span class="w-3.5 h-px" style={{ background: accent }}></span>
          <span class="text-[11px] tracking-[2.5px] uppercase" style={{ color: accent, fontFamily: "'JetBrains Mono', monospace" }}>
            07 ─── FAQ
          </span>
        </div>
        <h2 class="section-h2 faq-h2 font-geist font-semibold text-white leading-[1.02] tracking-tight"
          style="letter-spacing:-0.025em;">
          Preguntas<br><span style={{ color: accent }}>frecuentes.</span>
        </h2>
        <p class="section-sub faq-sub leading-relaxed" style={{ color: textSoft, fontFamily: "'Inter', system-ui, sans-serif" }}>
          Lo que más me preguntan antes de arrancar un proyecto. Si tu duda no está, escribime y la respondo el mismo día.
        </p>
        <a href="#contacto" class="faq-cta inline-flex items-center gap-2 text-sm font-semibold rounded-none transition-all hover:brightness-110"
          style={{ background: accent, color: '#06140C', fontFamily: "'Inter', system-ui, sans-serif", borderRadius: '0px' }}>
          Hacer una consulta →
        </a>

        {/* Decorative image — desktop only, stretches to match FAQ list height */}
        <div class="hidden md:flex relative mt-10 flex-1 min-h-[420px]">
          <div class="absolute pointer-events-none" style="inset:-24px; background:radial-gradient(circle at 30% 40%, rgba(43,182,115,0.14), transparent 65%); filter:blur(12px); z-index:0;"></div>
          <div class="relative w-full overflow-hidden" style={{ border: `1px solid ${line}`, borderRadius: '12px' }}>
            <img
              src="https://res.cloudinary.com/djtvjkcu6/image/upload/c_fill,g_auto,w_900,h_1200,q_auto,f_auto/v1779461418/SelvaDigital/ChatGPT_Image_22_may_2026_11_48_27_a.m._jpiiau.png"
              alt="Hojas de selva tropical iluminadas por luz verde — decorativo"
              loading="lazy"
              decoding="async"
              class="w-full h-full object-cover"
            />
          </div>
        </div>
      </div>

      {/* Accordion */}
      <div class="faq-list flex flex-col reveal reveal-slide-up delay-150">
        {qs.map((item, i) => (
          <div class="faq-item overflow-hidden transition-all" style={{
            background: i === 0 ? surface : bg,
            border: `1px solid ${i === 0 ? 'rgba(43,182,115,0.35)' : line}`
          }}>
            <button class="faq-trigger w-full flex items-center justify-between text-left bg-transparent border-none gap-3"
              style={{ fontFamily: "'Geist', 'Inter', system-ui, sans-serif", fontWeight: 500, color: white, letterSpacing: '-0.01em' }}
              aria-expanded={i === 0 ? 'true' : 'false'}
              aria-controls={`faq-panel-${i}`}
              id={`faq-trigger-${i}`}>
              <span class="flex items-center gap-3 md:gap-3.5">
                <span class="faq-num text-[10.5px] md:text-[11px] tracking-[1px]" style={{ color: i === 0 ? accent : textDim, fontFamily: "'JetBrains Mono', monospace" }}>
                  0{i+1}
                </span>
                {item.q}
              </span>
              <span class="faq-icon text-[20px] md:text-[22px] font-light transition-transform duration-200 flex-shrink-0" aria-hidden="true"
                style={{ color: i === 0 ? accent : textDim, transform: i === 0 ? 'rotate(45deg)' : 'rotate(0)' }}>
                +
              </span>
            </button>
            <div class="faq-content-wrapper grid transition-all duration-300 ease-in-out"
              id={`faq-panel-${i}`}
              role="region"
              aria-labelledby={`faq-trigger-${i}`}
              style={{
              gridTemplateRows: i === 0 ? '1fr' : '0fr',
              opacity: i === 0 ? 1 : 0
            }}>
              <div class="faq-content overflow-hidden" style={{
                fontFamily: "'Inter', system-ui, sans-serif",
                color: textSoft
              }}>
                {item.a}
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  /* === FAQ: compactación mobile sin tocar desktop === */

  /* Section padding */
  .faq-section { padding: 56px 0 64px 0; }
  @media (min-width: 768px) {
    .faq-section { padding: clamp(64px, 8vw, 120px) 0; }
  }

  /* Heading area mobile: bajar margen del título y subhead */
  .faq-h2 {
    font-size: 32px;
    margin: 0 0 12px 0;
  }
  .faq-sub {
    font-size: 14.5px;
    margin: 0 0 18px 0;
  }
  .faq-cta {
    padding: 10px 18px;
  }
  @media (min-width: 768px) {
    .faq-h2 {
      font-size: clamp(36px, 4.5vw, 56px);
      margin: 0 0 18px 0;
    }
    .faq-sub {
      font-size: 17px;
      margin: 0 0 32px 0;
    }
    .faq-cta {
      padding: 12px 20px;
    }
  }

  /* Lista: gap menor + radius por item (mobile) */
  .faq-list { gap: 6px; }
  .faq-item { border-radius: 10px; }
  @media (min-width: 768px) {
    .faq-list { gap: 8px; }
    .faq-item { border-radius: 12px; }
  }

  /* Trigger: padding mucho más chico en mobile */
  .faq-trigger {
    padding: 13px 16px;
    font-size: 14.5px;
    line-height: 1.3;
  }
  @media (min-width: 768px) {
    .faq-trigger {
      padding: 20px 24px;
      font-size: 15.5px;
      line-height: normal;
    }
  }

  /* Content: padding más compacto */
  .faq-content {
    padding: 0 16px 14px 42px;
    font-size: 13px;
    line-height: 1.55;
  }
  @media (min-width: 768px) {
    .faq-content {
      padding: 0 24px 20px 56px;
      font-size: 14px;
      line-height: 1.65;
    }
  }
</style>

<script>
  document.querySelectorAll('.faq-trigger').forEach((btn) => {
    btn.addEventListener('click', () => {
      const item = btn.closest('.faq-item');
      const wrapper = item?.querySelector('.faq-content-wrapper') as HTMLElement;
      const icon = item?.querySelector('.faq-icon') as HTMLElement;
      const num = item?.querySelector('.faq-trigger span span') as HTMLElement;
      const isOpen = wrapper && wrapper.style.gridTemplateRows === '1fr';
      const accent = '#2BB673';
      const line = 'rgba(250,250,250,0.08)';
      const textDim = 'rgba(250,250,250,0.46)';

      // Close all
      document.querySelectorAll('.faq-item').forEach((other) => {
        const otherHtml = other as HTMLElement;
        const ow = other.querySelector('.faq-content-wrapper') as HTMLElement;
        const oi = other.querySelector('.faq-icon') as HTMLElement;
        const on = other.querySelector('.faq-trigger span span') as HTMLElement;
        if (ow) {
          ow.style.gridTemplateRows = '0fr';
          ow.style.opacity = '0';
        }
        if (oi) { oi.style.transform = 'rotate(0)'; oi.style.color = textDim; }
        if (on) on.style.color = textDim;
        otherHtml.style.background = '#0A0B0D';
        otherHtml.style.borderColor = line;
      });

      if (!isOpen && item) {
        const itemHtml = item as HTMLElement;
        if (wrapper) {
          wrapper.style.gridTemplateRows = '1fr';
          wrapper.style.opacity = '1';
        }
        if (icon) { icon.style.transform = 'rotate(45deg)'; icon.style.color = accent; }
        if (num) num.style.color = accent;
        itemHtml.style.background = '#121316';
        itemHtml.style.borderColor = 'rgba(43,182,115,0.35)';
      }
    });
  });
</script>
