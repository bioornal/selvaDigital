---
import { whatsappLink } from '../lib/constants';
import WaIcon from './ui/WaIcon';
import { CONDICIONES, PLANES_WEB, formatARS } from '../lib/pricing';

const landing = PLANES_WEB.find(p => p.id === 'landing')!;
const tienda = PLANES_WEB.find(p => p.id === 'ecommerce')!;
const qs = [
  { q: '¿Cuánto tarda un proyecto web?',
    a: 'Una landing page: 5 a 7 días hábiles. Un sitio completo: 2 a 3 semanas. Un e-commerce o sistema a medida: 4 a 8 semanas según alcance. Antes de arrancar te paso un cronograma por escrito con fechas tentativas semana a semana.' },
  { q: '¿Cómo funciona la entrada baja + abono?',
    a: `Pagás un alta (por ejemplo, ${formatARS(landing.abono.alta)} en una landing) y después un abono mensual que incluye el hosting, las copias de seguridad, el soporte y cambios chicos de contenido. La permanencia mínima es de ${landing.abono.permanenciaMeses} meses en webs y de ${tienda.abono.permanenciaMeses} en tiendas; después te das de baja cuando quieras. ${CONDICIONES.abono.ajuste}` },
  { q: '¿Qué pasa si me doy de baja del abono?',
    a: `${CONDICIONES.abono.baja} ${CONDICIONES.abono.pasarAUnico} ${CONDICIONES.abono.dominio}` },
  { q: '¿Y si después de la entrega necesito cambios o sumar funciones?',
    a: 'Con el abono, los cambios chicos de contenido ya están incluidos. Los errores que aparezcan después del lanzamiento los corrijo sin cargo. Funciones nuevas, páginas nuevas o rediseños se cotizan aparte, siempre con presupuesto cerrado antes de arrancar.' },
  { q: '¿Qué pasa si no me gusta el diseño?',
    a: 'Antes de programar una sola línea de código te muestro una propuesta visual completa. Sobre esa propuesta hacemos hasta dos rondas de cambios sin costo hasta que estés conforme. Recién ahí arranca la programación: nunca te entrego algo que no aprobaste primero.' },
  { q: '¿Hago el diseño yo o lo hacés vos?',
    a: 'Lo hago yo. Diseño y programo cada proyecto desde cero — no son plantillas.' },
  { q: '¿Trabajás solo en Argentina?',
    a: 'Sí, trabajo exclusivamente con clientes en Argentina. El foco está en PyMEs argentinas que quieren digitalizar su negocio con precios y condiciones claras desde el primer día.' },
  { q: '¿Qué significa que una web "vende 24/7 y responde"?',
    a: 'Tu web puede atender aunque vos no estés conectado. En una tienda online, el cliente elige y paga. Si sumás un chatbot con IA, el chat está integrado en tu propia web: responde dudas y toma pedidos o reservas. Te deja el contacto listo para que vos sigas la conversación y cierres por WhatsApp.' },
];
const WA_FAQ = whatsappLink('¡Hola Christian! Tengo una consulta antes de arrancar un proyecto.');
---
<section id="faq" class="section on-petrol" aria-labelledby="faq-title">
  <div class="wrap faq-grid">
    <div class="faq-heading">
      <h2 id="faq-title" class="h2">Antes de arrancar, me preguntan esto:</h2>
      <p class="lede">Si tu duda no está, escribime.</p>
      <a href={WA_FAQ} target="_blank" rel="noopener noreferrer" class="btn btn-ghost"><WaIcon size={18} /> Hacer una consulta</a>
    </div>
    <div class="faq-list">
      {qs.map((item, i) => (
        <div class="faq-item">
          <h3>
            <button type="button" class="faq-trigger" id={'faq-trigger-' + i}
              aria-expanded={i === 0 ? 'true' : 'false'} aria-controls={'faq-panel-' + i}>
              <span>{item.q}</span><span class="faq-icon" aria-hidden="true"></span>
            </button>
          </h3>
          <div id={'faq-panel-' + i} class:list={['faq-panel', { 'is-open': i === 0 }]}
            role="region" aria-labelledby={'faq-trigger-' + i} aria-hidden={i !== 0} inert={i !== 0}>
            <div class="faq-panel-inner"><p>{item.a}</p></div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
<style>
  #faq { position: relative; isolation: isolate; }
  @media (min-width: 1024px) { #faq .faq-heading { position: static; } }
  .faq-grid { display: grid; gap: 40px; align-items: start; }
  .faq-heading { min-width: 0; text-align: left; }
  .faq-heading h2 { margin: 0 0 24px; }
  .faq-heading .lede { color: var(--on-petrol-soft); margin: 0 0 28px; }
  .faq-list { min-width: 0; border-bottom: 1px solid var(--line-petrol-strong); }
  .faq-item { border-top: 1px solid var(--line-petrol-strong); }
  .faq-item h3 { margin: 0; }
  .faq-trigger { display: flex; justify-content: space-between; align-items: center; gap: 20px; width: 100%; padding: 24px 0; text-align: left; border: 0; border-radius: 0; background: transparent; color: var(--on-petrol); font-family: var(--font-display); font-size: var(--fs-lede); font-weight: 600; line-height: 1.3; cursor: pointer; }
  .faq-trigger:hover { color: var(--on-petrol-soft); }
  .faq-icon { position: relative; width: 20px; height: 20px; flex-shrink: 0; }
  .faq-icon::before, .faq-icon::after { content: ''; position: absolute; left: 1px; top: 9px; width: 18px; height: 1px; background: currentColor; }
  .faq-icon::after { transform: rotate(90deg); transition: transform .25s var(--ease-out); }
  .faq-trigger[aria-expanded='true'] .faq-icon::after { transform: rotate(0); }
  .faq-panel { display: grid; grid-template-rows: 0fr; visibility: hidden; transition: grid-template-rows .3s var(--ease-out), visibility .3s; }
  .faq-panel.is-open { grid-template-rows: 1fr; visibility: visible; }
  .faq-panel-inner { min-height: 0; overflow: hidden; }
  .faq-panel p { max-width: 62ch; margin: 0; padding: 0 0 24px; font-size: var(--fs-control); line-height: 1.65; color: var(--on-petrol-soft); }
  @media (min-width: 768px) {
    .faq-grid { grid-template-columns: minmax(0, 5fr) minmax(0, 7fr); gap: clamp(32px, 5vw, 80px); }
    .faq-heading { position: sticky; top: 100px; }
  }
  @media (prefers-reduced-motion: reduce) {
    .faq-panel, .faq-icon::after { transition: none; }
  }
</style>
<script>
  const faq = document.getElementById('faq');
  const triggers = faq?.querySelectorAll<HTMLButtonElement>('.faq-trigger');
  triggers?.forEach(trigger => {
    trigger.addEventListener('click', () => {
      const shouldOpen = trigger.getAttribute('aria-expanded') !== 'true';
      triggers.forEach(button => {
        const panelId = button.getAttribute('aria-controls');
        const panel = panelId ? document.getElementById(panelId) : null;
        if (!panel) return;
        const expanded = button === trigger && shouldOpen;
        button.setAttribute('aria-expanded', String(expanded));
        panel.setAttribute('aria-hidden', String(!expanded));
        panel.toggleAttribute('inert', !expanded);
        panel.classList.toggle('is-open', expanded);
      });
    });
  });
</script>
