---
const accent = '#2BB673';
const bg = '#0A0B0D';
const surface = '#121316';
const white = '#FAFAFA';
const textSoft = 'rgba(250,250,250,0.72)';
const textDim = 'rgba(250,250,250,0.46)';
const line = 'rgba(250,250,250,0.08)';

const qs = [
  { q: 'Cuánto tarda un proyecto web?',
    a: 'Una landing page: 5 a 7 días hábiles. Un sitio completo: 2 a 3 semanas. Un e-commerce o sistema a medida: 4 a 8 semanas según alcance. Antes de arrancar te paso un cronograma por escrito con fechas tentativas semana a semana.' },
  { q: 'El precio es único o hay mensualidades?',
    a: 'Pago único. El primer año va incluido el dominio .com y el hosting en la nube. Pasado ese año, vos pagás directamente al proveedor de hosting (~USD 10–15 al mes según el plan). No hay tarifas mensuales mías escondidas.' },
  { q: 'El código queda mío?',
    a: 'Sí. Cuando se entrega el proyecto, te paso el repositorio, las claves de los servicios contratados (dominio, hosting, MercadoPago) y la documentación. Si mañana quisieras que otra persona lo mantenga, puede.' },
  { q: 'Hago el diseño yo o lo hacés vos?',
    a: 'Lo hago yo. Diseño y programo cada proyecto desde cero — no son plantillas. Antes de programar te muestro una propuesta visual; sobre eso iteramos hasta que esté.' },
  { q: 'Trabajás solo o tenés equipo?',
    a: 'Trabajo solo. Vos hablás directo conmigo de principio a fin: presupuesto, diseño, programación, deploy, soporte. Eso es más rápido y más barato que una agencia — pero significa que no tomo más de 3 proyectos en simultáneo.' },
  { q: 'Trabajás solo en Argentina?',
    a: 'Sí, trabajo exclusivamente con clientes en Argentina. El foco está en PyMEs argentinas que quieren digitalizar su negocio sin tarifas mensuales escondidas.' },
];
---

<section id="faq" class="relative" style={`background:${bg}; padding:clamp(64px, 8vw, 120px) 0;`}>
  <div class="max-w-[1080px] mx-auto px-6 md:px-10">
    <div class="grid md:grid-cols-[1fr_1.4fr] gap-16 md:gap-20 items-start">
      {/* Left sticky heading */}
      <div class="md:sticky md:top-[120px] text-center md:text-left">
        <div class="inline-flex items-center gap-2.5 mb-[18px]">
          <span class="w-3.5 h-px" style={{ background: accent }}></span>
          <span class="text-[11px] tracking-[2.5px] uppercase" style={{ color: accent, fontFamily: "'JetBrains Mono', monospace" }}>
            07 ─── FAQ
          </span>
        </div>
        <h2 class="font-geist font-semibold text-white leading-[1.02] tracking-tight mb-[18px]"
          style="font-size:clamp(36px, 4.5vw, 56px); letter-spacing:-0.025em;">
          Preguntas<br><span style={{ color: accent }}>frecuentes.</span>
        </h2>
        <p class="text-base md:text-[17px] leading-relaxed mb-8" style={{ color: textSoft, fontFamily: "'Inter', system-ui, sans-serif" }}>
          Lo que más me preguntan antes de arrancar un proyecto. Si tu duda no está, escribime y la respondo el mismo día.
        </p>
        <a href="#contacto" class="inline-flex items-center gap-2 px-5 py-3 text-sm font-semibold transition-all hover:brightness-110"
          style={{ background: accent, color: '#06140C', fontFamily: "'Inter', system-ui, sans-serif", borderRadius: '10px' }}>
          Hacer una consulta →
        </a>
      </div>

      {/* Accordion */}
      <div class="flex flex-col gap-2">
        {qs.map((item, i) => (
          <div class="faq-item overflow-hidden transition-all" style={{
            background: i === 0 ? surface : bg,
            border: `1px solid ${i === 0 ? 'rgba(43,182,115,0.35)' : line}`,
            borderRadius: '12px'
          }}>
            <button class="faq-trigger w-full flex items-center justify-between px-5 md:px-6 py-5 text-left bg-transparent border-none gap-3"
              style={{ fontFamily: "'Geist', 'Inter', system-ui, sans-serif", fontSize: '15.5px', fontWeight: 500, color: white, letterSpacing: '-0.01em' }}
              aria-expanded={i === 0 ? 'true' : 'false'}>
              <span class="flex items-center gap-3.5">
                <span class="text-[11px] tracking-[1px]" style={{ color: i === 0 ? accent : textDim, fontFamily: "'JetBrains Mono', monospace" }}>
                  0{i+1}
                </span>
                {item.q}
              </span>
              <span class="faq-icon text-[22px] font-light transition-transform duration-200 flex-shrink-0"
                style={{ color: i === 0 ? accent : textDim, transform: i === 0 ? 'rotate(45deg)' : 'rotate(0)' }}>
                +
              </span>
            </button>
            <div class="faq-content px-5 md:px-6 pb-5" style={{
              display: i === 0 ? 'block' : 'none',
              paddingLeft: '56px',
              fontFamily: "'Inter', system-ui, sans-serif",
              fontSize: '14px',
              lineHeight: '1.65',
              color: textSoft
            }}>
              {item.a}
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

<script>
  document.querySelectorAll('.faq-trigger').forEach((btn) => {
    btn.addEventListener('click', () => {
      const item = btn.closest('.faq-item');
      const content = item?.querySelector('.faq-content');
      const icon = item?.querySelector('.faq-icon');
      const num = item?.querySelector('.faq-trigger span span');
      const isOpen = content?.style.display === 'block';
      const accent = '#2BB673';
      const line = 'rgba(250,250,250,0.08)';
      const textDim = 'rgba(250,250,250,0.46)';

      // Close all
      document.querySelectorAll('.faq-item').forEach((other) => {
        const oc = other.querySelector('.faq-content');
        const oi = other.querySelector('.faq-icon');
        const on = other.querySelector('.faq-trigger span span');
        if (oc) oc.style.display = 'none';
        if (oi) { oi.style.transform = 'rotate(0)'; oi.style.color = textDim; }
        if (on) on.style.color = textDim;
        other.style.background = '#0A0B0D';
        other.style.borderColor = line;
      });

      if (!isOpen) {
        if (content) content.style.display = 'block';
        if (icon) { icon.style.transform = 'rotate(45deg)'; icon.style.color = accent; }
        if (num) num.style.color = accent;
        item.style.background = '#121316';
        item.style.borderColor = 'rgba(43,182,115,0.35)';
      }
    });
  });
</script>
