---
import { CONTACT_PHONE, CONTACT_EMAIL } from '../lib/constants';

const currentYear = new Date().getFullYear();

const menuItems = [
  { href: "#sobre-nosotros", label: "Sobre Mí" },
  { href: "#planes", label: "Planes y Precios" },
  { href: "#portfolio", label: "Portfolio" },
  { href: "#faq", label: "FAQ" },
  { href: "#contacto", label: "Contacto" },
];
---

<footer class="relative bg-black text-white py-12 border-t border-white/5">
  <div class="container mx-auto px-4">
    <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
      <div class="text-center md:text-left space-y-4">
        <div class="flex flex-col items-center md:items-start">
          <img
            src="https://res.cloudinary.com/djtvjkcu6/image/upload/v1778510560/SelvaDigital/logoChico2_kg35ot.png"
            alt="Selva Digital Logo"
            class="w-auto h-12 object-contain mb-2 bg-white/10 p-1"
          />
          <p class="text-gray-400 text-sm">Tecnología que hace crecer tu negocio</p>
        </div>
        <div class="flex flex-col md:flex-row items-center gap-2 md:gap-4 text-xs font-mono text-gray-500">
          <a href={`mailto:${CONTACT_EMAIL}`} class="hover:text-violet-400 transition-colors duration-200">
            {CONTACT_EMAIL}
          </a>
          <span class="hidden md:inline text-white/10">|</span>
          <span>{CONTACT_PHONE}</span>
        </div>
      </div>

      <div class="text-center md:text-right">
        <h4 class="text-xs font-mono text-violet-400 uppercase tracking-[0.2em] mb-4">Enlaces rápidos</h4>
        <ul class="space-y-2">
          {menuItems.map((item) => (
            <li>
              <a 
                href={item.href}
                class="text-gray-400 hover:text-white text-sm transition-colors duration-200"
              >
                {item.label}
              </a>
            </li>
          ))}
        </ul>
      </div>
    </div>

    <div class="mt-10 pt-6 border-t border-white/5 text-center">
      <p class="text-xs text-gray-600 font-mono">
        &copy; {currentYear} <span class="text-gray-400">Selva Digital</span> — Todos los derechos reservados.
      </p>
    </div>
  </div>
</footer>
