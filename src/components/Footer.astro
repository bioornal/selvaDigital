---
import { CONTACT_PHONE, CONTACT_EMAIL, WHATSAPP_URL } from '../lib/constants';

const accent = '#2BB673';
const surface = '#121316';
const white = '#FAFAFA';
const textSoft = 'rgba(250,250,250,0.72)';
const textDim = 'rgba(250,250,250,0.46)';
const line = 'rgba(250,250,250,0.08)';

const cols = [
  { title: 'Servicios', items: ['Sitios web','E-commerce','Sistemas a medida','Chatbots IA','SEO local'] },
  { title: 'Empresa',   items: ['Sobre mí','Portfolio','Testimonios','Planes y precios','Preguntas frecuentes'] },
  { title: 'Contacto',  items: [CONTACT_PHONE, CONTACT_EMAIL, 'Córdoba, Argentina', 'Lun–Vie · 9–19', 'WhatsApp directo'] },
];

const socials = [
  { label: 'WA', href: WHATSAPP_URL, title: 'WhatsApp' },
  { label: 'IG', href: 'https://www.instagram.com/selvadigital_creaciones/', title: 'Instagram' },
  { label: 'Gh', href: null, title: null },
  { label: 'In', href: null, title: null },
];
---

<footer style={{ background: surface, borderTop: `1px solid ${line}`, paddingTop: '60px' }}>
  <div class="max-w-[1320px] mx-auto px-6 md:px-10">

    {/* Mobile: logo + redes en una fila, luego copyright */}
    <div class="md:hidden pb-8" style={{ borderBottom: `1px solid ${line}` }}>
      <div class="flex items-center justify-between mb-6">
        <img src="https://res.cloudinary.com/djtvjkcu6/image/upload/v1778510560/SelvaDigital/logoChico2_kg35ot.png" alt="Selva Digital" class="h-[34px] w-auto" />
        <div class="flex gap-2">
          {socials.map(s => (
            s.href ? (
              <a href={s.href} target="_blank" rel="noopener noreferrer" aria-label={s.title}
                class="w-8 h-8 flex items-center justify-center transition-colors hover:text-white"
                style={{
                  background: '#1A1C20',
                  border: `1px solid ${line}`,
                  color: textSoft,
                  borderRadius: '8px'
                }}>
                {s.label === 'WA' && (
                  <svg width="15" height="15" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                    <path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946C.06 5.348 5.397.01 12.008.01c3.202.001 6.212 1.246 8.477 3.514 2.266 2.268 3.507 5.28 3.505 8.484-.004 6.657-5.34 11.997-11.953 11.997-2.005-.001-3.973-.502-5.724-1.46L0 24zm6.59-4.846c1.6.95 3.188 1.449 4.825 1.451 5.436 0 9.86-4.37 9.864-9.799.002-2.63-1.023-5.101-2.885-6.963C16.59 1.981 14.119.957 11.5.957c-5.45 0-9.88 4.373-9.884 9.802-.001 1.778.475 3.51 1.378 5.077L1.884 22.1l6.41-1.68c.006-.003.013-.005.019-.008L6.647 19.15z"/>
                    <path d="M17.472 14.382c-.3-.149-1.778-.878-2.057-.98-.278-.102-.48-.153-.68.154-.201.307-.779 1.02-1.077 1.326-.065.068-.13.076-.233.023-.103-.053-.436-.16-.83-.512-3.07-2.74-3.418-4.043-3.52-4.218-.102-.175-.011-.27.076-.357.078-.078.175-.205.263-.307.088-.102.117-.175.175-.29.059-.117.029-.22-.015-.323-.044-.102-.48-1.157-.657-1.582-.173-.418-.363-.36-.48-.36h-.414c-.143 0-.376.054-.573.27-.197.216-.755.738-.755 1.8 0 1.061.773 2.086.88 2.233.107.147 1.522 2.325 3.687 3.257.515.222.918.355 1.233.456.518.165.99.141 1.362.086.414-.061 1.778-.727 2.027-1.429.25-.701.25-1.302.175-1.429-.075-.127-.278-.205-.578-.354z"/>
                  </svg>
                )}
                {s.label === 'IG' && (
                  <svg width="15" height="15" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                    <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zM12 0C8.741 0 8.333.014 7.053.072 2.695.272.273 2.69.073 7.051c-.058 1.28-.072 1.689-.072 4.949 0 3.26.014 3.26.072 4.54.196 4.363 2.618 6.786 6.98 6.986 1.281.057 1.689.072 4.948.072 3.26 0 3.668-.015 4.948-.072 4.354-.196 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.54 0-3.26-.014-3.668-.073-4.948-.197-4.364-2.618-6.786-6.979-6.986C15.668.014 15.26 0 12 0zm0 5.838a6.162 6.162 0 1 0 0 12.324 6.162 6.162 0 0 0 0-12.324zM12 16a4 4 0 1 1 0-8 4 4 0 0 1 0 8zm6.406-11.845a1.44 1.44 0 1 0 0 2.881 1.44 1.44 0 0 0 0-2.881z"/>
                  </svg>
                )}
              </a>
            ) : (
              <span aria-hidden="true"
                class="w-8 h-8 flex items-center justify-center cursor-default"
                style={{
                  background: '#1A1C20',
                  border: `1px solid ${line}`,
                  color: 'rgba(250,250,250,0.18)',
                  borderRadius: '8px',
                  opacity: 0.45
                }}>
                {s.label === 'Gh' && (
                  <svg width="15" height="15" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                    <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/>
                  </svg>
                )}
                {s.label === 'In' && (
                  <svg width="15" height="15" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                    <path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"/>
                  </svg>
                )}
              </span>
            )
          ))}
        </div>
      </div>
      <div class="text-[11px] tracking-[1px] text-center" style={{ color: textDim, fontFamily: "'JetBrains Mono', monospace" }}>
        © 2026 SELVA DIGITAL · CÓRDOBA, ARGENTINA
      </div>
    </div>

    {/* Desktop: layout completo */}
    <div class="hidden md:grid md:grid-cols-[1.6fr_1fr_1fr_1fr] gap-12 pb-12" style={{ borderBottom: `1px solid ${line}` }}>
      <div>
        <img src="https://res.cloudinary.com/djtvjkcu6/image/upload/v1778510560/SelvaDigital/logoChico2_kg35ot.png" alt="Selva Digital" class="h-[38px] w-auto mb-5" />
        <p class="text-[13.5px] leading-relaxed mb-5 max-w-[340px]" style={{ color: textSoft, fontFamily: "'Inter', system-ui, sans-serif" }}>
          Desarrollo web freelance para PyMEs argentinas. Sitios, e-commerce, sistemas a medida y chatbots con IA. Pago único, sin sorpresas.
        </p>
        <div class="flex gap-2.5">
          {socials.map(s => (
            s.href ? (
              <a href={s.href} target="_blank" rel="noopener noreferrer" aria-label={s.title}
                class="w-9 h-9 flex items-center justify-center transition-colors hover:text-white"
                style={{
                  background: '#1A1C20',
                  border: `1px solid ${line}`,
                  color: textSoft,
                  borderRadius: '9px'
                }}>
                {s.label === 'WA' && (
                  <svg width="17" height="17" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                    <path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946C.06 5.348 5.397.01 12.008.01c3.202.001 6.212 1.246 8.477 3.514 2.266 2.268 3.507 5.28 3.505 8.484-.004 6.657-5.34 11.997-11.953 11.997-2.005-.001-3.973-.502-5.724-1.46L0 24zm6.59-4.846c1.6.95 3.188 1.449 4.825 1.451 5.436 0 9.86-4.37 9.864-9.799.002-2.63-1.023-5.101-2.885-6.963C16.59 1.981 14.119.957 11.5.957c-5.45 0-9.88 4.373-9.884 9.802-.001 1.778.475 3.51 1.378 5.077L1.884 22.1l6.41-1.68c.006-.003.013-.005.019-.008L6.647 19.15z"/>
                    <path d="M17.472 14.382c-.3-.149-1.778-.878-2.057-.98-.278-.102-.48-.153-.68.154-.201.307-.779 1.02-1.077 1.326-.065.068-.13.076-.233.023-.103-.053-.436-.16-.83-.512-3.07-2.74-3.418-4.043-3.52-4.218-.102-.175-.011-.27.076-.357.078-.078.175-.205.263-.307.088-.102.117-.175.175-.29.059-.117.029-.22-.015-.323-.044-.102-.48-1.157-.657-1.582-.173-.418-.363-.36-.48-.36h-.414c-.143 0-.376.054-.573.27-.197.216-.755.738-.755 1.8 0 1.061.773 2.086.88 2.233.107.147 1.522 2.325 3.687 3.257.515.222.918.355 1.233.456.518.165.99.141 1.362.086.414-.061 1.778-.727 2.027-1.429.25-.701.25-1.302.175-1.429-.075-.127-.278-.205-.578-.354z"/>
                  </svg>
                )}
                {s.label === 'IG' && (
                  <svg width="17" height="17" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                    <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zM12 0C8.741 0 8.333.014 7.053.072 2.695.272.273 2.69.073 7.051c-.058 1.28-.072 1.689-.072 4.949 0 3.26.014 3.26.072 4.54.196 4.363 2.618 6.786 6.98 6.986 1.281.057 1.689.072 4.948.072 3.26 0 3.668-.015 4.948-.072 4.354-.196 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.54 0-3.26-.014-3.668-.073-4.948-.197-4.364-2.618-6.786-6.979-6.986C15.668.014 15.26 0 12 0zm0 5.838a6.162 6.162 0 1 0 0 12.324 6.162 6.162 0 0 0 0-12.324zM12 16a4 4 0 1 1 0-8 4 4 0 0 1 0 8zm6.406-11.845a1.44 1.44 0 1 0 0 2.881 1.44 1.44 0 0 0 0-2.881z"/>
                  </svg>
                )}
              </a>
            ) : (
              <span aria-hidden="true"
                class="w-9 h-9 flex items-center justify-center cursor-default"
                style={{
                  background: '#1A1C20',
                  border: `1px solid ${line}`,
                  color: 'rgba(250,250,250,0.18)',
                  borderRadius: '9px',
                  opacity: 0.45
                }}>
                {s.label === 'Gh' && (
                  <svg width="17" height="17" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                    <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/>
                  </svg>
                )}
                {s.label === 'In' && (
                  <svg width="17" height="17" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                    <path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"/>
                  </svg>
                )}
              </span>
            )
          ))}
        </div>
      </div>
      {cols.map(c => (
        <div>
          <div class="text-[10.5px] tracking-[2px] mb-4" style={{ color: textDim, fontFamily: "'JetBrains Mono', monospace" }}>
            {c.title.toUpperCase()}
          </div>
          <ul class="flex flex-col gap-2.5 list-none p-0">
            {c.items.map(it => (
              <li class="text-[13px]" style={{ color: textSoft, fontFamily: "'Inter', system-ui, sans-serif" }}>{it}</li>
            ))}
          </ul>
        </div>
      ))}
    </div>

    {/* Bottom bar — desktop only */}
    <div class="hidden md:flex flex-wrap justify-between items-center py-7 gap-3.5">
      <div class="text-[11px] tracking-[1px]" style={{ color: textDim, fontFamily: "'JetBrains Mono', monospace" }}>
        © 2026 SELVA DIGITAL · CHRISTIAN A. SPEZIALI · CÓRDOBA, ARGENTINA
      </div>
      <div class="flex gap-5 text-[12.5px]" style={{ color: textDim, fontFamily: "'Inter', system-ui, sans-serif" }}>
        <a href="#" class="hover:text-white transition-colors">Términos</a>
        <a href="#" class="hover:text-white transition-colors">Privacidad</a>
        <a href="#" class="hover:text-white transition-colors">Ley 25.326</a>
        <a href="/admin" class="hover:text-white transition-colors opacity-40 hover:opacity-100">Panel</a>
      </div>
    </div>

  </div>

  {/* Tape strip — desktop only (en mobile genera scroll horizontal innecesario) */}
  <div class="hidden md:block py-3.5 text-center overflow-hidden text-[11.5px] font-semibold tracking-[2px]"
    style={{ background: accent, color: '#06140C', fontFamily: "'JetBrains Mono', monospace" }}>
    DISPONIBLE PARA NUEVOS PROYECTOS · MAYO 2026 &nbsp;·&nbsp; AGENDÁ UNA LLAMADA GRATUITA &nbsp;→ &nbsp; {CONTACT_PHONE}
  </div>
</footer>
