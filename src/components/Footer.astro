---
import { WHATSAPP_URL, whatsappLink } from '../lib/constants';
import WaIcon from './ui/WaIcon';
const cols = [
  { title: 'Servicios', items: [
    { label: 'Sitios web', href: '#servicios' }, { label: 'E-commerce', href: '#servicios' },
    { label: 'Sistemas a medida', href: '#servicios' }, { label: 'Chatbots IA', href: '#servicios' }, { label: 'SEO local', href: '#servicios' },
  ] },
  { title: 'Sitio', items: [
    { label: 'Cómo trabajo', href: '#sobre' }, { label: 'Trabajos', href: '#portfolio' },
    { label: 'Testimonios', href: '#testimonios' }, { label: 'Planes y precios', href: '#planes' }, { label: 'Preguntas frecuentes', href: '#faq' },
  ] },
];
---
<footer class="on-petrol site-footer">
  <div class="wrap">
    <a href="#hero" class="footer-brand" aria-label="Selva Digital — inicio">selva digital<span class="status-dot" aria-hidden="true"></span></a>
    <div class="footer-invitation">
      <a class="btn btn-primary" href={whatsappLink('¡Hola Christian! Quiero que mi negocio atienda solo. ¿Me pasás más info?')} target="_blank" rel="noopener noreferrer"><WaIcon size={19} />Escribime por WhatsApp</a>
    </div>
    <div class="footer-columns">
      <div class="footer-intro">
        <p>Desarrollo web freelance para PyMEs argentinas. Sitios, e-commerce, sistemas a medida y chatbots con IA. Pago único, sin sorpresas.</p>
        <div class="footer-socials mono">
          <a class="link" href={WHATSAPP_URL} target="_blank" rel="noopener noreferrer">WhatsApp ↗</a>
          <a class="link" href="https://www.instagram.com/selvadigital_creaciones/" target="_blank" rel="noopener noreferrer">Instagram ↗</a>
        </div>
      </div>
      {cols.map(col => <nav aria-label={col.title}><h2 class="mono">{col.title}</h2><ul>{col.items.map(item => <li><a href={item.href}>{item.label}</a></li>)}</ul></nav>)}
      <div>
        <h2 class="mono"><a href="#contacto">Contacto</a></h2>
      </div>
    </div>
    <div class="footer-bottom mono"><p>© 2026 Selva Digital · Córdoba, Argentina</p><a class="link" href="/portal">Portal clientes</a></div>
  </div>
</footer>
<style>
  .site-footer { border-top: 1px solid var(--line-petrol); padding-top: clamp(48px, 7vw, 96px); }
  .footer-brand { display: inline-flex; align-items: center; gap: 6px; font-family: var(--font-display); font-size: var(--fs-brand); font-weight: 800; font-variation-settings: 'wdth' 112; letter-spacing: -.03em; line-height: 1; text-decoration: none; }
  .footer-invitation { display: flex; flex-direction: column; align-items: flex-start; gap: 28px; margin: 40px 0 56px; }
  .footer-columns { display: grid; grid-template-columns: repeat(2,minmax(0,1fr)); gap: 36px 24px; padding-block: 36px 48px; border-top: 1px solid var(--line-petrol); }
  .footer-intro { grid-column: 1 / -1; }
  .footer-intro p { max-width: 38ch; margin: 0 0 24px; color: var(--on-petrol-soft); }
  .footer-socials { display: flex; flex-wrap: wrap; gap: 20px; }
  .footer-columns h2 { margin: 0 0 18px; color: var(--on-petrol-dim); }
  .footer-columns ul { list-style: none; padding: 0; margin: 0; display: grid; gap: 12px; font-size: var(--fs-small); color: var(--on-petrol-soft); }
  .footer-columns > div:last-child { grid-column: 1 / -1; }
  .footer-columns a { overflow-wrap: anywhere; }
  .footer-columns a:hover { color: var(--ice); text-decoration: underline; text-underline-offset: 4px; }
  .footer-bottom { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 20px; padding-block: 28px 88px; border-top: 1px solid var(--line-petrol); color: var(--on-petrol-dim); }
  .footer-bottom p { margin: 0; }
  @media (min-width: 1024px) {
    .footer-invitation { flex-direction: row; align-items: center; justify-content: space-between; }
    .footer-columns { grid-template-columns: 1.3fr .8fr 1fr 1.2fr; gap: 40px; }
    .footer-intro, .footer-columns > div:last-child { grid-column: auto; }
    .footer-bottom { padding-bottom: 32px; }
  }
</style>
