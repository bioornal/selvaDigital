---
import HeroDynamic from './HeroDynamic';
import { Button } from './ui/button';

const techLogos = [
  { src: "https://cdn.jsdelivr.net/gh/devicons/devicon/icons/typescript/typescript-original.svg", alt: "TypeScript", delay: 0.3 },
  { src: "https://cdn.jsdelivr.net/gh/devicons/devicon/icons/nodejs/nodejs-original.svg", alt: "Node.js", delay: 0.9 },
  { src: "https://cdn.simpleicons.org/airtable/FFFFFF", alt: "Airtable", delay: 1.2 },
  { src: "https://cdn.jsdelivr.net/gh/devicons/devicon/icons/astro/astro-original.svg", alt: "Astro", delay: 1.5 },
  { src: "https://cdn.jsdelivr.net/gh/devicons/devicon/icons/css3/css3-original.svg", alt: "CSS3", delay: 1.8 },
  { src: "https://cdn.simpleicons.org/cursor/FFFFFF", alt: "Cursor", delay: 2.1 },
  { src: "https://cdn.jsdelivr.net/gh/devicons/devicon/icons/docker/docker-original.svg", alt: "Docker", delay: 2.7 },
  { src: "https://cdn.simpleicons.org/googledrive/FFFFFF", alt: "Google Drive", delay: 3.0 },
  { src: "https://cdn.jsdelivr.net/gh/devicons/devicon/icons/mongodb/mongodb-original.svg", alt: "MongoDB", delay: 3.3 },
  { src: "https://cdn.simpleicons.org/nextdotjs/FFFFFF", alt: "Next.js", delay: 3.6 },
  { src: "https://cdn.simpleicons.org/netlify/FFFFFF", alt: "Netlify", delay: 3.9 },
  { src: "https://cdn.jsdelivr.net/gh/devicons/devicon/icons/python/python-original.svg", alt: "Python", delay: 4.2 },
  { src: "https://cdn.simpleicons.org/supabase/3FCF8E", alt: "Supabase", delay: 4.5 },
  { src: "https://cdn.simpleicons.org/figma/FFFFFF", alt: "Figma", delay: 4.8 },
  { src: "https://cdn.jsdelivr.net/gh/devicons/devicon/icons/react/react-original.svg", alt: "React", delay: 5.1 },
  { src: "https://cdn.simpleicons.org/mercadopago/00B1EA", alt: "MercadoPago", delay: 5.4 },
  { src: "https://cdn.jsdelivr.net/gh/devicons/devicon/icons/javascript/javascript-original.svg", alt: "JavaScript", delay: 5.7 },
  { src: "https://cdn.simpleicons.org/anthropic/FFFFFF", alt: "Claude", delay: 6.0 },
  { src: "https://cdn.simpleicons.org/notion/FFFFFF", alt: "Notion", delay: 6.3 },
  { src: "https://cdn.jsdelivr.net/gh/devicons/devicon/icons/html5/html5-original.svg", alt: "HTML5", delay: 6.6 },
  { src: "https://cdn.simpleicons.org/cloudinary/3448C5", alt: "Cloudinary", delay: 6.9 },
  { src: "https://cdn.simpleicons.org/github/FFFFFF", alt: "GitHub", delay: 7.2 },
  { src: "https://cdn.jsdelivr.net/gh/devicons/devicon/icons/firebase/firebase-original.svg", alt: "Firebase", delay: 7.5 },
  { src: "https://cdn.simpleicons.org/mui/007FFF", alt: "Material UI", delay: 7.8 },
  { src: "https://cdn.jsdelivr.net/gh/devicons/devicon/icons/express/express-original.svg", alt: "Express", delay: 8.1 },
  { src: "https://cdn.simpleicons.org/googlegemini/FFFFFF", alt: "Gemini", delay: 8.4 },
  { src: "https://cdn.jsdelivr.net/gh/devicons/devicon/icons/tailwindcss/tailwindcss-original.svg", alt: "Tailwind", delay: 8.7 },
  { src: "https://cdn.jsdelivr.net/gh/devicons/devicon/icons/postgresql/postgresql-original.svg", alt: "PostgreSQL", delay: 9.0 },
  { src: "https://cdn.simpleicons.org/git/FFFFFF", alt: "Git", delay: 9.3 },
  { src: "https://cdn.jsdelivr.net/gh/devicons/devicon/icons/vitejs/vitejs-original.svg", alt: "Vite", delay: 9.6 },
  { src: "https://cdn.simpleicons.org/n8n/FFFFFF", alt: "n8n", delay: 9.9 },
];
---

<section class="relative text-white min-h-screen flex items-center pt-24 pb-16 overflow-hidden bg-black">
  <div class="absolute inset-0 bg-black">
    <video
      id="heroVideo"
      autoplay
      loop
      muted
      playsinline
      poster="/fogon.webp"
      class="w-full h-full object-cover opacity-60 scale-[1.15]"
    >
      <source src="https://res.cloudinary.com/djtvjkcu6/video/upload/v1778524166/SelvaDigital/A_seamless_infinite_loop_cinematic_202605111510_zjt26u.mp4" type="video/mp4" />
    </video>
  </div>
  <div class="absolute inset-0 bg-gradient-to-b from-black/80 via-black/40 to-black/90"></div>

  <div class="container mx-auto px-4 relative z-20">
    <div class="max-w-2xl">
      <h1 class="text-3xl sm:text-4xl md:text-5xl lg:text-6xl font-heading text-white mb-4 leading-tight">
        Tecnología que hace <span class="text-azure-radiance-400">crecer</span> tu negocio
      </h1>

      <div class="h-16 sm:h-20 mb-6">
        <HeroDynamic client:load />
      </div>

      <div class="hidden md:flex flex-wrap gap-3 mb-8">
        {techLogos.map((tech) => (
          <div class="w-9 h-9 p-2 hud-container flex items-center justify-center">
            <img src={tech.src} alt={tech.alt} class="w-full h-full object-contain opacity-70 hover:opacity-100 transition-opacity" />
          </div>
        ))}
      </div>

      <div class="flex flex-col sm:flex-row gap-3">
        <Button size="lg" asChild className="hud-container bg-azure-radiance-600 hover:bg-azure-radiance-700 text-white font-bold px-6 py-5 rounded-none">
          <a href="#contacto" class="flex items-center gap-2">
            <span class="relative z-10 uppercase tracking-widest text-xs">Solicitar presupuesto</span>
          </a>
        </Button>
        <Button size="lg" variant="outline" asChild className="hud-container bg-transparent border-white/20 hover:border-azure-radiance-400 text-white px-6 py-5 rounded-none">
          <a href="#portfolio" class="uppercase tracking-widest text-xs">Ver Proyectos</a>
        </Button>
      </div>
    </div>
  </div>
</section>

<script>
  const video = document.getElementById('heroVideo') as HTMLVideoElement;
  if (video) {
    video.playbackRate = 0.5;
  }
</script>
