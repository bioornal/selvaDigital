---
import WaIcon from './ui/WaIcon';
import { whatsappLink } from '../lib/constants';
import { IMG, bg, bgSrcset } from '../lib/cloudinary';

const WA_HERO = whatsappLink('¡Hola Christian! Quiero que mi negocio venda online. ¿Me pasás un presupuesto?');

// Verbos que rotan en el titular: lo que la web hace sola.
const verbs = ['vende', 'atiende', 'responde', 'cobra'];
---

<section id="hero" class="hero on-petrol" aria-labelledby="hero-title">
  <picture class="hero-visual" aria-hidden="true">
    <img
      src={bg(IMG.heroDevice, 1600)}
      srcset={bgSrcset(IMG.heroDevice)}
      sizes="100vw"
      alt="" width="2400" height="1350" fetchpriority="high" decoding="async"
    />
  </picture>

  <div class="wrap hero-inner">
    <h1 id="hero-title" class="hero-h1">
      <span class="sr-only">Tu negocio vende, atiende, responde y cobra solo.</span>
      <span class="hero-line mask-line" aria-hidden="true">Tu negocio</span>
      <span class="hero-line mask-line hero-rotor" aria-hidden="true" data-rotor>
        {verbs.map((v, i) => (
          <span class:list={['hero-verb', { 'is-on': i === 0 }]}>{v}</span>
        ))}
      </span>
      <span class="hero-line mask-line" aria-hidden="true">solo<span class="hero-stop">.</span></span>
    </h1>

    <div class="hero-foot fade-late">
      <p class="hero-sub">
        <strong>Dejá de perder ventas por no contestar a tiempo.</strong>
        Tu web responde, toma pedidos y cobra mientras vos trabajás.
      </p>
      <div class="hero-cta">
        <a href={WA_HERO} target="_blank" rel="noopener noreferrer" class="btn btn-primary hero-btn">
          <WaIcon size={20} />
          Escribime por WhatsApp
        </a>
      </div>
    </div>
  </div>
</section>

<script>
  // Rota el verbo del titular. Con prefers-reduced-motion queda fijo en el primero.
  const rotor = document.querySelector<HTMLElement>('[data-rotor]');
  if (rotor && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    const verbs = Array.from(rotor.querySelectorAll<HTMLElement>('.hero-verb'));
    let i = 0;
    window.setInterval(() => {
      const prev = verbs[i];
      i = (i + 1) % verbs.length;
      prev.classList.remove('is-on');
      prev.classList.add('is-off');
      verbs[i].classList.remove('is-off');
      verbs[i].classList.add('is-on');
      window.setTimeout(() => prev.classList.remove('is-off'), 700);
    }, 2400);
  }
</script>

<style>
  .hero {
    position: relative;
    isolation: isolate;
    min-height: 100svh;
    display: flex;
    align-items: flex-end;
    overflow: hidden;
    padding: calc(var(--header-h) + clamp(32px, 6vh, 80px)) 0 clamp(40px, 7vh, 80px);
  }

  .hero-stop { color: var(--lime); }

  /* Imagen de producto: tercio derecho, el titular vive sobre el vacío izquierdo */
  .hero-visual {
    position: absolute;
    inset: 0;
    z-index: -1;
    display: block;
  }
  .hero-visual img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 72% 50%;
    display: block;
  }
  /* Velo inferior para que la bajada y el CTA lean sobre cualquier zona de la imagen */
  .hero-visual::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgba(16, 45, 53, 0) 45%, rgba(16, 45, 53, 0.85) 100%);
  }

  .hero-inner { position: relative; width: 100%; }

  .hero-h1 {
    margin: 0 0 clamp(32px, 5vh, 56px);
    font-family: var(--font-display);
    font-weight: 800;
    font-variation-settings: 'wdth' 125;
    font-size: var(--fs-hero);
    line-height: 0.86;
    letter-spacing: -0.035em;
    text-transform: uppercase;
    color: var(--ice);
  }
  .hero-line { display: block; }

  /* Rotor: todas las palabras apiladas en la misma celda; el ancho lo fija la más larga */
  .hero-rotor {
    display: grid;
    width: max-content;
    overflow: hidden;
    color: var(--lime);
  }
  .hero-verb {
    grid-area: 1 / 1;
    transform: translateY(105%);
    opacity: 0;
    transition: transform .7s var(--ease-out), opacity .7s var(--ease-out);
  }
  .hero-verb.is-on { transform: translateY(0); opacity: 1; }
  .hero-verb.is-off { transform: translateY(-105%); opacity: 0; }
  @media (prefers-reduced-motion: reduce) {
    .hero-verb { transition: none; }
  }

  .hero-foot {
    display: grid;
    gap: 28px;
    padding-top: 28px;
    border-top: 1px solid var(--line-petrol-strong);
  }
  .hero-sub {
    margin: 0;
    max-width: 46ch;
    font-size: var(--fs-lede);
    line-height: 1.5;
    color: var(--on-petrol-soft);
  }
  .hero-sub strong { display: block; color: var(--ice); font-weight: 700; }
  .hero-cta { display: flex; flex-direction: column; align-items: flex-start; gap: 14px; }
  .hero-btn { min-height: 60px; padding-inline: 30px; font-size: var(--fs-body); }

  @media (min-width: 1024px) {
    .hero-foot { grid-template-columns: minmax(0, 1fr) auto; align-items: end; }
    .hero-cta { align-items: flex-end; }
  }

  /* Mobile: la imagen pasa a ser un fondo tenue para que el titular gane todo el peso */
  @media (max-width: 767px) {
    .hero-visual { right: 3vw; }
    .hero-visual img { object-position: 80% 50%; opacity: .55; }
    .hero-visual::after { background: linear-gradient(180deg, rgba(16, 45, 53, .35) 0%, rgba(16, 45, 53, .9) 70%); }
    .hero-btn { width: 100%; }
    .hero-cta { width: 100%; }
  }

  .sr-only {
    position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px;
    overflow: hidden; clip: rect(0, 0, 0, 0); white-space: nowrap; border: 0;
  }
</style>
