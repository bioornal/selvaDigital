---
const accent = '#2BB673';
const bg = '#0A0B0D';
const surface = '#121316';
const white = '#FAFAFA';
const textSoft = 'rgba(250,250,250,0.72)';
const textDim = 'rgba(250,250,250,0.46)';
const line = 'rgba(250,250,250,0.08)';
const lineStr = 'rgba(250,250,250,0.18)';

const stats = [
  { n: '15+', k: 'proyectos en producción' },
  { n: '<24h', k: 'respondo tu pedido inicial' },
  { n: '$0', k: 'cuotas mensuales', desktopOnly: true },
  { n: '100%', k: 'código propio, sin templates', desktopOnly: true },
];

const clients = ['MegaMuebles','Social Core','El Fogón Delivery','Iguazú Falls Lodge','Impasto Pizzería','Megabot Admin','Recetario Napolitano'];
---

<section id="hero" class="hero-section relative min-h-screen overflow-hidden flex items-center" style={`background:${bg}; padding-top:74px;`}>
  {/* MOBILE-ONLY: Dot grid pattern — sutil, mismo lenguaje que otras secciones */}
  <div class="absolute inset-0 pointer-events-none opacity-[0.12] md:hidden"
    style="background-image:radial-gradient(circle at 1px 1px, rgba(255,255,255,0.08) 1px, transparent 0); background-size:32px 32px;"
    aria-hidden="true"></div>

  {/* DESKTOP-ONLY: Background video — solo carga y se reproduce en md+
       En mobile queda display:none → el navegador no descarga el archivo */}
  <video
    id="heroVideo"
    autoplay
    loop
    muted
    playsinline
    preload="metadata"
    class="hidden md:block absolute inset-0 w-full h-full object-cover"
    style="opacity:0.55; filter:saturate(0.85);"
  >
    <source src="https://res.cloudinary.com/djtvjkcu6/video/upload/v1778524166/SelvaDigital/A_seamless_infinite_loop_cinematic_202605111510_zjt26u.mp4" type="video/mp4" />
  </video>

  {/* DESKTOP-ONLY: Dark gradient overlay sobre el video (look original) */}
  <div class="hidden md:block absolute inset-0" style={`background: linear-gradient(180deg, rgba(10,11,13,0.6) 0%, rgba(10,11,13,0.4) 40%, rgba(10,11,13,0.92) 100%), radial-gradient(ellipse at 75% 50%, transparent, rgba(10,11,13,0.5) 70%);`} aria-hidden="true"></div>

  {/* MOBILE-ONLY: Vignette suave (en desktop lo hace el gradient overlay) */}
  <div class="absolute inset-0 pointer-events-none md:hidden"
    style="background:radial-gradient(ellipse at 50% 35%, transparent 0%, rgba(10,11,13,0.35) 60%, rgba(10,11,13,0.85) 100%);"
    aria-hidden="true"></div>

  {/* Accent glow top-right verde (en ambos viewports) */}
  <div class="absolute pointer-events-none" style="top:-200px; right:-400px; width:800px; height:800px; background:radial-gradient(closest-side, rgba(43,182,115,0.18), transparent 70%); filter:blur(10px);" aria-hidden="true"></div>

  {/* MOBILE-ONLY: glow secundario bottom-left para balance sin video */}
  <div class="absolute pointer-events-none md:hidden" style="bottom:-300px; left:-300px; width:700px; height:700px; background:radial-gradient(closest-side, rgba(43,182,115,0.08), transparent 70%); filter:blur(20px);" aria-hidden="true"></div>

  <div class="hero-inner relative z-10 max-w-[1320px] mx-auto px-6 md:px-10 w-full">
    <div class="max-w-[1180px]">
      {/* Eyebrow — Cupos */}
      <div class="inline-flex items-center gap-3 px-4 py-[7px] hero-eyebrow reveal reveal-slide-up delay-75" style={`border:1px solid ${line}; background:rgba(18,19,22,0.7); backdrop-filter:blur(8px); border-radius:999px;`}>
        <span class="relative flex h-[8px] w-[8px]">
          <span class="absolute inline-flex h-full w-full opacity-60 hero-eyebrow-ping" style={`background:${accent}; border-radius:50%;`}></span>
          <span class="relative inline-flex h-[8px] w-[8px]" style={`background:${accent}; border-radius:50%; box-shadow:0 0 12px ${accent};`}></span>
        </span>
        <span class="text-[11px] tracking-[2px] uppercase" style={{ color: textSoft, fontFamily: "'JetBrains Mono', monospace" }}>
          PRÓXIMA VENTANA: JUNIO 2026
        </span>
        <span class="hero-eyebrow-divider" style={`width:1px; height:14px; background:${line};`}></span>
        <span class="inline-flex items-center gap-1.5 text-[11px] tracking-[2px] uppercase" style={{ color: accent, fontFamily: "'JetBrains Mono', monospace", fontWeight: 600 }}>
          <span>2/3</span>
          <span style={{ color: textSoft, fontWeight: 400 }}>CUPOS TOMADOS</span>
        </span>
      </div>

      {/* Headline */}
      <h1 class="hero-h1 text-white reveal reveal-slide-up delay-100">
        Tu web vendiendo 24/7.<br><span style={{ color: accent }}>Sin cuotas, sin agencia.</span>
      </h1>

      {/* Subhead */}
      <p class="hero-subhead max-w-[640px] reveal reveal-slide-up delay-150" style={{ color: textSoft }}>
        Convertí tu WhatsApp saturado en un negocio que atiende, vende
        y cobra solo. Para PyMEs argentinas cansadas de pagar agencias
        sin ver resultados.
      </p>

      {/* CTAs */}
      <div class="hero-ctas flex flex-col gap-3.5 reveal reveal-slide-up delay-200">
        <div class="flex flex-wrap items-center gap-3 w-full">
          <a href="#contacto" class="inline-flex items-center gap-2 px-7 py-4 text-[15px] font-semibold rounded-none transition-all duration-200 hover:brightness-110"
            style={{ background: accent, color: '#06140C', fontFamily: "'Inter', system-ui, sans-serif", borderRadius: '0px' }}>
            Pedir presupuesto
            <span>→</span>
          </a>
          {/* Desktop: botón secundario | Mobile: link discreto */}
          <a href="#portfolio" class="hidden md:inline-flex items-center gap-2 px-6 py-4 text-[15px] font-medium rounded-none transition-all duration-200"
            style={{ background: surface, color: white, border: `1px solid ${lineStr}`, fontFamily: "'Inter', system-ui, sans-serif", borderRadius: '0px' }}>
            Ver portfolio →
          </a>
          <a href="#portfolio" class="md:hidden text-[14px] font-medium underline underline-offset-4 decoration-1"
            style={{ color: textSoft, textDecorationColor: 'rgba(250,250,250,0.25)', fontFamily: "'Inter', system-ui, sans-serif" }}>
            Ver portfolio →
          </a>
          <span class="text-[11px] tracking-[1.5px] ml-2 hidden md:inline" style={{ color: textDim, fontFamily: "'JetBrains Mono', monospace" }}>
            WHATSAPP · +54 9 3757 652007
          </span>
        </div>

        {/* Microcopy de Confianza */}
        <p class="text-[12px] max-w-[620px] leading-relaxed mt-0.5" style={{ color: textDim, fontFamily: "'Inter', system-ui, sans-serif" }}>
          ✨ <strong style={{ color: textSoft }}>Reservá tu diagnóstico sin cargo hoy</strong> y congelá la tarifa. Seña del 50% al iniciar para guardar tu lugar y asegurar tu fecha de entrega en junio.
        </p>
      </div>

      {/* Stats */}
      <div class="hero-stats grid grid-cols-2 md:grid-cols-4 reveal reveal-slide-up delay-250" style={`border-top:1px solid ${line}; border-bottom:1px solid ${line}; background:rgba(18,19,22,0.5); backdrop-filter:blur(12px);`}>
        {stats.map((s, i) => (
          <div class={`hero-stat-cell hero-stat-cell-${i} flex flex-col gap-1.5 py-3.5 px-4 md:py-4 md:px-6 min-w-0 ${s.desktopOnly ? 'hide-on-mobile' : ''}`}>
            <span class="font-geist text-white leading-none hero-stat-num"
              style="letter-spacing:-0.02em; font-weight:500;">
              {s.n}
            </span>
            <span class="text-[12px] md:text-[13px] leading-tight" style={{ color: textDim, fontFamily: "'Inter', system-ui, sans-serif" }}>
              {s.k}
            </span>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  /* Hero — comprimido con !important para vencer overrides de global.css y otros */
  .hero-inner {
    padding-top: clamp(32px, 4vh, 56px) !important;
    padding-bottom: clamp(48px, 6vh, 72px) !important;
  }

  @media (min-width: 768px) {
    .hero-inner {
      padding-top: clamp(56px, 8vh, 100px) !important;
      padding-bottom: clamp(56px, 8vh, 100px) !important;
    }
  }

  .hero-eyebrow {
    margin-bottom: clamp(24px, 3.5vh, 36px) !important;
  }

  .hero-h1 {
    font-family: 'Geist', 'Inter', system-ui, sans-serif !important;
    font-weight: 700 !important;
    font-size: clamp(38px, 9vw, 84px) !important;
    line-height: 0.98 !important;
    letter-spacing: -0.035em !important;
    margin: 0 0 clamp(22px, 3vh, 32px) 0 !important;
  }
  @media (min-width: 768px) {
    .hero-h1 {
      font-size: clamp(48px, 6vw, 84px) !important;
      line-height: 0.96 !important;
    }
  }

  .hero-subhead {
    font-family: 'Inter', system-ui, sans-serif !important;
    font-size: clamp(16px, 1.25vw, 19px) !important;
    line-height: 1.55 !important;
    margin: 0 0 clamp(28px, 4vh, 44px) 0 !important;
  }

  .hero-ctas {
    margin-bottom: clamp(36px, 5vh, 60px) !important;
  }

  /* Pulse del dot de cupos */
  .hero-eyebrow-ping {
    animation: heroEyebrowPing 2s cubic-bezier(0, 0, 0.2, 1) infinite;
  }
  @keyframes heroEyebrowPing {
    0%   { transform: scale(1);   opacity: 0.6; }
    75%, 100% { transform: scale(2.2); opacity: 0; }
  }

  /* Responsive del eyebrow: en mobile colapsa el divider */
  @media (max-width: 520px) {
    .hero-eyebrow {
      flex-wrap: wrap;
      gap: 8px 10px !important;
    }
    .hero-eyebrow-divider {
      display: none;
    }
  }

  /* Stats: número responsive, evita overflow en mobile */
  .hero-stat-num {
    font-size: clamp(22px, 6.5vw, 38px);
    white-space: nowrap;
  }

  /* Mobile: sólo 2 stats visibles (cells 0 y 1), borde divisorio vertical entre ellas */
  .hero-stat-cell-0 {
    border-right: 1px solid rgba(250,250,250,0.08);
  }
  /* Desktop: 4 stats, separadores verticales entre todas excepto la última */
  @media (min-width: 768px) {
    .hero-stat-cell-0, .hero-stat-cell-1, .hero-stat-cell-2 {
      border-right: 1px solid rgba(250,250,250,0.08);
    }
  }
</style>


{/* Clients strip — desktop: estático con wrap | mobile: marquee infinito */}
<section class="clients-strip" style={`border-top:1px solid ${line}; border-bottom:1px solid ${line}; background:${surface};`} aria-label="Clientes">
  {/* Desktop */}
  <div class="hidden md:flex clients-strip-inner max-w-[1320px] mx-auto px-6 md:px-10 py-5 items-center gap-6 md:gap-10 md:flex-wrap">
    <span class="text-[11px] tracking-[2.5px] uppercase whitespace-nowrap" style={{ color: textDim, fontFamily: "'JetBrains Mono', monospace" }}>
      CLIENTES //
    </span>
    {clients.map(c => (
      <span class="text-[14px] md:text-[15px] font-medium whitespace-nowrap md:whitespace-normal" style={{ color: textSoft, fontFamily: "'Geist', 'Inter', system-ui, sans-serif", opacity: 0.85, letterSpacing: '-0.01em' }}>
        {c}
      </span>
    ))}
  </div>

  {/* Mobile: marquee infinito */}
  <div class="md:hidden clients-marquee py-3.5" aria-hidden="true">
    <div class="clients-marquee-track">
      {[...clients, ...clients].map(c => (
        <span class="clients-marquee-item" style={{ color: textSoft, fontFamily: "'Geist', 'Inter', system-ui, sans-serif" }}>
          <span class="clients-marquee-dot" style={{ background: accent }}></span>
          {c}
        </span>
      ))}
    </div>
  </div>
</section>

<style>
  /* Marquee mobile — scroll horizontal infinito */
  .clients-marquee {
    overflow: hidden;
    position: relative;
    mask-image: linear-gradient(90deg, transparent 0, #000 8%, #000 92%, transparent 100%);
    -webkit-mask-image: linear-gradient(90deg, transparent 0, #000 8%, #000 92%, transparent 100%);
  }
  .clients-marquee-track {
    display: inline-flex;
    align-items: center;
    gap: 28px;
    padding-left: 28px;
    white-space: nowrap;
    animation: clientsMarquee 28s linear infinite;
    width: max-content;
  }
  .clients-marquee-item {
    font-size: 13.5px;
    font-weight: 500;
    letter-spacing: -0.01em;
    opacity: 0.82;
    display: inline-flex;
    align-items: center;
    gap: 10px;
  }
  .clients-marquee-dot {
    width: 4px;
    height: 4px;
    border-radius: 50%;
    box-shadow: 0 0 6px currentColor;
    opacity: 0.7;
    flex-shrink: 0;
  }
  @keyframes clientsMarquee {
    from { transform: translateX(0); }
    to   { transform: translateX(-50%); }
  }
  @media (prefers-reduced-motion: reduce) {
    .clients-marquee-track { animation: none; }
  }
</style>

<script>
  // Slow down hero video for cinematic feel. Only runs if video element exists
  // (which means we're on md+ — el <video> tiene `hidden md:block`).
  const video = document.getElementById('heroVideo') as HTMLVideoElement | null;
  if (video) video.playbackRate = 0.35;
</script>

