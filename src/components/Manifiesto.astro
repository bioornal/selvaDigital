---
const accent = '#2BB673';
const bg = '#0A0B0D';
const surface = '#121316';
const textSoft = 'rgba(250,250,250,0.72)';
const textDim = 'rgba(250,250,250,0.46)';
const line = 'rgba(250,250,250,0.08)';
const lineStr = 'rgba(250,250,250,0.18)';

const pillars = [
  {
    n: '01',
    title: 'Pagás cuando estás conforme',
    desc: '40% para arrancar (seña), 30% al aprobar el diseño, 30% al ver el sitio funcionando. Si el resultado final no te convence, el último 30% no se cobra y el sitio no se publica.',
    icon: 'lock'
  },
  {
    n: '02',
    title: 'Hablás conmigo, no con un PM',
    desc: 'Sin agencias, sin equipos rotando, sin mensajes que rebotan. Yo te respondo, yo diseño, yo programo. Si tenés una idea a las 11 de la noche, me la mandás directo.',
    icon: 'chat'
  },
  {
    n: '03',
    title: 'Llaves en mano, sin cuotas',
    desc: 'Recibís el sitio funcionando, capacitación incluida y un panel para editar tu contenido cuando quieras. El primer año dominio y hosting van por mi cuenta. Después, sólo se renueva — sin cuotas mensuales escondidas.',
    icon: 'key'
  },
];
---

<section id="manifiesto" class="relative manifiesto-section" style={`background:${bg}; padding:clamp(64px, 8vw, 110px) 0;`}>
  {/* Faint accent line at top — desktop only */}
  <div class="hidden md:block absolute top-0 left-[15%] right-[15%] h-px" style={`background:linear-gradient(90deg, transparent, ${accent}, transparent);`}></div>

  <div class="max-w-[1320px] mx-auto px-6 md:px-10">
    {/* Heading */}
    <div class="text-center mb-[60px]">
      <div class="inline-flex items-center gap-2.5 mb-[18px] justify-center">
        <span class="w-3.5 h-px" style={{ background: accent }}></span>
        <span class="text-[11px] tracking-[2.5px] uppercase" style={{ color: accent, fontFamily: "'JetBrains Mono', monospace" }}>
          09 ─── Cómo trabajo con vos
        </span>
      </div>
      <h2 class="font-geist font-semibold text-white leading-[1.02] tracking-tight mb-[18px]"
        style="font-size:clamp(36px, 4.5vw, 56px); letter-spacing:-0.025em;">
        Sin letra chica.<br>
        <span style={{ color: accent }}>Así de simple.</span>
      </h2>
      <p class="text-base md:text-[17px] leading-relaxed max-w-[640px] mx-auto" style={{ color: textSoft, fontFamily: "'Inter', system-ui, sans-serif" }}>
        Tres reglas claras que respetamos los dos. Sin contratos pesados, sin sorpresas en la factura.
      </p>
    </div>

    {/* Cards */}
    <div class="grid grid-cols-1 md:grid-cols-3 gap-2 md:gap-4">
      {pillars.map(p => (
        <div class="manifiesto-card relative flex flex-col p-5 md:p-8 transition-all"
          style={{
            background: surface,
            border: `1px solid ${line}`,
            borderRadius: '14px'
          }}>
          {/* Mobile: ícono + número en fila | Desktop: ícono arriba */}
          <div class="flex items-center gap-3 mb-3 md:hidden">
            <div class="inline-flex items-center justify-center w-9 h-9 flex-shrink-0"
              style={{
                background: 'rgba(43,182,115,0.12)',
                border: `1px solid rgba(43,182,115,0.35)`,
                borderRadius: '10px',
                color: accent
              }}>
              {p.icon === 'lock' && (
                <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
                  <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
                </svg>
              )}
              {p.icon === 'chat' && (
                <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path>
                </svg>
              )}
              {p.icon === 'key' && (
                <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M21 2l-2 2m-7.61 7.61a5.5 5.5 0 1 1-7.778 7.778 5.5 5.5 0 0 1 7.777-7.777zm0 0L15.5 7.5m0 0l3 3L22 7l-3-3m-3.5 3.5L19 4"></path>
                </svg>
              )}
            </div>
            <div class="text-[10px] tracking-[2px]" style={{ color: textDim, fontFamily: "'JetBrains Mono', monospace" }}>{p.n} / 03</div>
          </div>

          {/* Desktop: ícono arriba */}
          <div class="hidden md:inline-flex mb-6 items-center justify-center w-12 h-12"
            style={{
              background: 'rgba(43,182,115,0.12)',
              border: `1px solid rgba(43,182,115,0.35)`,
              borderRadius: '12px',
              color: accent
            }}>
            {p.icon === 'lock' && (
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
                <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
              </svg>
            )}
            {p.icon === 'chat' && (
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path>
              </svg>
            )}
            {p.icon === 'key' && (
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M21 2l-2 2m-7.61 7.61a5.5 5.5 0 1 1-7.778 7.778 5.5 5.5 0 0 1 7.777-7.777zm0 0L15.5 7.5m0 0l3 3L22 7l-3-3m-3.5 3.5L19 4"></path>
              </svg>
            )}
          </div>
          <div class="hidden md:block text-[10.5px] tracking-[2px] mb-3" style={{ color: textDim, fontFamily: "'JetBrains Mono', monospace" }}>
            {p.n} / 03
          </div>

          {/* Title */}
          <h3 class="font-geist font-semibold text-white mb-2 md:mb-3"
            style={{ fontSize: '18px', lineHeight: 1.2, letterSpacing: '-0.01em' }}>
            {p.title}
          </h3>

          {/* Description */}
          <p class="text-[14px] leading-[1.6]" style={{ color: textSoft, fontFamily: "'Inter', system-ui, sans-serif" }}>
            {p.desc}
          </p>
        </div>
      ))}
    </div>

    {/* Footer pill — desktop only */}
    <div class="hidden md:flex justify-center mt-10">
      <div class="inline-flex items-center gap-3 px-4 py-[7px]" style={`border:1px solid ${line}; background:rgba(18,19,22,0.7); backdrop-filter:blur(8px); border-radius:999px;`}>
        <span class="w-[6px] h-[6px]" style={`background:${accent}; border-radius:50%; box-shadow:0 0 12px ${accent};`}></span>
        <span class="text-[11px] tracking-[2px] uppercase" style={{ color: textSoft, fontFamily: "'JetBrains Mono', monospace" }}>
          Cerramos por WhatsApp · Sin contratos pesados
        </span>
      </div>
    </div>
  </div>
</section>

<style>
  @media (min-width: 768px) {
    .manifiesto-section { border-top: 1px solid rgba(250,250,250,0.08); }
  }

  .manifiesto-card {
    position: relative;
  }
  .manifiesto-card::before {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: 14px;
    pointer-events: none;
    background: radial-gradient(circle at 0% 0%, rgba(43,182,115,0.08), transparent 50%);
    opacity: 0;
    transition: opacity 0.3s ease;
  }
  .manifiesto-card:hover {
    border-color: rgba(43,182,115,0.4) !important;
    transform: translateY(-2px);
  }
  .manifiesto-card:hover::before {
    opacity: 1;
  }
</style>
