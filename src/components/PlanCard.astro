---
export interface Plan {
  name: string;
  price: string;
  popular: boolean;
  desde: boolean;
  features: string[];
}

interface Props {
  plan: Plan;
  variant?: 'mobile' | 'desktop' | 'advanced';
}

const { plan, variant = 'desktop' } = Astro.props;
const isMobile = variant === 'mobile';
const isAdvanced = variant === 'advanced';
---

{isAdvanced ? (
  <div class="relative group h-full flex">
    <div class="hud-container p-6 flex flex-col w-full border-ai-violet-500/20 hover:border-ai-violet-500/50">
      <div class="flex items-center gap-2 mb-3">
        <span class="text-[10px] px-2 py-0.5 bg-ai-violet-500/10 text-ai-violet-300 border border-ai-violet-500/20 font-mono uppercase tracking-tight">System: Custom</span>
      </div>
      <div class="flex-grow">
        <h3 class="text-xl font-bold text-white mb-3 font-heading uppercase">{plan.name}</h3>
        <div class="mb-5">
          <p class="text-3xl font-bold text-ai-violet-400 font-mono">
            ${plan.price} <span class="text-sm">+</span>
          </p>
          <p class="text-[10px] text-white/60 font-mono uppercase tracking-widest mt-1">Según alcance</p>
        </div>
        
        <ul class="space-y-3 mb-6">
          {plan.features.map((feature) => (
            <li class="flex items-start text-white/70 text-xs font-mono uppercase tracking-tighter">
              <span class="text-ai-violet-400/60 mr-2 flex-shrink-0 text-[10px]">—</span>
              <span>{feature}</span>
            </li>
          ))}
        </ul>
      </div>

      <a 
        href="#contacto"
        class="w-full py-3 px-6 font-mono text-xs uppercase tracking-widest text-center block transition-all duration-300 mt-auto bg-ai-violet-500/10 text-white hover:bg-ai-violet-500/30 border border-ai-violet-500/30 rounded-none"
      >
        Solicitar Presupuesto
      </a>
    </div>
  </div>
) : isMobile ? (
  <div class="relative">
    {plan.popular && (
        <div class="absolute -top-3 left-1/2 -translate-x-1/2 bg-emerald-500 text-white px-3 py-0.5 text-[10px] font-mono uppercase tracking-tight z-10">
        Más Elegido
      </div>
    )}
    <div class={`
      hud-container p-4 
      h-full flex flex-col
      ${plan.popular ? 'border-emerald-500/30' : ''}
    `}>
      <div class="flex-grow">
        <h3 class="text-lg font-bold text-white mb-2 font-heading uppercase">{plan.name}</h3>
        <div class="mb-4">
          <p class="text-2xl font-bold text-azure-radiance-400 font-mono">
            {plan.desde ? 'Desde ' : ''}${plan.price}
          </p>
          <p class="text-[10px] text-white/60 font-mono uppercase">Pago único</p>
        </div>
        
        <ul class="space-y-2 mb-6 text-[11px] font-mono uppercase tracking-tighter">
          {plan.features.map((feature) => (
            <li class="flex items-start text-white/70">
              <span class="text-emerald-500/60 mr-2 flex-shrink-0 text-[10px]">—</span>
              <span>{feature}</span>
            </li>
          ))}
        </ul>
      </div>

      <a 
        href="#contacto"
        class={`
          w-full py-2 px-4 font-mono text-[11px] uppercase tracking-widest text-center block rounded-none
          transition-all duration-300
          ${plan.popular 
            ? 'bg-azure-radiance-600 text-white' 
            : 'bg-white/5 text-white hover:bg-white/10 border border-white/10'
          }
        `}
      >
        Iniciar Pedido
      </a>
    </div>
  </div>
) : (
  <div class="relative group h-full flex">
    {plan.popular && (
        <div class="absolute -top-4 left-1/2 -translate-x-1/2 bg-emerald-500 text-white px-4 py-1 text-[10px] font-mono uppercase tracking-tight z-10">
        Más Elegido
      </div>
    )}
    <div class={`
      hud-container p-6 
      transition-all duration-300 flex flex-col w-full
      ${plan.popular ? 'border-emerald-500/30' : ''}
    `}>
      <div class="flex-grow">
        <h3 class="text-xl font-bold text-white mb-3 font-heading uppercase">{plan.name}</h3>
        <div class="mb-5">
          <p class="text-3xl font-bold text-azure-radiance-400 font-mono">
            ${plan.price}
          </p>
          <p class="text-[10px] text-white/40 font-mono uppercase tracking-widest mt-1">Pago único</p>
        </div>
        
        <ul class="space-y-3 mb-6">
          {plan.features.map((feature) => (
            <li class="flex items-start text-white/70 text-xs font-mono uppercase tracking-tighter">
              <span class="text-emerald-400/60 mr-2 flex-shrink-0 text-[10px]">—</span>
              <span>{feature}</span>
            </li>
          ))}
        </ul>
      </div>

      <a 
        href="#contacto"
        class={`
          w-full py-3 px-6 font-mono text-xs uppercase tracking-widest text-center block rounded-none
          transition-all duration-300 mt-auto
          ${plan.popular 
            ? 'bg-azure-radiance-600 text-white hover:bg-azure-radiance-500 shadow-[0_0_15px_rgba(0,123,255,0.3)]' 
            : 'bg-white/5 text-white hover:bg-white/10 border border-white/10'
          }
        `}
      >
        Iniciar Pedido
      </a>
    </div>
  </div>
)}
