    img: 'https://res.cloudinary.com/djtvjkcu6/image/upload/v1779842341/SelvaDigital/4ee423a3-f907-4d6e-9800-1ef9b4a7330e.png',
    desc: 'Dashboard multi-marca y planificador editorial con IA integrado para automatizar y diseñar la grilla de Instagram en segundos.',
    kpi: 'Grilla en minutos', sub: '100% automatizado',
    stack: ['React','Vite','Fal.ai','Tailwind'],
    url: 'https://mk-panel.netlify.app/'
  },
  {
    title: 'Carro Fogón', tag: 'Sistema',
    img: 'https://res.cloudinary.com/djtvjkcu6/image/upload/v1778503356/SelvaDigital/FogonPedidos_npzdw3.png',
