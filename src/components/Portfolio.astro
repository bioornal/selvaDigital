  { 
    title: 'Carro Fogón - Sistema de Pedidos',
    description: 'Sistema gastronómico de toma de pedidos y gestión de clientes con dashboard en tiempo real.',
    image: 'https://res.cloudinary.com/djtvjkcu6/image/upload/v1778503356/SelvaDigital/FogonPedidos_npzdw3.png',
    url: 'https://carro-fogon-rcmgt8lva-bioornals-projects.vercel.app/login',
    tags: ['React', 'Node.js', 'Firebase'],
    resultado: 'Gestión de pedidos automatizada'
  },
  { 
    title: 'Recetario Napolitano',
    description: 'Sistema de recetas con calculadora de masa, gestión de costos y precios para pizzería artesanal.',
    image: 'https://res.cloudinary.com/djtvjkcu6/image/upload/v1778503356/SelvaDigital/FogonRecetario_vzfnfn.png',
    url: 'https://recetarionapolitano.netlify.app/login/',
    tags: ['React', 'Netlify', 'Node.js'],
    resultado: 'Control de costos preciso'
  },
  { 
    title: 'MegaStock',
    description: 'Sistema de inventario y ventas para empresa de muebles con gestión de stock en tiempo real.',
    image: 'https://res.cloudinary.com/djtvjkcu6/image/upload/v1778503357/SelvaDigital/MegaStock_ovfjhx.png',
    url: 'https://megastock-app.netlify.app/login',
