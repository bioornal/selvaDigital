  },
  {
    title: 'Recetario Napolitano', tag: 'Sistema',
    img: 'https://res.cloudinary.com/djtvjkcu6/image/upload/v1778503356/SelvaDigital/FogonRecetario_vzfnfn.png',
    desc: 'Sistema de recetas con calculadora de masa, gestión de costos y precios para pizzería artesanal.',
    kpi: 'Costos optimizados', sub: 'en producción',
    stack: ['React','Netlify','Node.js'],
    url: 'https://recetarionapolitano.netlify.app/login/'
  },
];

const INITIAL_VISIBLE = 3;
const extraCount = projects.length - INITIAL_VISIBLE;
---

<section id="portfolio" class="relative" style={`background:${bg}; padding:clamp(64px, 8vw, 120px) 0;`}>
  <div class="max-w-[1320px] mx-auto px-6 md:px-10">
    {/* Header */}
    <div class="flex flex-wrap items-end justify-between gap-8 mb-12">
      <div class="text-center md:text-left w-full md:w-auto">
        <div class="inline-flex items-center gap-2.5 mb-[18px]">
          <span class="w-3.5 h-px" style={{ background: accent }}></span>
          <span class="text-[11px] tracking-[2.5px] uppercase" style={{ color: accent, fontFamily: "'JetBrains Mono', monospace" }}>
            02 ─── Portfolio
          </span>
        </div>
        <h2 class="section-h2 font-geist font-semibold text-white leading-[1.02] tracking-tight mb-[18px]"
          style="font-size:clamp(36px, 4.5vw, 56px); letter-spacing:-0.025em;">
          Proyectos en producción.<br>
          <span style={{ color: accent }}>Sin mockups, sin filtros.</span>
        </h2>
        <p class="section-sub text-[17px] leading-[1.55] max-w-[620px] mx-auto md:mx-0" style={{ color: textSoft, fontFamily: "'Inter', system-ui, sans-serif" }}>
          Cada uno con cliente real, métricas reales y sitio que podés visitar ahora mismo.
        </p>
      </div>
    </div>

    {/* Grid principal */}
    <div id="portfolio-grid-container" class="portfolio-grid grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-7 md:gap-8">
      {projects.map((p, i) => (
        <article
          class={`portfolio-card flex flex-col overflow-hidden w-full min-w-0 transition-all duration-500 ease-in-out ${i >= INITIAL_VISIBLE ? 'portfolio-extra-card hidden' : ''}`}
          style={{ background: surface, borderRadius: '14px', border: `1px solid ${line}` }}
          data-index={i}
        >
          {/* Image */}
          <div class="relative overflow-hidden" style={{ aspectRatio: '16/10', background: '#000' }}>
            <img src={p.img} alt={p.title} class="w-full h-full object-cover transition-transform duration-700 hover:scale-105" loading="lazy" />
            {/* Tag */}
            <div class="absolute top-3.5 left-3.5 text-[9px] tracking-[2px] uppercase px-2.5 py-1"
              style={{
                background: 'rgba(10,11,13,0.8)',
                backdropFilter: 'blur(8px)',
                color: white,
                border: `1px solid ${line}`,
                fontFamily: "'JetBrains Mono', monospace",
                borderRadius: '999px'
              }}>
              {p.tag}
            </div>
            {/* KPI */}
            <div class="absolute top-3.5 right-3.5 text-[11px] font-semibold px-2.5 py-1"
              style={{
                background: 'rgba(43,182,115,0.16)',
                color: accent,
                border: `1px solid rgba(43,182,115,0.4)`,
                fontFamily: "'Inter', system-ui, sans-serif",
                borderRadius: '999px',
                backdropFilter: 'blur(8px)'
              }}>
              ● {p.kpi}
            </div>
          </div>

          {/* Content */}
          <div class="flex flex-col flex-1 p-5 md:p-6">
            <div class="flex items-baseline justify-between gap-3 mb-2">
              <h3 class="font-geist font-semibold text-white text-[22px] tracking-tight" style={{ letterSpacing: '-0.02em' }}>
                {p.title}
              </h3>
              <span class="text-[10px] tracking-wide whitespace-nowrap" style={{ color: textDim, fontFamily: "'JetBrains Mono', monospace" }}>
                {p.sub}
              </span>
            </div>
            <p class="text-[13.5px] leading-relaxed mb-4 flex-1" style={{ color: textSoft, fontFamily: "'Inter', system-ui, sans-serif" }}>
              {p.desc}
            </p>
            <div class="flex flex-wrap gap-1.5 mb-4">
              {p.stack.map(t => (
                <span class="text-[10px] tracking-[1px] px-2 py-1" style={{
                  color: textSoft,
                  background: surface2,
                  border: `1px solid ${line}`,
                  fontFamily: "'JetBrains Mono', monospace",
                  borderRadius: '6px'
                }}>{t}</span>
              ))}
            </div>
            <div class="flex justify-between items-center pt-3.5" style={{ borderTop: `1px solid ${line}` }}>
              <a href={p.url} target="_blank" rel="noopener noreferrer" class="text-[13px] font-medium inline-flex items-center gap-1.5 group" style={{ color: white, fontFamily: "'Inter', system-ui, sans-serif", textDecoration: 'none' }}>
                Ver sitio <span style={{ color: accent }} class="transition-transform group-hover:translate-x-1">→</span>
              </a>
              <span class="text-[10px] tracking-[0.5px]" style={{ color: textDim, fontFamily: "'JetBrains Mono', monospace" }}>↗ LIVE</span>
            </div>
          </div>
        </article>
      ))}
    </div>

    {/* Botón desplegable moderno */}
    <div class="flex justify-center mt-12">
      <button
        type="button"
        id="portfolio-toggle-btn"
        class="group relative inline-flex items-center gap-3 px-8 py-4 text-[13px] font-semibold tracking-wider uppercase transition-all duration-300 rounded-none cursor-pointer"
        style={{
          background: surface,
          color: white,
          border: `1px solid ${line}`,
          fontFamily: "'JetBrains Mono', monospace"
        }}
        data-expanded="false"
        data-extra-count={extraCount}
      >
        <span id="portfolio-btn-text" class="transition-colors group-hover:text-[#2BB673]">
          Ver todos los proyectos ({projects.length}) ↓
        </span>
        <span
          id="portfolio-btn-icon"
          class="w-5 h-5 rounded-full flex items-center justify-center text-[10px] transition-transform duration-300"
          style={{ background: 'rgba(43,182,115,0.15)', color: accent }}
        >
          ↓
        </span>
      </button>
    </div>
  </div>
</section>

<script>
  const toggleBtn = document.getElementById('portfolio-toggle-btn');
  const btnText = document.getElementById('portfolio-btn-text');
  const btnIcon = document.getElementById('portfolio-btn-icon');
  const extraCards = document.querySelectorAll('.portfolio-extra-card');

  if (toggleBtn && btnText && btnIcon) {
    toggleBtn.addEventListener('click', () => {
      const isExpanded = toggleBtn.getAttribute('data-expanded') === 'true';

      if (isExpanded) {
        // Colapsar
        extraCards.forEach(card => card.classList.add('hidden'));
        toggleBtn.setAttribute('data-expanded', 'false');
        btnText.textContent = `Ver todos los proyectos (${extraCards.length + 3}) ↓`;
        btnIcon.textContent = '↓';
        btnIcon.style.transform = 'rotate(0deg)';
        
        // Scroll suave de regreso al portfolio header
        const portfolioSection = document.getElementById('portfolio');
        if (portfolioSection) {
          portfolioSection.scrollIntoView({ behavior: 'smooth' });
        }
      } else {
        // Desplegar
        extraCards.forEach(card => card.classList.remove('hidden'));
        toggleBtn.setAttribute('data-expanded', 'true');
        btnText.textContent = 'Mostrar menos ↑';
        btnIcon.textContent = '↑';
        btnIcon.style.transform = 'rotate(180deg)';
      }
    });
  }
</script>

<style>
  #portfolio-toggle-btn:hover {
    border-color: rgba(43,182,115,0.4);
    box-shadow: 0 0 20px rgba(43,182,115,0.15);
  }
</style>
