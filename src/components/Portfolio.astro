const projectDomain = (url: string) => new URL(url).hostname.replace(/^www\./, '');

---

<section id="portfolio" class="section on-deep" aria-labelledby="portfolio-title">
  <div class="wrap">
    <header class="portfolio-heading">
      <h2 id="portfolio-title" class="h2">Trabajos reales.<br /><mark>Abrilos y probalos.</mark></h2>
    </header>
    <div class="portfolio-selector hidden lg:grid">
      <ol class="project-list" aria-label="Seleccionar un trabajo">
        {projects.map((p, i) => (
          <li>
            <button type="button" id={`portfolio-choice-${i}`} class="project-choice" data-project-choice={i}
              aria-label={`${p.title}, ${p.tag}`}
              aria-pressed={i === 0 ? 'true' : 'false'} aria-controls={`portfolio-image-${i} portfolio-panel-${i}`}>
              <span class="project-name">{p.title}</span><span class="project-tag">{p.tag}</span>
            </button>
          </li>
        ))}
      </ol>
      <div class="project-viewer">
        <div class="project-screen">
          {projects.map((p, i) => (
            <img id={`portfolio-image-${i}`} class:list={['project-image', { 'is-active': i === 0 }]}
              src={p.img} alt={`Sitio de ${p.title}`} width="1200" height="750"
              loading={i === 0 ? 'eager' : 'lazy'} decoding="async" aria-hidden={i !== 0 ? 'true' : 'false'} />
          ))}
        </div>
        {projects.map((p, i) => (
          <div id={`portfolio-panel-${i}`} class="project-panel" data-project-panel={i} role="region" aria-labelledby={`portfolio-choice-${i}`} hidden={i !== 0}>
            <p class="project-description">{p.desc}</p>
            <p class="mono project-meta"><span>{p.sub}</span><span>{p.kpi}</span></p>
            <a class="btn btn-primary project-open" href={p.url} target="_blank" rel="noopener noreferrer"><span>Abrir {projectDomain(p.url)}</span><span class="project-arrow"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M6 18 18 6M6 6h12v12" /></svg></span></a>
          </div>
        ))}
      </div>
    </div>
    <div class="portfolio-mobile lg:hidden">
      <ol class="project-cards snap-row" aria-label={`Trabajos: deslizá para ver los ${projects.length}`}>
        {projects.map((p, i) => (
          <li class="project-card">
            <a class="project-card-link" href={p.url} target="_blank" rel="noopener noreferrer">
              <span class="project-screen"><img src={p.img} alt={`Sitio de ${p.title}`} width="1200" height="750" loading={i < 2 ? "eager" : "lazy"} decoding="async" /></span>
              <span class="project-card-heading"><span class="h3">{p.title}</span><span class="project-tag">{p.tag}</span></span>
              <span class="project-description">{p.desc}</span>
              <span class="mono project-meta"><span>{p.sub}</span><span>{p.kpi}</span></span>
              <span class="btn btn-primary project-visit"><span>Abrir {projectDomain(p.url)}</span><span class="project-arrow"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M6 18 18 6M6 6h12v12" /></svg></span></span>
            </a>
          </li>
        ))}
      </ol>
      <div class="project-nav">
        <div class="project-nav-buttons">
          <button type="button" class="project-step" data-step="-1" aria-label="Trabajo anterior"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M15 6l-6 6 6 6" /></svg></button>
          <button type="button" class="project-step" data-step="1" aria-label="Trabajo siguiente"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M9 6l6 6-6 6" /></svg></button>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  const portfolio = document.getElementById('portfolio');
  if (portfolio) {
    const choices = Array.from(portfolio.querySelectorAll<HTMLButtonElement>('[data-project-choice]'));
    const images = Array.from(portfolio.querySelectorAll<HTMLImageElement>('.project-image'));
    const panels = Array.from(portfolio.querySelectorAll<HTMLElement>('[data-project-panel]'));
    const hoverPointer = window.matchMedia('(hover: hover) and (pointer: fine)');
    let active = 0;

    function selectProject(index: number) {
      if (index === active) return;
      const previous = active;
      active = index;
      choices.forEach((choice, i) => choice.setAttribute('aria-pressed', String(i === active)));
      images.forEach((image, i) => {
        image.classList.toggle('is-active', i === active);
        image.classList.toggle('is-previous', i === previous);
        image.setAttribute('aria-hidden', String(i !== active));
      });
      panels.forEach((panel, i) => { panel.hidden = i !== active; });
    }

    choices.forEach((choice, index) => {
      choice.addEventListener('mouseenter', () => {
        if (hoverPointer.matches) selectProject(index);
      });
      choice.addEventListener('focus', () => selectProject(index));
      choice.addEventListener('click', () => selectProject(index));
      choice.addEventListener('keydown', (event) => {
        let next: number;
        if (event.key === 'ArrowDown') next = (index + 1) % choices.length;
        else if (event.key === 'ArrowUp') next = (index - 1 + choices.length) % choices.length;
        else if (event.key === 'Home') next = 0;
        else if (event.key === 'End') next = choices.length - 1;
        else return;
        event.preventDefault();
        choices[next].focus();
      });
    });

    const row = portfolio.querySelector<HTMLElement>(".project-cards");
    portfolio.querySelectorAll<HTMLButtonElement>(".project-step").forEach((btn) => {
      btn.addEventListener("click", () => {
        if (!row) return;
        const card = row.querySelector<HTMLElement>(".project-card");
        const step = (card ? card.offsetWidth + 12 : row.clientWidth * 0.8) * Number(btn.dataset.step);
        const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
        row.scrollBy({ left: step, behavior: reduce ? "auto" : "smooth" });
      });
    });
  }
</script>

<style>
  #portfolio { position: relative; isolation: isolate; --portfolio-band-height: 70px; }
  @media (min-width: 1024px) { #portfolio { --portfolio-band-height: 140px; } }
  .portfolio-heading { margin-bottom: clamp(36px, 5vw, 64px); }
  .portfolio-heading .h2 { margin: 0; font-size: var(--fs-h2-work); }
  .portfolio-heading mark { background: var(--lime); color: var(--petrol); padding: 0 .12em; box-decoration-break: clone; -webkit-box-decoration-break: clone; }
  .portfolio-selector { grid-template-columns: minmax(0, 2fr) minmax(0, 3fr); gap: clamp(28px, 4vw, 64px); align-items: start; }
  .project-list { list-style: none; margin: 0; padding: 0; border-top: 1px solid var(--line-petrol); }
  .project-list li { border-bottom: 1px solid var(--line-petrol); }
  .project-choice { display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: 12px; align-items: center; width: 100%; min-height: 84px; padding: 20px 0; border: 0; border-radius: 0; background: transparent; color: var(--on-petrol-dim); text-align: left; cursor: pointer; }
  .project-name { font-family: var(--font-display); font-size: var(--fs-h3); font-weight: 700; letter-spacing: -0.02em; line-height: 1.1; overflow-wrap: anywhere; }
  .project-choice[aria-pressed='true'] .project-name { color: var(--ice); }
  .project-tag { font-size: var(--fs-small); color: var(--on-petrol-dim); }
  .project-viewer { position: sticky; top: 100px; min-width: 0; }
  .project-screen { position: relative; aspect-ratio: 16 / 10; overflow: hidden; background: var(--petrol-raised); }
  .project-screen::after { content: ''; position: absolute; inset: 0; z-index: 3; pointer-events: none; box-shadow: inset 0 0 0 1px var(--line-petrol-strong); }
  .project-screen img { display: block; width: 100%; height: 100%; object-fit: cover; object-position: top; }
  .project-image { position: absolute; inset: 0; z-index: 0; opacity: 0; clip-path: inset(100% 0 0 0); transition: opacity 550ms var(--ease-out), clip-path 550ms var(--ease-out); }
  .project-image.is-previous { z-index: 1; }
  .project-image.is-active { z-index: 2; opacity: 1; clip-path: inset(0); }
  .project-open { max-width: 100%; padding-block: 14px; }
  .project-open span { min-width: 0; overflow-wrap: anywhere; }
  .project-arrow { display: inline-flex; flex-shrink: 0; color: var(--petrol); }
  .project-open svg, .project-visit svg { flex-shrink: 0; }
  .project-panel { padding-top: 24px; }
  .project-panel[hidden] { display: none; }
  .project-description { margin: 0 0 20px; color: var(--on-petrol-soft); font-size: var(--fs-body); line-height: 1.55; }
  .project-meta { display: flex; flex-wrap: wrap; gap: 8px 20px; margin: 0 0 20px; color: var(--on-petrol-dim); }
  .project-meta span:last-child { color: var(--on-petrol-soft); }
  .portfolio-mobile { margin-inline: calc(var(--gutter) * -1); }
  .project-cards { list-style: none; margin: 0; padding-bottom: 4px; }
  .project-card { width: min(84vw, 420px); min-width: 0; }
  .project-card-link { display: flex; flex-direction: column; color: var(--ice); text-decoration: none; }
  .project-card .project-screen { display: block; }
  .project-card-heading { display: flex; flex-wrap: wrap; align-items: baseline; justify-content: space-between; gap: 10px; margin: 18px 0 10px; }
  .project-card .project-description { display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden; font-size: var(--fs-small); margin-bottom: 14px; }
  .project-card .project-meta { margin-bottom: 14px; }
  .project-visit { align-self: flex-start; max-width: 100%; gap: 8px; padding: 12px 14px; font-size: var(--fs-small); }
  .project-visit span { min-width: 0; overflow-wrap: anywhere; }
  .project-nav { display: flex; align-items: center; justify-content: flex-start; gap: 16px; margin-top: 16px; padding-inline: var(--gutter) max(var(--gutter), 84px); }
  .project-nav-buttons { display: flex; gap: 8px; }
  .project-step { display: inline-flex; align-items: center; justify-content: center; width: 48px; height: 48px; border: 1px solid var(--line-petrol-strong); border-radius: 0; background: transparent; color: var(--ice); cursor: pointer; }
  .project-step:hover { border-color: var(--ice); }
  @media (prefers-reduced-motion: reduce) { .project-image { transition: none; } }
</style>
