---
const accent = '#2BB673';
const bg = '#0A0B0D';
const surface = '#121316';
const surface2 = '#1A1C20';
const white = '#FAFAFA';
const textSoft = 'rgba(250,250,250,0.72)';
const textDim = 'rgba(250,250,250,0.46)';
const line = 'rgba(250,250,250,0.08)';

const projects = [
  {
    title: 'MegaMuebles', tag: 'E-commerce',
    img: 'https://res.cloudinary.com/djtvjkcu6/image/upload/v1778503357/SelvaDigital/Mega_ospdo9.png',
    desc: 'Catálogo completo + SEO local para una mueblería con 20 años de trayectoria en Argentina.',
    kpi: '+34% leads orgánicos', sub: '4 meses post-launch',
    stack: ['React','Cloudinary','GA4'],
    url: 'https://megamueblessommiers.online'
  },
  {
    title: 'Iguazú Falls Lodge', tag: 'Turismo',
    img: '/iguazuFalls.webp',
    desc: 'Reservas directas, galería premium y formulario optimizado para conversión de huéspedes premium.',
    kpi: '67% reservas sin OTAs', sub: 'antes era 12%',
    stack: ['Next.js','Cloudinary','Ads'],
    url: 'https://www.iguazufallslodge.com/'
  },
  {
    title: 'El Fogón Delivery', tag: 'Gastronomía',
    img: '/fogon.webp',
    desc: 'E-commerce gastronómico con MercadoPago, opciones sin TACC y carrito persistente entre dispositivos.',
    kpi: '×2.3 ticket promedio', sub: 'vs. pedidos por WhatsApp',
    stack: ['Next.js','Tailwind','S3'],
    url: 'https://proyecto-f-git-main-bioornals-projects.vercel.app/'
  },
  {
    title: 'Vip Translados Iguazú', tag: 'Landing',
    img: 'https://res.cloudinary.com/djtvjkcu6/image/upload/v1778505330/SelvaDigital/Vip_vvshcm.png',
    desc: 'Landing de traslados turísticos privados con Schema.org y campañas de Google Ads optimizadas.',
    kpi: 'CTR Ads ×2.1', sub: '$ por click bajó 40%',
    stack: ['React','Vite','Schema'],
    url: 'https://iguazu-taxi-maxi-landing-git-main-bioornals-projects.vercel.app/'
  },
  {
    title: 'Megabot Admin', tag: 'Sistema',
    img: 'https://res.cloudinary.com/djtvjkcu6/image/upload/v1778503356/SelvaDigital/Megabot_jczmp3.png',
    desc: 'Dashboard multiusuario para gestionar 3 chatbots con IA corriendo en un VPS propio, en tiempo real.',
    kpi: '3 bots, 1 panel', sub: '+1.200 msgs/día',
    stack: ['React','IA','VPS'],
    url: 'https://megabot-admin.cloud/login'
  },
  {
    title: 'Impasto Pizzería', tag: 'E-commerce',
    img: 'https://res.cloudinary.com/djtvjkcu6/image/upload/v1778503356/SelvaDigital/Impasto_o46wxm.png',
    desc: 'Pizzería online con menú interactivo, combos, empanadas por caja y checkout integrado.',
    kpi: 'En lanzamiento', sub: 'pre-orden activa',
    stack: ['React','Netlify','SEO'],
    url: 'https://vocal-naiad-861a2c.netlify.app/'
  },
  {
    title: 'Carro Fogón', tag: 'Sistema',
    img: 'https://res.cloudinary.com/djtvjkcu6/image/upload/v1778503356/SelvaDigital/FogonPedidos_npzdw3.png',
    desc: 'Sistema gastronómico de toma de pedidos y gestión de clientes con dashboard en tiempo real.',
    kpi: 'Pedidos automatizados', sub: 'en producción',
    stack: ['React','Node.js','Firebase'],
    url: 'https://carro-fogon-rcmgt8lva-bioornals-projects.vercel.app/login'
  },
  {
    title: 'Recetario Napolitano', tag: 'Sistema',
    img: 'https://res.cloudinary.com/djtvjkcu6/image/upload/v1778503356/SelvaDigital/FogonRecetario_vzfnfn.png',
    desc: 'Sistema de recetas con calculadora de masa, gestión de costos y precios para pizzería artesanal.',
    kpi: 'Costos optimizados', sub: 'en producción',
    stack: ['React','Netlify','Node.js'],
    url: 'https://recetarionapolitano.netlify.app/login/'
  },
  {
    title: 'MegaStock', tag: 'Sistema',
    img: 'https://res.cloudinary.com/djtvjkcu6/image/upload/v1778503357/SelvaDigital/MegaStock_ovfjhx.png',
    desc: 'Sistema de inventario y ventas para empresa de muebles con gestión de stock en tiempo real.',
    kpi: 'Stock en tiempo real', sub: 'en producción',
    stack: ['React','Node.js','PostgreSQL'],
    url: 'https://megastock-app.netlify.app/login'
  },
];
---

<section id="portfolio" class="relative" style={`background:${bg}; padding:clamp(64px, 8vw, 120px) 0;`}>
  <div class="max-w-[1320px] mx-auto px-6 md:px-10">
    {/* Header */}
    <div class="flex flex-wrap items-end justify-between gap-8 mb-12">
      <div class="text-center md:text-left w-full md:w-auto">
        <div class="inline-flex items-center gap-2.5 mb-[18px]">
          <span class="w-3.5 h-px" style={{ background: accent }}></span>
          <span class="text-[11px] tracking-[2.5px] uppercase" style={{ color: accent, fontFamily: "'JetBrains Mono', monospace" }}>
            02 ─── Portfolio
          </span>
        </div>
        <h2 class="section-h2 font-geist font-semibold text-white leading-[1.02] tracking-tight mb-[18px]"
          style="font-size:clamp(36px, 4.5vw, 56px); letter-spacing:-0.025em;">
          Proyectos en producción.<br>
          <span style={{ color: accent }}>Sin mockups, sin filtros.</span>
        </h2>
        <p class="section-sub text-[17px] leading-[1.55] max-w-[620px] mx-auto md:mx-0" style={{ color: textSoft, fontFamily: "'Inter', system-ui, sans-serif" }}>
          Cada uno con cliente real, métricas reales y sitio que podés visitar ahora mismo.
        </p>
      </div>
    </div>

    {/* Grid — mobile carousel (en mobile mostramos sólo 4 destacados; los 5 restantes se muestran al hacer click), md+ vuelve a grid completo */}
    <div class="portfolio-grid mobile-carousel md:grid-cols-2 lg:grid-cols-3" data-dots="portfolio">
      {projects.map((p, i) => (
        <article class={`portfolio-card flex flex-col overflow-hidden w-[85%] max-w-[85%] min-w-0 md:w-auto md:max-w-none ${i >= 4 ? 'portfolio-extra hide-on-mobile' : ''}`} style={{ background: surface, borderRadius: '14px', border: `1px solid ${line}` }}>
          {/* Image */}
          <div class="relative overflow-hidden" style={{ aspectRatio: '16/10', background: '#000' }}>
            <img src={p.img} alt={p.title} class="w-full h-full object-cover" />
            {/* Tag */}
            <div class="absolute top-3.5 left-3.5 text-[9px] tracking-[2px] uppercase px-2.5 py-1"
              style={{
                background: 'rgba(10,11,13,0.8)',
                backdropFilter: 'blur(8px)',
                color: white,
                border: `1px solid ${line}`,
                fontFamily: "'JetBrains Mono', monospace",
                borderRadius: '999px'
              }}>
              {p.tag}
            </div>
            {/* KPI */}
            <div class="absolute top-3.5 right-3.5 text-[11px] font-semibold px-2.5 py-1"
              style={{
                background: 'rgba(43,182,115,0.16)',
                color: accent,
                border: `1px solid rgba(43,182,115,0.4)`,
                fontFamily: "'Inter', system-ui, sans-serif",
                borderRadius: '999px',
                backdropFilter: 'blur(8px)'
              }}>
              ● {p.kpi}
            </div>
          </div>

          {/* Content */}
          <div class="flex flex-col flex-1 p-5 md:p-6">
            <div class="flex items-baseline justify-between gap-3 mb-2">
              <h3 class="font-geist font-semibold text-white text-[22px] tracking-tight" style={{ letterSpacing: '-0.02em' }}>
                {p.title}
              </h3>
              <span class="text-[10px] tracking-wide whitespace-nowrap" style={{ color: textDim, fontFamily: "'JetBrains Mono', monospace" }}>
                {p.sub}
              </span>
            </div>
            <p class="text-[13.5px] leading-relaxed mb-4 flex-1" style={{ color: textSoft, fontFamily: "'Inter', system-ui, sans-serif" }}>
              {p.desc}
            </p>
            <div class="flex flex-wrap gap-1.5 mb-4">
              {p.stack.map(t => (
                <span class="text-[10px] tracking-[1px] px-2 py-1" style={{
                  color: textSoft,
                  background: surface2,
                  border: `1px solid ${line}`,
                  fontFamily: "'JetBrains Mono', monospace",
                  borderRadius: '6px'
                }}>{t}</span>
              ))}
            </div>
            <div class="flex justify-between items-center pt-3.5" style={{ borderTop: `1px solid ${line}` }}>
              <a href={p.url} target="_blank" class="text-[13px] font-medium inline-flex items-center gap-1.5" style={{ color: white, fontFamily: "'Inter', system-ui, sans-serif", textDecoration: 'none' }}>
                Ver sitio <span style={{ color: accent }}>→</span>
              </a>
              <span class="text-[10px] tracking-[0.5px]" style={{ color: textDim, fontFamily: "'JetBrains Mono', monospace" }}>↗ LIVE</span>
            </div>
          </div>
        </article>
      ))}
    </div>

    {/* Dots + link "ver más" — mobile only */}
    <div class="md:hidden carousel-dots" data-dots-for="portfolio"></div>
    <div class="md:hidden flex justify-center mt-4">
      <button type="button" id="portfolio-show-all"
        class="text-[13px] font-medium underline underline-offset-4 decoration-1 transition-colors"
        style={`color:${textSoft}; text-decoration-color:rgba(43,182,115,0.5); font-family:'Inter', system-ui, sans-serif;`}>
        Ver los 5 proyectos restantes →
      </button>
    </div>
  </div>
</section>

<script>
  // Mobile: revelar el resto de proyectos al tocar "Ver más"
  const showBtn = document.getElementById('portfolio-show-all');
  if (showBtn) {
    showBtn.addEventListener('click', () => {
      document.querySelectorAll('.portfolio-extra').forEach(el => {
        el.classList.remove('hide-on-mobile');
      });
      showBtn.style.display = 'none';
      // Refrescar dots si existen
      const carousel = document.querySelector('.portfolio-grid') as HTMLElement;
      if (carousel) carousel.dispatchEvent(new Event('scroll'));
    });
  }
</script>

<style>
  /* Mobile carousel: edge-bleeding para que peek del próximo card sea visible */
  @media (max-width: 767px) {
    .portfolio-grid.mobile-carousel {
      padding-left: 24px;
      padding-right: 24px;
      margin-left: -24px;
      margin-right: -24px;
    }
  }
  /* Desktop: gap explícito (override del gap: revert global) */
  @media (min-width: 768px) {
    .portfolio-grid.mobile-carousel {
      gap: 28px;
    }
  }
  @media (min-width: 1024px) {
    .portfolio-grid.mobile-carousel {
      gap: 32px;
    }
  }
</style>
