---

<section id="portfolio" class="py-12 sm:py-32 bg-black relative overflow-hidden">
  <div class="absolute inset-0 opacity-10">
    <div class="absolute inset-0 bg-grid-pattern"></div>
  </div>

  <div class="container mx-auto px-3 sm:px-4 relative z-10">
    <div class="max-w-4xl mx-auto text-center mb-8 sm:mb-16">
      <h2 class="text-3xl sm:text-5xl font-heading text-white mb-3 sm:mb-6">
        Portfolio
      </h2>
      <p class="text-gray-300 text-sm sm:text-lg">
        Proyectos reales con resultados medibles para negocios argentinos
      </p>
    </div>

    <!-- Proyectos destacados - mobile -->
    <div class="md:hidden space-y-4">
      {featuredProjects.map((project) => (
        <ProjectCard project={project} variant="mobile" />
      ))}
    </div>

    <!-- Proyectos destacados - desktop -->
    <div class="hidden md:grid md:grid-cols-2 lg:grid-cols-3 gap-6 max-w-7xl mx-auto">
      {featuredProjects.map((project) => (
        <ProjectCard project={project} variant="desktop" />
      ))}
    </div>

    <!-- Más proyectos (expandible) -->
    <div id="more-projects" class="hidden mt-8">
      <div class="md:hidden space-y-4">
        {moreProjects.map((project) => (
          <ProjectCard project={project} variant="mobile" />
        ))}
      </div>

      <div class="hidden md:grid md:grid-cols-2 lg:grid-cols-3 gap-6 max-w-7xl mx-auto">
        {moreProjects.map((project) => (
          <ProjectCard project={project} variant="desktop" />
        ))}
      </div>
    </div>

    <div class="mt-10 sm:mt-14 text-center">
      <button 
        id="toggle-projects" 
        class="px-8 py-3 font-mono text-xs uppercase tracking-widest bg-white/5 text-white hover:bg-white/10 border border-white/10 hover:border-azure-radiance-400/40 transition-all duration-300 rounded-none"
      >
        Ver más proyectos
      </button>
    </div>
  </div>
</section>

<script>
  const toggleBtn = document.getElementById('toggle-projects');
  const moreProjects = document.getElementById('more-projects');
  if (toggleBtn && moreProjects) {
    toggleBtn.addEventListener('click', () => {
      const isHidden = moreProjects.classList.contains('hidden');
      if (isHidden) {
        moreProjects.classList.remove('hidden');
        toggleBtn.textContent = 'Ver menos proyectos';
      } else {
        moreProjects.classList.add('hidden');
        toggleBtn.textContent = 'Ver más proyectos';
      }
    });
  }
</script>

<style>
  .bg-grid-pattern {
    background-image: radial-gradient(circle at 1px 1px, rgba(255, 255, 255, 0.1) 1px, transparent 0);
    background-size: 40px 40px;
  }

  @media (prefers-reduced-motion: no-preference) {
    .bg-grid-pattern {
      animation: patternMove 20s linear infinite;
    }
  }

  @keyframes patternMove {
    from { transform: translateY(0); }
    to { transform: translateY(-40px); }
  }

  .line-clamp-2 {
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
</style>
