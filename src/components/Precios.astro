---

<section id="planes" class="py-12 sm:py-20 bg-black">
  <div class="container mx-auto px-3 sm:px-4">
    <h2 class="text-3xl sm:text-5xl font-heading text-center text-white mb-3 sm:mb-4">Planes y Precios</h2>
    <p class="text-center text-white/70 mb-8 sm:mb-12 max-w-2xl mx-auto text-sm sm:text-base">
      Todos los planes web incluyen dominio .com y hosting gratis por 1 año. Pago único, sin costos mensuales. Después, renovación anual a cargo del cliente.
    </p>

    <!-- Vista móvil: acordeón -->
    <div class="md:hidden space-y-3 max-w-lg mx-auto">
      {plans.map((plan) => (
        <PlanCard plan={plan} variant="mobile" />
      ))}
    </div>

    <!-- Vista desktop -->
    <div class="hidden md:block">
      <!-- Primera fila: 4 planes web -->
      <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-6 max-w-7xl mx-auto mb-8">
        {plans.slice(0, 4).map((plan) => (
          <PlanCard plan={plan} variant="desktop" />
        ))}
      </div>

      <!-- Segunda fila: 3 planes avanzados -->
      <div class="grid md:grid-cols-3 gap-6 max-w-5xl mx-auto">
        {plans.slice(4).map((plan) => (
          <PlanCard plan={plan} variant="advanced" />
        ))}
      </div>
    </div>

    <div class="mt-8 sm:mt-12 text-center space-y-2">
      <p class="text-white/80 text-xs sm:text-sm">
        Todos los precios están expresados en pesos argentinos (ARS). Pago único.
      </p>
      <p class="text-white/60 text-[10px]">
        Dominio .com incluido el primer año. Renovación anual a cargo del cliente. Los planes &quot;desde&quot; son precios de referencia según complejidad y alcance, se ajustan tras evaluar el proyecto.
      </p>
    </div>
  </div>
</section>

<script>
  document.querySelectorAll('.plan-toggle').forEach((btn) => {
    btn.addEventListener('click', () => {
      const wrapper = btn.nextElementSibling;
      if (!wrapper || !wrapper.classList.contains('plan-features-wrapper')) return;

      const isExpanded = wrapper.classList.toggle('expanded');
      btn.setAttribute('aria-expanded', String(isExpanded));
      
      const label = btn.querySelector('span');
      const chevron = btn.querySelector('.plan-chevron');
      
      if (label) label.textContent = isExpanded ? 'Ocultar detalles' : 'Ver detalles';
      if (chevron) chevron.style.transform = isExpanded ? 'rotate(180deg)' : '';
    });
  });
</script>

<style>
  /* Acordeón mobile */
  .plan-features-wrapper {
    display: grid;
    grid-template-rows: 0fr;
    transition: grid-template-rows 0.35s ease;
  }
  .plan-features-wrapper.expanded {
    grid-template-rows: 1fr;
  }
  .plan-features-inner {
    overflow: hidden;
  }

  @keyframes float {
    0% { transform: translateY(0px); }
    50% { transform: translateY(-10px); }
    100% { transform: translateY(0px); }
  }
</style>