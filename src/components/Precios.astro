---
import { whatsappLink } from '../lib/constants';
const planesWeb = [
  { t: 'Landing Page', price: '$250.000',
    features: ['Página única con scroll','Diseño web responsive','Formulario de contacto','Integración con redes sociales','Optimización para móviles','SEO básico on-page','Entrega lista para hostear'] },
  { t: 'Sitio Web Corporativo', price: '$350.000', sub: '3 a 5 páginas', featured: true,
    features: ['3 a 5 páginas personalizadas','Diseño responsive premium','Formulario avanzado','Galería de imágenes','Mapa de ubicación','Animaciones suaves','Entrega lista para hostear'] },
  { t: 'Sitio Web Extendido', price: '$450.000', sub: 'Más de 5 páginas',
    features: ['Más de 5 páginas personalizadas','Diseño premium único','Formularios avanzados','Galería multimedia','Optimización SEO completa','Animaciones suaves','Soporte post-lanzamiento'] },
  { t: 'Tienda E-commerce', price: '$1.300.000',
    features: ['Catálogo de productos ilimitado','Carrito + MercadoPago','Sistema de login','Panel de administración','Gestión de stock automática','Descuentos y promos','SEO y estadísticas de visitas'] },
];

const planesSistemas = [
  { t: 'Sistema a medida', price: '$1.200.000',
    features: ['Panel de administración','Usuarios con distintos permisos','Cargá, editá y buscá tus datos','Reportes y métricas','Tus datos guardados y respaldados','Se conecta con tus otras herramientas','Online y accesible desde cualquier lugar'] },
  { t: 'Chatbot con IA', price: '$1.500.000', featured: true,
    features: ['Bot inteligente con IA','Chats que venden 24/7','Panel con todas las conversaciones','Varios bots en un solo panel','Base de conocimiento','Integrado en tu web','Funcionando en un servidor dedicado'] },
  { t: 'App a medida', price: 'Consultar',
    features: ['App web o mobile','Hecha a la medida de tu operación','Tus datos guardados y respaldados','Autenticación de usuarios','Notificaciones push','Panel de administración','Soporte post-lanzamiento'] },
];
const groups = [
  { id: 'web', label: 'Webs', plans: planesWeb },
  { id: 'sistemas', label: 'Sistemas', plans: planesSistemas },
];
---
<section id="planes" class="section on-ice" aria-labelledby="planes-title">
  <div class="wrap">
    <header class="pricing-heading">
      <h2 id="planes-title" class="h2">Un precio. Una vez.</h2>
      <p class="lede">Pagás el desarrollo una sola vez: <strong>50% al inicio y 50% contra entrega</strong>. Hosting y dominio no están incluidos: los contratás aparte, a tu nombre. Te recomiendo Hostinger, con hosting de alrededor de <strong>AR$ 9.300/mes</strong>; el dominio se paga por separado. No me pagás una cuota mensual por el desarrollo y podés elegir tu proveedor: el sitio es tuyo desde el día uno.</p>
    </header>
    <div class="plan-tabs" role="tablist" aria-label="Tipo de proyecto">
      {groups.map((group, i) => <button type="button" id={`tab-${group.id}`} role="tab" aria-selected={i === 0 ? 'true' : 'false'} aria-controls={`plans-${group.id}`} tabindex={i === 0 ? 0 : -1}>{group.label}</button>)}
    </div>
  </div>
  {groups.map((group, i) => (
    <div id={`plans-${group.id}`} role="tabpanel" aria-labelledby={`tab-${group.id}`} hidden={i !== 0} tabindex="0" class="plan-panel">
      <div class="specs snap-row" style={`--plan-count:${group.plans.length}`}>
        {group.plans.map(p => (
          <article class:list={['spec-column', { 'is-featured': p.featured }]}>
            <h3>{p.t}</h3>
            <p class="plan-price"><span class="dot-num">{p.price}</span>{p.price !== 'Consultar' && <span class="mono">ARS</span>}</p>
            <p class="mono plan-sub">{p.sub ?? ""}</p>
            <ul>{p.features.map(feature => <li>{feature}</li>)}</ul>
            <a class={`btn ${p.featured ? 'btn-primary' : 'btn-ghost'}`} href={whatsappLink(`¡Hola Christian! Me interesa el plan ${p.t}. ¿Me pasás más info?`)} target="_blank" rel="noopener noreferrer">{p.featured ? 'Iniciar pedido' : 'Solicitar presupuesto'}</a>
          </article>
        ))}
      </div>
    </div>
  ))}
</section>
<script>
  const tabs = Array.from(document.querySelectorAll<HTMLButtonElement>('#planes [role="tab"]'));
  function activateTab(index: number, focus = false) {
    tabs.forEach((tab, i) => {
      tab.setAttribute('aria-selected', String(i === index));
      tab.tabIndex = i === index ? 0 : -1;
      const panel = document.getElementById(tab.getAttribute('aria-controls')!);
      if (panel) panel.hidden = i !== index;
    });
    if (focus) tabs[index].focus();
    window.dispatchEvent(new Event('resize'));
  }
  tabs.forEach((tab, i) => {
    tab.addEventListener('click', () => activateTab(i));
    tab.addEventListener('keydown', event => {
      let next = i;
      if (event.key === 'ArrowRight') next = (i + 1) % tabs.length;
      else if (event.key === 'ArrowLeft') next = (i - 1 + tabs.length) % tabs.length;
      else if (event.key === 'Home') next = 0;
      else if (event.key === 'End') next = tabs.length - 1;
      else return;
      event.preventDefault(); activateTab(next, true);
    });
  });
</script>
<style>
  #planes { position: relative; isolation: isolate; }
  @media (min-width: 1024px) { .pricing-heading { padding-right: 200px; min-height: 400px; } }
  .pricing-heading { max-width: 1050px; margin-bottom: 36px; }
  .pricing-heading h2 { margin: 0 0 24px; }
  .pricing-heading p { color: var(--on-ice-soft); }
  .plan-tabs { display: inline-flex; border: 1px solid var(--line-ice-strong); margin-bottom: 40px; }
  .plan-tabs button { border-radius: 0; padding: 14px 28px; font-weight: 700; color: var(--on-ice); }
  .plan-tabs button[aria-selected="true"] { background: var(--petrol); color: var(--ice); }
  .plan-tabs button:hover { text-decoration: underline; text-underline-offset: 4px; }
  .plan-panel[hidden] { display: none; }
  .specs { gap: 0; }
  .spec-column { position: relative; width: 84vw; display: flex; flex-direction: column; padding: 88px 24px 12px; border-left: 1px solid var(--line-ice-strong); min-width: 0; }
  .spec-column:last-child { border-right: 1px solid var(--line-ice-strong); }
  .spec-column h3 { font-family: var(--font-display); font-size: var(--fs-title); font-weight: 700; line-height: 1.15; min-height: 51px; margin: 0 0 24px; }
  .plan-price { display: flex; flex-wrap: wrap; align-items: baseline; gap: 8px; margin: 0 0 12px; }
  .plan-price .dot-num { font-size: var(--fs-price-mobile); letter-spacing: -.02em; white-space: nowrap; }
  .plan-sub { color: var(--on-ice-soft); min-height: 34px; margin-bottom: 20px; }
  .spec-column ul { list-style: none; padding: 0; margin: 0 0 28px; flex: 1; }
  .spec-column li { font-size: var(--fs-small); line-height: 1.45; padding: 12px 0; border-top: 1px solid var(--line-ice); }
  .spec-column .btn { padding-inline: 12px; width: 100%; }
  @media (min-width: 768px) {
    .specs { display: grid; grid-template-columns: repeat(var(--plan-count), minmax(0, 1fr)); max-width: var(--maxw); margin-inline: auto; overflow: visible; }
    .spec-column { width: auto; padding-inline: clamp(12px, 1.8vw, 24px); }
    .plan-price .dot-num { font-size: var(--fs-price); }
  }
</style>
