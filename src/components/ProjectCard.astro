---
import { ExternalLink } from 'lucide-react';

export interface Project {
  title: string;
  description: string;
  image: string;
  url: string;
  tags: string[];
  resultado: string;
  enConstruccion?: boolean;
}

interface Props {
  project: Project;
  variant?: 'mobile' | 'desktop';
}

const { project, variant = 'desktop' } = Astro.props;
const isDesktop = variant === 'desktop';
---

{isDesktop ? (
  <div class="group relative">
    <div class="overflow-hidden border border-white/[0.06] transition-all duration-500 hover:border-white/10 h-full bg-black">
      <div class="relative aspect-[16/9] overflow-hidden">
        <img 
          src={project.image} 
          alt={`Captura del proyecto ${project.title}`} 
          class="w-full h-full object-cover transform group-hover:scale-105 transition-transform duration-500"
          loading="lazy"
        />
        <div class="absolute inset-0 bg-black/20 opacity-0 group-hover:opacity-100 transition-all duration-300 flex items-center justify-center">
          <a 
            href={project.url} 
            target="_blank" 
            rel="noopener noreferrer"
            class="flex items-center gap-2 bg-white/10 hover:bg-white/20 px-5 py-2 rounded-none backdrop-blur-sm transition-all duration-300 border border-white/20"
          >
            <ExternalLink className="w-4 h-4 text-white" />
            <span class="text-xs text-white uppercase tracking-widest">Visitar</span>
          </a>
        </div>
      </div>
      <div class="p-4 relative">
        <div class="flex justify-between items-start mb-1 gap-2">
          <h3 class="text-sm font-bold text-white group-hover:text-azure-radiance-400 transition-colors duration-300 uppercase font-heading truncate">{project.title}</h3>
          {project.enConstruccion && (
            <span class="text-[10px] px-2 py-0.5 bg-ai-violet-500 text-white font-mono uppercase shrink-0">En construcción</span>
          )}
        </div>
        <p class="text-gray-400 text-[11px] mb-2 line-clamp-2 leading-relaxed">{project.description}</p>
        <p class="text-white/50 text-[11px] font-mono mb-3 uppercase tracking-tight">{project.resultado}</p>
        <div class="flex flex-wrap gap-1.5">
          {project.tags.map((tag) => (
            <span class="text-[10px] px-2 py-0.5 bg-azure-radiance-500/5 text-azure-radiance-400 border border-azure-radiance-500/10 font-mono">{tag}</span>
          ))}
        </div>
      </div>
    </div>
  </div>
) : (
  <div class="group relative overflow-hidden border border-white/[0.06] bg-black">
    <div class="relative aspect-[16/9] overflow-hidden">
      <img 
        src={project.image} 
        alt={`Captura del proyecto ${project.title}`} 
        class="w-full h-full object-cover"
        loading="lazy"
      />
      <div class="absolute inset-0 bg-black/20 opacity-0 group-hover:opacity-100 transition-all duration-300 flex items-center justify-center">
        <a 
          href={project.url} 
          target="_blank" 
          rel="noopener noreferrer"
          class="flex items-center gap-2 bg-white/10 hover:bg-white/20 px-4 py-1.5 rounded-none backdrop-blur-sm border border-white/20"
        >
          <ExternalLink className="w-4 h-4 text-white" />
          <span class="text-xs text-white uppercase tracking-widest">Visitar</span>
        </a>
      </div>
    </div>
    <div class="p-4">
      <div class="flex justify-between items-start gap-2 mb-1">
        <h3 class="text-sm font-bold text-white mb-1 uppercase font-heading truncate">{project.title}</h3>
        {project.enConstruccion && (
          <span class="text-[10px] px-2 py-0.5 bg-ai-violet-500 text-white font-mono uppercase shrink-0">En construcción</span>
        )}
      </div>
      <p class="text-gray-400 text-[11px] mb-2">{project.description}</p>
      <p class="text-white/50 text-[11px] font-mono mb-3 uppercase tracking-tight">{project.resultado}</p>
      <div class="flex flex-wrap gap-1.5">
        {project.tags.map((tag) => (
          <span class="text-[10px] px-2 py-0.5 bg-azure-radiance-500/5 text-azure-radiance-400 border border-azure-radiance-500/10 font-mono">{tag}</span>
        ))}
      </div>
    </div>
  </div>
)}
