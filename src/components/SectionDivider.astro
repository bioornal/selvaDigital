---
interface Props {
  gap?: 'sm' | 'md' | 'lg';
}
const { gap = 'sm' } = Astro.props;
const padding = { sm: '0px', md: '40px', lg: '64px' }[gap];
---

<div class="section-divider" aria-hidden="true" style={`padding-top:${padding}; padding-bottom:${padding};`}>
  <div class="divider-line"></div>
</div>

<style>
  .section-divider {
    width: 100%;
    background: #0A0B0D;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .divider-line {
    width: 100%;
    height: 1px;
    background: linear-gradient(
      to right,
      transparent 0%,
      rgba(250, 250, 250, 0.06) 20%,
      rgba(0, 229, 255, 0.5) 50%,
      rgba(250, 250, 250, 0.06) 80%,
      transparent 100%
    );
  }
</style>
