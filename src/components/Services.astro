---
import { Code2, Globe, Rocket, Wrench, Bot, Zap, ShieldCheck } from 'lucide-react';

const services = [
  { icon: Code2, title: "WEB" },
  { icon: Globe, title: "ECOMMERCE" },
  { icon: Rocket, title: "PÁGINAS" },
  { icon: Wrench, title: "SISTEMAS" },
  { icon: Bot, title: "CHATBOTS" },
];

const steps = [
  { id: "01", title: "HABLÁMOS", desc: "Entiendo tu negocio." },
  { id: "02", title: "PLAN", desc: "Costos y tiempos claros." },
  { id: "03", title: "AVANCES", desc: "Te muestro cada semana." },
  { id: "04", title: "LISTO", desc: "Tu web lista para vender." }
];
---

<section id="sobre-nosotros" class="py-16 sm:py-20 bg-black relative overflow-hidden">
  <div class="absolute inset-0 opacity-5 pointer-events-none"
       style="background-image: linear-gradient(#3b82f6 1px, transparent 1px), linear-gradient(90deg, #3b82f6 1px, transparent 1px); background-size: 50px 50px;">
  </div>

  <div class="container mx-auto px-4 sm:px-6 relative z-10">
    <div class="max-w-4xl mx-auto">
      <!-- Header -->
      <div class="flex items-center gap-4 mb-8">
        <img
          src="https://res.cloudinary.com/djtvjkcu6/image/upload/v1778507882/SelvaDigital/yo_perfil_ekrrxc.jpg"
          alt="Perfil"
          class="w-20 h-20 rounded-none object-cover border-2 border-white/20"
        />
        <div>
          <h2 class="text-2xl sm:text-4xl font-heading glow-text leading-tight text-white uppercase">
            Sobre mí
          </h2>
          <span class="text-[10px] font-mono text-emerald-400 animate-pulse">● Online</span>
        </div>
      </div>

      <!-- Bio -->
      <div class="space-y-4 text-gray-400 text-sm leading-relaxed mb-10">
        <p>
          Ayudo a <span class="text-white font-medium">dueños de negocios y PyMEs</span> a vender más. Diseño <span class="text-violet-400">páginas web personalizadas</span> que atraen clientes las 24 horas.
        </p>
      </div>

      <!-- Services Grid -->
      <div class="grid grid-cols-3 sm:grid-cols-5 gap-2 sm:gap-3 mb-10">
        {services.map((service) => (
          <div class="flex flex-col items-center gap-1 p-2 sm:p-3 bg-white/5 border border-white/10 rounded-none group hover:border-violet-500/50 transition-colors">
            <service.icon className="w-4 h-4 sm:w-5 sm:h-5 text-gray-500 group-hover:text-violet-400 transition-colors" />
            <span class="text-[9px] sm:text-[10px] font-mono text-gray-500 group-hover:text-white transition-colors">{service.title}</span>
          </div>
        ))}
      </div>

      <!-- Workflow - Simple Steps -->
      <div class="grid grid-cols-2 sm:grid-cols-4 gap-4">
        {steps.map((step, i) => (
          <div class="text-center p-4 bg-white/5 border border-white/10 rounded-none">
            <span class="text-2xl font-heading text-violet-400">{step.id}</span>
            <p class="text-xs font-bold text-white uppercase mt-2">{step.title}</p>
            <p class="text-[10px] text-gray-500 mt-1">{step.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  .font-heading {
    font-family: 'Nova Square', sans-serif;
  }
</style>