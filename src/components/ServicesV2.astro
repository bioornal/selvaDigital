---
import { ArrowUpRight, Check, ChevronDown } from 'lucide-react';
import ChatPreview from './ChatPreview';

const services = [
  {
    t: 'Sitios web',
    d: 'Si tu negocio no aparece en Google, no existe. Te armo un sitio rápido, pensado para que te encuentren en tu zona y te escriban por WhatsApp.',
    bullets: ['SEO local configurado desde el lanzamiento', 'Diseñado para que te llamen, no para verse lindo', 'Ficha y contenido pensados para tu zona'],
  },
  {
    t: 'Tienda online',
    d: '¿Cuántas ventas perdés porque tus clientes te tienen que escribir, esperar respuesta y coordinar pago? Tu tienda online les cobra sola, 24/7, mientras vos te dedicás a producir.',
    bullets: ['Cobrás aunque estés cerrado', 'Stock y pedidos en un solo panel', 'Cada cliente paga directo, sin idas y vueltas'],
  },
  {
    t: 'Sistemas a medida',
    d: '¿Cuántas horas perdés por semana copiando datos entre Excels, WhatsApp y libretas? Un sistema a medida ordena tu operativa en un solo lugar — y deja de depender de tu memoria.',
    bullets: ['Dejá de buscar info por 5 lugares distintos', 'Sabés en tiempo real cómo va el negocio', 'Tu equipo trabaja con la misma información'],
  },
  {
    t: 'SEO local',
    d: 'Para que cuando alguien busque tu rubro en tu zona, te encuentren a vos. Más visitas sin pagar publicidad, mes a mes.',
    bullets: ['Te encuentran cuando te buscan', 'Visitas gratis que no dependen de Ads', 'Resultados que crecen con el tiempo'],
  },
  {
    t: 'Apps a medida',
    d: 'Aplicaciones completas hechas a tu medida, con panel de administración y tus datos guardados y respaldados. Desde un sistema interno hasta una app para tus clientes.',
    bullets: ['Hecha a la medida de cómo trabajás', 'Acceso seguro con permisos por usuario', 'Notificaciones push en tiempo real', 'Apps web y móviles'],
  },
];
const features = [
  { title: 'Vende mientras dormís', desc: 'El chat de tu web toma pedidos y confirma datos. Cuando volvés, tenés las consultas listas para cerrar.' },
  { title: 'Conoce tu negocio', desc: 'Cargás tu catálogo, precios y políticas para que el asistente de tu web responda con la información de tu negocio.' },
  { title: 'Atiende a toda hora', desc: 'Quien entra a tu web puede consultar de noche, los domingos o feriados. El chat responde aunque vos estés descansando.' },
  { title: 'Sabés cuánto vendiste', desc: 'Desde un solo panel ves qué consultas del chat de tu web se convirtieron en ventas y dónde se quedaron en el camino.' },
];
const LIVE_BOT_URL = 'https://www.impastopizzas.com/';
---

<section id="servicios" class="section on-ice" aria-labelledby="services-title">
  <div class="wrap">
    <header class="services-heading">
      <h2 id="services-title" class="h2">Lo que hago por tu negocio.</h2>
      <p class="lede">Desarrollo tu web y ordeno las herramientas de tu negocio para que vendas y trabajes mejor.</p>
    </header>

    <div class="services-list">
    <div class="services-desktop">
      {services.map(s => (
        <article class="service-row">
          <div class="service-label">
            <h3 class="service-name">{s.t}</h3>
          </div>
          <p class="service-desc">{s.d}</p>
          <div class="service-spec">
            <ul class="service-bullets">
              {s.bullets.map(b => <li><Check size={14} strokeWidth={1.5} aria-hidden="true" /><span>{b}</span></li>)}
            </ul>
          </div>
        </article>
      ))}
    </div>

    <div class="services-mobile">
      {services.map((s, i) => (
        <details class="service-disclosure" open={i === 0}>
          <summary>
            <span class="service-label">
              <span class="service-name">{s.t}</span>
            </span>
            <ChevronDown className="service-chevron" size={20} strokeWidth={1.5} aria-hidden="true" />
          </summary>
          <div class="service-content">
            <p class="service-desc">{s.d}</p>
            <ul class="service-bullets">
              {s.bullets.map(b => <li><Check size={14} strokeWidth={1.5} aria-hidden="true" /><span>{b}</span></li>)}
            </ul>
          </div>
        </details>
      ))}
    </div>

    <div class="services-closing">
      <a class="btn btn-petrol rounded-none" href="#planes">Ver precios</a>
    </div>
    </div>

    <article class="chatbot-panel on-petrol" aria-labelledby="service-chatbot-title">
      <div class="chatbot-copy">
        <h3 id="service-chatbot-title" class="h3">Chatbot con IA para tu web</h3>
        <p class="lede">Sumá un asistente a tu web que responde consultas, toma pedidos y los deja listos para confirmar.</p>
        <details class="chatbot-details">
          <summary>Qué hace el asistente</summary>
          <dl class="chatbot-features">
            {features.map(f => (
              <div class="chatbot-feature">
                <dt>{f.title}</dt>
                <dd>{f.desc}</dd>
              </div>
            ))}
          </dl>
        </details>
        <div class="chatbot-actions">
          <a class="btn btn-primary rounded-none" href={LIVE_BOT_URL} target="_blank" rel="noopener noreferrer">Probalo en Impasto <ArrowUpRight size={18} strokeWidth={1.5} aria-hidden="true" /></a>
        </div>
      </div>
      <div class="chatbot-preview"><ChatPreview client:visible /></div>
    </article>

  </div>
</section>

<style>
  .services-heading { margin-bottom: clamp(40px, 6vw, 80px); }
  .services-heading .h2 { margin: 0 0 24px; }
  .services-heading .lede { color: var(--on-ice-soft); }
  .services-heading .lede { margin: 0; }
  .chatbot-panel { display: grid; gap: 32px; padding: clamp(24px, 3vw, 40px); margin-top: clamp(48px, 6vw, 80px); border-radius: 0; }
  .chatbot-copy { min-width: 0; }
  .chatbot-copy .h3 { margin: 0 0 16px; font-size: var(--fs-quote); }
  .chatbot-details summary { cursor: pointer; padding-block: 16px; font-size: var(--fs-control); }
  .chatbot-details summary:focus-visible { outline-color: var(--lime); }
  .chatbot-copy .lede { margin: 0 0 24px; font-size: var(--fs-control); color: var(--on-petrol-soft); }
  .chatbot-features { display: grid; margin: 0; gap: 0 24px; }
  .chatbot-feature { border-top: 1px solid var(--line-petrol-strong); padding: 18px 0; }
  .chatbot-feature dt { margin-bottom: 8px; font-size: var(--fs-body); font-weight: 700; line-height: 1.25; }
  .chatbot-feature dd { margin: 0; font-size: var(--fs-small); line-height: 1.55; color: var(--on-petrol-soft); }
  .chatbot-actions { display: flex; flex-wrap: wrap; gap: 14px; margin-top: 16px; }
  .chatbot-actions .btn { max-width: 100%; padding: 14px 18px; }
  .chatbot-panel .btn-ghost { color: var(--on-petrol); box-shadow: inset 0 0 0 1px var(--line-petrol-strong); }
  .chatbot-panel .btn-ghost:hover { box-shadow: inset 0 0 0 1px var(--on-petrol); }
  .chatbot-panel a:focus-visible { outline-color: var(--lime); }
  .chatbot-preview { display: none; min-width: 0; }
  .services-desktop { display: none; }
  @media (min-width: 768px) {
    .chatbot-features { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  .service-disclosure, .service-row { border-top: 1px solid var(--line-ice-strong); }
  .service-disclosure summary { display: grid; grid-template-columns: minmax(0, 1fr) 20px; align-items: center; gap: 12px; padding: 20px 0; cursor: pointer; list-style: none; }
  .service-disclosure summary::-webkit-details-marker { display: none; }
  .service-label { display: grid; gap: 12px; min-width: 0; }
  .service-name { margin: 0; font-family: var(--font-display); font-size: var(--fs-service); font-weight: 800; font-variation-settings: 'wdth' 110; line-height: 1.05; letter-spacing: -0.025em; overflow-wrap: break-word; }
  .service-disclosure[open] :global(.service-chevron) { transform: rotate(180deg); }
  .service-desc { margin: 0; font-size: var(--fs-control); line-height: 1.55; color: var(--on-ice-soft); }
  .service-content { display: grid; gap: 18px; padding-bottom: 24px; }
  .service-bullets { display: flex; flex-direction: column; gap: 8px; padding: 0; margin: 0; list-style: none; font-size: var(--fs-small); line-height: 1.45; }
  .service-bullets li { display: flex; align-items: flex-start; gap: 10px; }
  .service-bullets :global(svg) { flex-shrink: 0; margin-top: 4px; }
  .services-closing { border-top: 1px solid var(--line-ice-strong); padding-top: 36px; }
  @media (min-width: 1024px) {
    .chatbot-panel { grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr); align-items: start; gap: clamp(24px, 3vw, 48px); }
    .chatbot-preview { display: block; }
    .services-mobile { display: none; }
    .services-desktop { display: block; }
    .service-row { display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); column-gap: 28px; padding-block: 28px 32px; align-items: start; }
    .service-label { grid-column: span 4; }
    .service-name { font-size: var(--fs-feature); }
    .service-desc { grid-column: span 4; }
    .service-spec { grid-column: span 4; min-width: 0; }
  }
</style>

<script>
  const chatbotDetails = document.querySelector<HTMLDetailsElement>('.chatbot-details');
  const desktopChatbot = window.matchMedia('(min-width: 1024px)');
  const syncChatbotDetails = () => { if (chatbotDetails) chatbotDetails.open = desktopChatbot.matches; };
  syncChatbotDetails();
  desktopChatbot.addEventListener('change', syncChatbotDetails);
</script>
