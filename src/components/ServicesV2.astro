---
const accent = '#2BB673';
const bg = '#0A0B0D';
const surface = '#121316';
const white = '#FAFAFA';
const textSoft = 'rgba(250,250,250,0.72)';
const textDim = 'rgba(250,250,250,0.46)';
const line = 'rgba(250,250,250,0.08)';
const lineStr = 'rgba(250,250,250,0.18)';

const services = [
  {
    n: '01', t: 'Sitios web',
    d: 'Si tu negocio no aparece en Google, no existe. Te dejo arriba de la competencia local con un sitio que carga rápido y convierte al visitante en una consulta directa por WhatsApp.',
    bullets: ['Primera consulta orgánica en 30-60 días', 'Diseñado para que te llamen, no para verse lindo', 'Tu marca arriba de la competencia local'],
    cta: 'Desde $350 USD',
    featured: true
  },
  {
    n: '02', t: 'E-commerce',
    d: '¿Cuántas ventas perdés porque tus clientes te tienen que escribir, esperar respuesta y coordinar pago? Tu tienda online les cobra sola, 24/7, mientras vos te dedicás a producir.',
    bullets: ['Cobrás aunque estés cerrado', 'Stock y pedidos en un solo panel', 'Cada cliente paga directo, sin idas y vueltas'],
    cta: 'Desde $1.200 USD'
  },
  {
    n: '03', t: 'Sistemas a medida',
    d: '¿Cuántas horas perdés por semana copiando datos entre Excels, WhatsApp y libretas? Un sistema a medida ordena tu operativa en un solo lugar — y deja de depender de tu memoria.',
    bullets: ['Dejá de buscar info por 5 lugares distintos', 'Sabés en tiempo real cómo va el negocio', 'Tu equipo trabaja con la misma información'],
    cta: 'Desde $1.500 USD'
  },
  {
    n: '04', t: 'Chatbots con IA',
    d: '¿Cuántas consultas perdés a la noche, los domingos o cuando estás atendiendo? El bot responde por vos, toma el pedido y te lo deja listo para confirmar. Cada conversación que no se cae es plata que no se va.',
    bullets: ['Atiende mientras dormís', 'No deja una consulta sin respuesta', 'Manejá varios negocios desde un solo panel'],
    cta: 'Desde $1.500 USD'
  },
  {
    n: '05', t: 'SEO local',
    d: 'Para que cuando alguien busque tu rubro en tu zona, aparezcas vos primero — no tu competencia. Más visitas sin pagar publicidad, mes a mes.',
    bullets: ['Te encuentran cuando te buscan', 'Visitas gratis que no dependen de Ads', 'Resultados que crecen con el tiempo'],
    cta: 'Incluido en planes'
  },
];
---

<section id="servicios" class="services-section relative" style={`background:${bg};`}>
  {/* Dot grid */}
  <div class="absolute inset-0 pointer-events-none opacity-[0.15]"
    style="background-image:radial-gradient(circle at 1px 1px, rgba(255,255,255,0.06) 1px, transparent 0); background-size:28px 28px;">
  </div>

  <div class="relative z-10 max-w-[1320px] mx-auto px-6 md:px-10">
    {/* Header */}
    <div class="services-header grid md:grid-cols-2 items-end reveal reveal-slide-up">
      <div class="text-center md:text-left">
        <div class="inline-flex items-center gap-2.5 services-kicker">
          <span class="w-3.5 h-px" style={{ background: accent }}></span>
          <span class="text-[11px] tracking-[2.5px] uppercase" style={{ color: accent, fontFamily: "'JetBrains Mono', monospace" }}>
            01 ─── Servicios
          </span>
        </div>
        <h2 class="section-h2 services-h2 text-white mx-auto md:mx-0">
          Tu competencia ya está online.<br><span style={{ color: accent }}>Vos todavía no.</span>
        </h2>
        <p class="section-sub services-sub max-w-[620px] mx-auto md:mx-0" style={{ color: textSoft }}>
          Cinco formas concretas de dejar de perder ventas, recuperar horas de tu semana y poner tu negocio adelante en Google.
        </p>
      </div>
      <div class="hidden md:flex justify-end items-start">
        <span class="text-[11px] tracking-[2px] leading-relaxed" style={{ color: textDim, fontFamily: "'JetBrains Mono', monospace" }}>
          ┌── ALCANCE ──────┐<br/>
          │ Argentina       │<br/>
          └─────────────────┘
        </span>
      </div>
    </div>

    {/* Cards grid — mobile-carousel utility hace swipe horizontal; en md+ vuelve a grid */}
    <div class="services-grid mobile-carousel md:grid-cols-2 lg:grid-cols-5" data-dots="services">
      {services.map((s, i) => {
        const delays = ['delay-75', 'delay-150', 'delay-200', 'delay-250', 'delay-300'];
        return (
          <div class={`service-card flex flex-col p-6 md:p-8 relative spotlight-card reveal reveal-slide-up ${delays[i]}`} style={{
            background: s.featured ? 'rgba(43,182,115,0.06)' : surface,
            minHeight: '360px'
          }}>
            {s.featured && (
              <span class="absolute top-3.5 right-3.5 text-[9px] tracking-[1.5px] uppercase px-2 py-1"
                style={{
                  color: accent,
                  background: 'rgba(43,182,115,0.14)',
                  border: `1px solid rgba(43,182,115,0.5)`,
                  fontFamily: "'JetBrains Mono', monospace",
                  borderRadius: '999px'
                }}>
                ★ POPULAR
              </span>
            )}

            <div class="text-[11px] tracking-[2px] mb-4" style={{
              color: s.featured ? accent : textDim,
              fontFamily: "'JetBrains Mono', monospace"
            }}>
              {s.n}
            </div>

            <h3 class="services-card-h3 text-white">
              {s.t}
            </h3>

            <p class="text-[13.5px] leading-relaxed mb-5" style={{ color: textSoft, fontFamily: "'Inter', system-ui, sans-serif" }}>
              {s.d}
            </p>

            <ul class="flex flex-col gap-2 mb-7 list-none p-0">
              {s.bullets.map(b => (
                <li class="flex items-start gap-2 text-[12.5px] leading-snug" style={{ color: textSoft, fontFamily: "'Inter', system-ui, sans-serif" }}>
                  <span style={{ color: accent, marginTop: '2px' }}>▸</span>
                  {b}
                </li>
              ))}
            </ul>

            <div class="mt-auto pt-4 flex justify-between items-center" style={{ borderTop: `1px solid ${line}` }}>
              <span class="text-xs font-semibold text-white" style={{ fontFamily: "'Inter', system-ui, sans-serif" }}>
                {s.cta}
              </span>
              <span class="text-[10px]" style={{ color: s.featured ? accent : textDim, fontFamily: "'JetBrains Mono', monospace" }}>
                →
              </span>
            </div>
          </div>
        );
      })}
    </div>

    {/* Dots — mobile only */}
    <div class="md:hidden carousel-dots" data-dots-for="services"></div>
  </div>
</section>

<style>
  /* Servicios — scoped overrides con !important para vencer global.css y Tailwind base */
  .services-section {
    padding: clamp(80px, 10vh, 120px) 0 clamp(70px, 9vh, 100px) 0 !important;
  }

  .services-header {
    gap: 32px !important;
    margin-bottom: 40px !important;
    grid-template-columns: 1fr !important;
  }

  @media (min-width: 768px) {
    .services-header {
      gap: 60px !important;
      margin-bottom: 64px !important;
      grid-template-columns: 1fr 1fr !important;
    }
  }

  .services-kicker {
    margin-bottom: 18px !important;
  }

  .services-h2 {
    font-family: 'Geist', 'Inter', system-ui, sans-serif !important;
    font-weight: 600 !important;
    font-size: clamp(34px, 7vw, 60px) !important;
    line-height: 0.98 !important;
    letter-spacing: -0.03em !important;
    margin: 0 0 18px 0 !important;
    max-width: 100%;
    overflow-wrap: break-word;
  }

  @media (min-width: 768px) {
    .services-h2 {
      font-size: clamp(44px, 4.5vw, 60px) !important;
      line-height: 0.95 !important;
      max-width: 14ch !important;
    }
  }

  .services-sub {
    font-family: 'Inter', system-ui, sans-serif !important;
    font-size: 15px !important;
    line-height: 1.55 !important;
    margin: 0 !important;
  }

  @media (min-width: 768px) {
    .services-sub {
      font-size: 17px !important;
    }
  }

  .services-grid {
    gap: 0 !important;
  }

  .services-card-h3 {
    font-family: 'Geist', 'Inter', system-ui, sans-serif !important;
    font-weight: 600 !important;
    font-size: 22px !important;
    line-height: 1.15 !important;
    letter-spacing: -0.01em !important;
    margin: 0 0 12px 0 !important;
  }

  /* === Mobile: services-grid usa .mobile-carousel ===
     Cada card ocupa 85% del viewport (peek del siguiente).
     Borde + radius individual ya que el grid container no clipea. */
  @media (max-width: 767px) {
    .services-grid.mobile-carousel {
      padding-left: 24px;
      padding-right: 24px;
      margin-left: -24px;
      margin-right: -24px;
    }
    .service-card {
      width: 85%;
      flex-basis: 85%;
      min-width: 0;
      max-width: 85%;
      border: 1px solid rgba(250,250,250,0.08);
      border-radius: 14px;
    }
  }

  /* === md+: vuelve a grid con borders compartidos como el original === */
  @media (min-width: 768px) {
    .services-grid {
      gap: 0 !important;
      border: 1px solid rgba(250,250,250,0.08);
      border-radius: 14px;
      overflow: hidden;
    }
    /* Borders entre cards en grid de 2 cols (md) y 5 cols (lg) */
    .service-card:not(:last-child) {
      border-right: 1px solid rgba(250,250,250,0.08);
    }
  }
  /* En md (2 cols), el último de cada fila no debe tener border-right */
  @media (min-width: 768px) and (max-width: 1023px) {
    .service-card:nth-child(2n) {
      border-right: none;
    }
    .service-card:not(:nth-last-child(-n+2)) {
      border-bottom: 1px solid rgba(250,250,250,0.08);
    }
  }
</style>
