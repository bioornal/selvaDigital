---
// TODO(usuario): verificar testimonios y KPIs antes de publicar
const testimonials = [
  {
    quote: "Veníamos vendiendo puerta a puerta hace años. Christian nos armó la web y al tiempo empezaron a entrar consultas por Google, gente que ni nos conocía. Cambió la forma de laburar.",
    name: 'Hugo Pérez',
    role: 'Dueño · MegaMuebles',
  },
  {
    quote: "Antes todo iba por Booking y nos llevaban la mitad. Ahora la gente reserva directo desde la web. La galería les termina de convencer antes de escribir.",
    name: 'Ana Molina',
    role: 'Dueña · Iguazú Falls Lodge',
  },
  {
    quote: "Le tiré la idea de los combos un viernes y el sábado ya estaban andando en la web cobrando con MercadoPago. Te responde y resuelve, no te marea.",
    name: 'Lucas Sosa',
    role: 'Dueño · El Fogón',
  },
  {
    quote: "Llevar las redes de varias marcas era un dolor de cabeza diario. Christian me armó un dashboard propio con IA que genera copys y diseña las placas en segundos respetando la identidad de cada cliente. Reduje a la mitad el tiempo de planificación.",
    name: 'Julieta Gómez',
    role: 'Brand Manager · Social Core',
  },
  {
    quote: "Teníamos un quilombo hermoso con el stock de las sucursales, vendíamos cosas que ya no quedaban en el galpón y los vendedores se querían matar. Christian nos diseñó un sistema a medida que se actualiza al segundo. Ahora controlo todo desde el celular sin llamar a nadie.",
    name: 'Mariano Ferrero',
    role: 'Socio · MegaStock',
  },
  {
    quote: "Queríamos lanzar la pre-venta de las pizzas congeladas premium y no sabíamos cómo organizarnos. Christian nos preparó una landing súper estética con un sistema de combos interactivo. La gente elige y paga en dos clicks. En el primer finde de pre-orden superamos el cupo mensual.",
    name: 'Sofía Bianchi',
    role: 'Creadora · Impasto Pizzería',
  }
];
---

<section id="testimonios" class="section on-petrol" aria-labelledby="testimonios-title">
  <div class="wrap">
    <header class="testimonials-heading">
      <h2 id="testimonios-title" class="h2">Lo que dicen ellos.</h2>
    </header>
    {testimonials.slice(0, 1).map(t => (
      <figure class="testimonial-featured">
        <blockquote>“{t.quote}”</blockquote>
        <figcaption>
          <div class="testimonial-person">
            <div><p class="testimonial-name">{t.name}</p><p class="mono testimonial-role">{t.role}</p></div>
          </div>
        </figcaption>
      </figure>
    ))}
  </div>
  <div class="testimonials-secondary snap-row" role="region" aria-label="Más testimonios" tabindex="0">
    {testimonials.slice(1).map(t => (
      <figure class="testimonial">
        <blockquote>“{t.quote}”</blockquote>
        <figcaption>
          <div class="testimonial-person">
            <div><p class="testimonial-name">{t.name}</p><p class="mono testimonial-role">{t.role}</p></div>
          </div>
        </figcaption>
      </figure>
    ))}
  </div>
</section>

<style>
  #testimonios { position: relative; isolation: isolate; }
  @media (min-width: 1024px) {
    /* Reserve the right edge for the accent before the secondary quotes begin. */
    .testimonial-featured { min-height: 0; }
  }
  .testimonials-heading { margin-bottom: clamp(40px, 5vw, 72px); }
  .testimonials-heading .h2 { margin: 0 0 24px; }
  .testimonial-featured { margin: 0 0 40px; padding-block: 32px; border-top: 1px solid var(--line-petrol); border-bottom: 1px solid var(--line-petrol); }
  blockquote { margin: 0; color: var(--ice); }
  .testimonial-featured blockquote { max-width: 28ch; margin-bottom: 28px; font-family: var(--font-display); font-size: var(--fs-quote); font-weight: 500; line-height: 1.25; letter-spacing: -0.02em; }
  .testimonial-person { display: flex; align-items: center; gap: 12px; }
  .testimonial-person > div { min-width: 0; }
  .testimonial-name { margin: 0; color: var(--ice); font-size: var(--fs-small); font-weight: 700; }
  .testimonial-role { margin: 4px 0 0; color: var(--on-petrol-dim); overflow-wrap: anywhere; }
  .testimonials-secondary { gap: 0; }
  .testimonial { display: flex; flex-direction: column; width: 82vw; min-width: 0; margin: 0; padding: 0 24px; border-left: 1px solid var(--line-petrol); }
  .testimonial:first-child { padding-left: 0; border-left: 0; }
  .testimonial blockquote { flex: 1; margin-bottom: 28px; font-size: var(--fs-body); line-height: 1.55; }
  @media (min-width: 768px) {
    .testimonial-featured { display: grid; grid-template-columns: minmax(0, 2fr) minmax(0, 1fr); align-items: end; gap: 48px; margin-bottom: 48px; padding-block: 48px; }
    .testimonial-featured blockquote { margin-bottom: 0; font-size: var(--fs-quote); }
    .testimonials-secondary { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 32px 0; max-width: var(--maxw); margin-inline: auto; padding-inline: var(--gutter); overflow: visible; }
    .testimonial { width: auto; padding-inline: 20px; }
    .testimonial:nth-child(3n + 1) { border-left: 0; padding-left: 0; }
    .testimonial:nth-child(3n) { padding-right: 0; }
  }
  @media (min-width: 1200px) {
    .testimonials-secondary { grid-template-columns: repeat(5, minmax(0, 1fr)); }
    .testimonial:nth-child(n) { padding-inline: 20px; border-left: 1px solid var(--line-petrol); }
    .testimonial:first-child { padding-left: 0; border-left: 0; }
    .testimonial:last-child { padding-right: 0; }
  }
</style>
