---
---
<div class="relative h-32 w-full bg-black overflow-hidden pointer-events-none">
  <!-- Diagonal Cut Background -->
  <div class="absolute inset-0 bg-black">
    <svg class="absolute inset-0 w-full h-full" preserveAspectRatio="none" viewBox="0 0 100 100" fill="none">
      <path d="M0 100 L100 0" stroke="rgba(139, 92, 246, 0.4)" stroke-width="0.5" />
      <path d="M0 100 L100 0 V100 H0 Z" fill="rgba(139, 92, 246, 0.02)" />
    </svg>
  </div>

  <!-- Animated Scanline -->
  <div class="absolute inset-0 opacity-10" 
       style="background: linear-gradient(to bottom, transparent, rgba(139, 92, 246, 0.3), transparent); height: 30%; top: -30%; animation: scanline 3s linear infinite;">
  </div>
</div>

<style>
  @keyframes scanline {
    0% { top: -30%; }
    100% { top: 130%; }
  }
</style>
