---
import { ClientRouter } from 'astro:transitions';
import Header from '../components/Header.tsx';
import Footer from '../components/Footer.astro';
import WhatsAppButton from '../components/WhatsAppButton';
import '../styles/global.css';
import { LOGO } from '../lib/cloudinary';
import { PLANES_WEB, SOFTWARE, EXTRA_IA } from '../lib/pricing';
import { cargarPrecios } from '../lib/pricing-remoto';

// Importes editados desde /admin/precios (si los hay) antes de armar el schema.
await cargarPrecios();

// Ofertas para Google, armadas desde la fuente única de precios.
const ofertas = [
  ...PLANES_WEB.flatMap((p) => [
    {
      "@type": "Offer", "name": `${p.nombre} — alta + abono mensual`, "price": String(p.abono.alta), "priceCurrency": "ARS",
      "priceSpecification": [
        { "@type": "UnitPriceSpecification", "name": "Alta", "price": p.abono.alta, "priceCurrency": "ARS" },
        { "@type": "UnitPriceSpecification", "name": "Abono mensual", "price": p.abono.mensual, "priceCurrency": "ARS", "billingDuration": "P1M", "unitCode": "MON" },
      ],
    },
  ]),
  {
    "@type": "Offer", "name": `${EXTRA_IA.nombre} (extra)`, "price": String(EXTRA_IA.abono.alta), "priceCurrency": "ARS",
    "priceSpecification": [
      { "@type": "UnitPriceSpecification", "name": "Alta", "price": EXTRA_IA.abono.alta, "priceCurrency": "ARS" },
      { "@type": "UnitPriceSpecification", "name": "Abono mensual", "price": EXTRA_IA.abono.mensual, "priceCurrency": "ARS", "billingDuration": "P1M", "unitCode": "MON" },
    ],
  },
  { "@type": "Offer", "name": SOFTWARE.nombre, "priceSpecification": { "@type": "PriceSpecification", "minPrice": SOFTWARE.desde, "priceCurrency": "ARS" } },
];
const montos = [...PLANES_WEB.map((p) => p.abono.alta), SOFTWARE.desde];
const fmt = (n: number) => `$${n.toLocaleString('es-AR')}`;
const priceRange = `${fmt(Math.min(...montos))} - ${fmt(Math.max(...montos))} ARS`;

interface Props {
  title?: string;
  description?: string;
  /** 'landing': página para anuncios, sin el menú del sitio (trae su propio encabezado y pie). */
  variant?: 'home' | 'landing';
  /** Mensaje con el que abre el botón flotante de WhatsApp. */
  waMessage?: string;
}

const {
  title = "Selva Digital - Desarrollo web freelance para PyMEs en Argentina",
  description = "Desarrollo sitios web, e-commerce, sistemas a medida y chatbots con IA que convierten visitantes en clientes. Presupuesto gratis. Córdoba, Argentina.",
  variant = 'home',
  waMessage,
} = Astro.props;
const esLanding = variant === 'landing';

const canonicalURL = new URL(Astro.url.pathname, Astro.site || 'https://www.selvadigital.com');
const googleAnalyticsId = import.meta.env.PUBLIC_GA_ID;
// Pixel de Meta: sólo se carga si PUBLIC_META_PIXEL_ID está configurada (en Vercel).
const metaPixelId = import.meta.env.PUBLIC_META_PIXEL_ID;

const schemaOrgJSON = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Person",
      "@id": "https://www.selvadigital.com/#person",
      "name": "Christian Speziali",
      "alternateName": "Selva Digital",
      "description": "Desarrollador web freelance — diseño, desarrollo, e-commerce, sistemas a medida y chatbots con IA para PyMEs en Argentina",
      "url": "https://www.selvadigital.com",
      "telephone": "+54-9-3757-652003",
      "email": "info.selvadigital@gmail.com",
      "image": "https://res.cloudinary.com/djtvjkcu6/image/upload/v1778507882/SelvaDigital/yo_perfil_ekrrxc.jpg",
      "jobTitle": "Desarrollador web freelance",
      "address": {
        "@type": "PostalAddress",
        "addressLocality": "Córdoba",
        "addressCountry": "AR"
      },
      "areaServed": { "@type": "Country", "name": "Argentina" }
    },
    {
      "@type": "ProfessionalService",
      "@id": "https://www.selvadigital.com/#service",
      "name": "Selva Digital",
      "url": "https://www.selvadigital.com",
      "image": LOGO.og,
      "logo": LOGO.square,
      "telephone": "+54-9-3757-652003",
      "email": "info.selvadigital@gmail.com",
      "priceRange": priceRange,
      "address": {
        "@type": "PostalAddress",
        "addressLocality": "Córdoba",
        "addressCountry": "AR"
      },
      "areaServed": { "@type": "Country", "name": "Argentina" },
      "provider": { "@id": "https://www.selvadigital.com/#person" },
      "hasOfferCatalog": {
        "@type": "OfferCatalog",
        "name": "Planes y servicios",
        "itemListElement": ofertas
      }
    },
    {
      "@type": "WebSite",
      "@id": "https://www.selvadigital.com/#website",
      "url": "https://www.selvadigital.com",
      "name": "Selva Digital",
      "inLanguage": "es-AR",
      "publisher": { "@id": "https://www.selvadigital.com/#service" }
    }
  ]
};
---
<!DOCTYPE html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description}>
    <link rel="canonical" href={canonicalURL} />
    <ClientRouter />
    <meta name="author" content="Selva Digital">
    <meta property="og:title" content={title}>
    <meta property="og:description" content={description}>
    <meta property="og:image" content={LOGO.og}>
    <meta property="og:image:width" content="1200">
    <meta property="og:image:height" content="630">
    <meta property="og:image:alt" content="Selva Digital — desarrollo web freelance para PyMEs">
    <meta property="og:url" content={canonicalURL}>
    <meta property="og:type" content="website">
    <meta property="og:locale" content="es_AR">
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content={title}>
    <meta name="twitter:description" content={description}>

    <meta http-equiv="X-Content-Type-Options" content="nosniff">
    <meta http-equiv="X-Frame-Options" content="DENY">
    <meta name="referrer" content="strict-origin-when-cross-origin">

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link
      href="https://fonts.googleapis.com/css2?family=Archivo:wdth,wght@62..125,100..900&family=Martian+Mono:wdth,wght@87.5..112.5,400..500&family=Doto:wght@600..900&display=swap"
      rel="stylesheet"
    />
    <meta name="theme-color" content="#102D35" />
    <script is:inline>document.documentElement.classList.add("js");</script>

    <script type="application/ld+json" set:html={JSON.stringify(schemaOrgJSON)} />
    {googleAnalyticsId && (
      <>
        <script async src={`https://www.googletagmanager.com/gtag/js?id=${googleAnalyticsId}`}></script>
        <script define:vars={{ googleAnalyticsId }}>
          window.dataLayer = window.dataLayer || [];
          function gtag() {
            dataLayer.push(arguments);
          }
          gtag('js', new Date());
          gtag('config', googleAnalyticsId);
        </script>
      </>
    )}
    {metaPixelId && (
      <script is:inline define:vars={{ metaPixelId }}>
        if (!window.fbq) {
          !function(f,b,e,v,n,t,s){if(f.fbq)return;n=f.fbq=function(){n.callMethod?
          n.callMethod.apply(n,arguments):n.queue.push(arguments)};if(!f._fbq)f._fbq=n;
          n.push=n;n.loaded=!0;n.version='2.0';n.queue=[];t=b.createElement(e);t.async=!0;
          t.src=v;s=b.getElementsByTagName(e)[0];s.parentNode.insertBefore(t,s)}(window,
          document,'script','https://connect.facebook.net/en_US/fbevents.js');
          fbq('init', metaPixelId);
          fbq('track', 'PageView');
          // Navegación interna (View Transitions): cada página nueva cuenta como visita.
          document.addEventListener('astro:after-swap', function () { fbq('track', 'PageView'); });
        }
      </script>
    )}
    <script is:inline>
      // Cada clic a WhatsApp es la conversión del sitio: se avisa a Meta (Contact) y a Google Analytics.
      if (!window.__sdWaTrack) {
        window.__sdWaTrack = true;
        document.addEventListener('click', function (e) {
          var a = e.target instanceof Element ? e.target.closest('a[href*="wa.me/"]') : null;
          if (!a) return;
          var origen = a.getAttribute('data-wa-origen') || location.pathname;
          if (window.fbq) window.fbq('track', 'Contact', { content_name: origen });
          if (window.gtag) window.gtag('event', 'whatsapp_click', { event_category: 'Contact', event_label: origen });
        });
      }
    </script>
  </head>
  <body>
    {esLanding ? <slot name="header" /> : <Header client:load transition:persist />}
    <main>
      <slot />
    </main>
    {esLanding ? <slot name="footer" /> : <Footer />}
    <WhatsAppButton client:load message={waMessage} />

  </body>
</html>
