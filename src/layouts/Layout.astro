---
import { ClientRouter } from 'astro:transitions';
import Header from '../components/Header.tsx';
import Footer from '../components/Footer.astro';
import WhatsAppButton from '../components/WhatsAppButton';
import '../styles/global.css';
import { LOGO } from '../lib/cloudinary';

interface Props {
  title?: string;
  description?: string;
}

const { 
  title = "Selva Digital - Desarrollo web freelance para PyMEs en Argentina",
  description = "Desarrollo sitios web, e-commerce, sistemas a medida y chatbots con IA que convierten visitantes en clientes. Presupuesto gratis. Córdoba, Argentina."
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site || 'https://www.selvadigital.com');
const googleAnalyticsId = import.meta.env.PUBLIC_GA_ID;

const schemaOrgJSON = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Person",
      "@id": "https://www.selvadigital.com/#person",
      "name": "Christian Speziali",
      "alternateName": "Selva Digital",
      "description": "Desarrollador web freelance — diseño, desarrollo, e-commerce, sistemas a medida y chatbots con IA para PyMEs en Argentina",
      "url": "https://www.selvadigital.com",
      "telephone": "+54-9-3757-652003",
      "email": "info.selvadigital@gmail.com",
      "image": "https://res.cloudinary.com/djtvjkcu6/image/upload/v1778507882/SelvaDigital/yo_perfil_ekrrxc.jpg",
      "jobTitle": "Desarrollador web freelance",
      "address": {
        "@type": "PostalAddress",
        "addressLocality": "Córdoba",
        "addressCountry": "AR"
      },
      "areaServed": { "@type": "Country", "name": "Argentina" }
    },
    {
      "@type": "ProfessionalService",
      "@id": "https://www.selvadigital.com/#service",
      "name": "Selva Digital",
      "url": "https://www.selvadigital.com",
      "image": LOGO.og,
      "logo": LOGO.square,
      "telephone": "+54-9-3757-652003",
      "email": "info.selvadigital@gmail.com",
      "priceRange": "$250.000 - $1.500.000 ARS",
      "address": {
        "@type": "PostalAddress",
        "addressLocality": "Córdoba",
        "addressCountry": "AR"
      },
      "areaServed": { "@type": "Country", "name": "Argentina" },
      "provider": { "@id": "https://www.selvadigital.com/#person" },
      "hasOfferCatalog": {
        "@type": "OfferCatalog",
        "name": "Planes y servicios",
        "itemListElement": [
          { "@type": "Offer", "name": "Landing Page",           "price": "250000",  "priceCurrency": "ARS" },
          { "@type": "Offer", "name": "Sitio Web Corporativo",  "price": "350000",  "priceCurrency": "ARS" },
          { "@type": "Offer", "name": "Sitio Web Extendido",    "price": "450000",  "priceCurrency": "ARS" },
          { "@type": "Offer", "name": "Tienda E-commerce",      "price": "1300000", "priceCurrency": "ARS" },
          { "@type": "Offer", "name": "Sistema a medida",       "price": "1200000", "priceCurrency": "ARS" },
          { "@type": "Offer", "name": "Chatbot con IA",         "price": "1500000", "priceCurrency": "ARS" },
          { "@type": "Offer", "name": "App a medida" }
        ]
      }
    },
    {
      "@type": "WebSite",
      "@id": "https://www.selvadigital.com/#website",
      "url": "https://www.selvadigital.com",
      "name": "Selva Digital",
      "inLanguage": "es-AR",
      "publisher": { "@id": "https://www.selvadigital.com/#service" }
    }
  ]
};
---
<!DOCTYPE html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description}>
    <link rel="canonical" href={canonicalURL} />
    <ClientRouter />
    <meta name="author" content="Selva Digital">
    <meta property="og:title" content={title}>
    <meta property="og:description" content={description}>
    <meta property="og:image" content={LOGO.og}>
    <meta property="og:image:width" content="1200">
    <meta property="og:image:height" content="630">
    <meta property="og:image:alt" content="Selva Digital — desarrollo web freelance para PyMEs">
    <meta property="og:url" content={canonicalURL}>
    <meta property="og:type" content="website">
    <meta property="og:locale" content="es_AR">
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content={title}>
    <meta name="twitter:description" content={description}>

    <meta http-equiv="X-Content-Type-Options" content="nosniff">
    <meta http-equiv="X-Frame-Options" content="DENY">
    <meta name="referrer" content="strict-origin-when-cross-origin">

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link
      href="https://fonts.googleapis.com/css2?family=Archivo:wdth,wght@62..125,100..900&family=Martian+Mono:wdth,wght@87.5..112.5,400..500&family=Doto:wght@600..900&display=swap"
      rel="stylesheet"
    />
    <meta name="theme-color" content="#102D35" />
    <script is:inline>document.documentElement.classList.add("js");</script>

    <script type="application/ld+json" set:html={JSON.stringify(schemaOrgJSON)} />
    {googleAnalyticsId && (
      <>
        <script async src={`https://www.googletagmanager.com/gtag/js?id=${googleAnalyticsId}`}></script>
        <script define:vars={{ googleAnalyticsId }}>
          window.dataLayer = window.dataLayer || [];
          function gtag() {
            dataLayer.push(arguments);
          }
          gtag('js', new Date());
          gtag('config', googleAnalyticsId);
        </script>
      </>
    )}
  </head>
  <body>
    <Header client:load transition:persist />
    <main>
      <slot />
    </main>
    <Footer />
    <WhatsAppButton client:load transition:persist />

  </body>
</html>
