---
import AdminLayout from '../../../../layouts/AdminLayout.astro';
import ClientForm from '../../../../components/admin/ClientForm';
import AdminRouteGuard from '../../../../components/admin/AdminRouteGuard';
import { supabaseAdmin } from '../../../../lib/supabase-server';

const { id } = Astro.params;
const { data: client } = await supabaseAdmin.from('clients').select('*').eq('id', id).single();
---

<AdminLayout title="Editar Cliente | Panel Admin">
  <AdminRouteGuard client:load>
    <div class="min-h-screen bg-[var(--petrol)]">
      <header class="border-b border-[var(--line-petrol)] bg-[var(--petrol-deep)]">
        <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
          <div class="flex items-center justify-between h-16">
            <div class="flex items-center gap-3">
              <span class="text-lg font-bold text-[var(--ice)]">Selva Digital</span>
              <span class="text-[var(--on-petrol-soft)]">|</span>
              <span class="text-sm text-[var(--on-petrol-dim)]">Editar cliente</span>
            </div>
            <a href="/admin" class="btn btn-ghost text-sm text-[var(--on-petrol-dim)]  transition-colors">
              ← Volver
            </a>
          </div>
        </div>
      </header>

      <main class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
        {client ? (
          <ClientForm client={client} client:load />
        ) : (
          <div class="text-center py-12">
            <p class="text-[var(--on-petrol-soft)]">Cliente no encontrado</p>
            <a href="/admin" class="btn btn-ghost text-sm text-[var(--on-petrol-soft)] hover:text-[var(--on-petrol-soft)] mt-2 inline-block">
              ← Volver al dashboard
            </a>
          </div>
        )}
      </main>
    </div>
  </AdminRouteGuard>
</AdminLayout>
