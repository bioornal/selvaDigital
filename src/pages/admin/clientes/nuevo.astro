---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import ClientForm from '../../../components/admin/ClientForm';
import AdminRouteGuard from '../../../components/admin/AdminRouteGuard';
---

<AdminLayout title="Nuevo Cliente | Panel Admin">
  <AdminRouteGuard client:load>
    <div class="min-h-screen bg-[var(--petrol)]">
      <header class="border-b border-[var(--line-petrol)] bg-[var(--petrol-deep)]">
        <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
          <div class="flex items-center justify-between h-16">
            <div class="flex items-center gap-3">
              <span class="text-lg font-bold text-[var(--ice)]">Selva Digital</span>
              <span class="text-[var(--on-petrol-soft)]">|</span>
              <span class="text-sm text-[var(--on-petrol-dim)]">Nuevo cliente</span>
            </div>
            <a href="/admin" class="btn btn-ghost text-sm text-[var(--on-petrol-dim)]  transition-colors">
              ← Volver
            </a>
          </div>
        </div>
      </header>

      <main class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
        <h1 class="text-xl font-bold text-[var(--ice)] mb-6">Crear nuevo cliente</h1>
        <ClientForm client:load />
      </main>
    </div>
  </AdminRouteGuard>
</AdminLayout>
