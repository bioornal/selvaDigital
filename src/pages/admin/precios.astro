---
import AdminLayout from '../../layouts/AdminLayout.astro';
import AdminPrecios from '../../components/admin/AdminPrecios';
import AdminRouteGuard from '../../components/admin/AdminRouteGuard';
---

<AdminLayout title="Precios | Panel Admin">
  <AdminRouteGuard client:load>
    <div class="min-h-screen bg-[var(--petrol)]">
      <header class="border-b border-[var(--line-petrol)] bg-[var(--petrol-deep)]">
        <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
          <div class="flex items-center justify-between h-16">
            <div class="flex items-center gap-3">
              <span class="text-lg font-bold text-[var(--ice)]">Selva Digital</span>
              <span class="text-[var(--on-petrol-soft)]">|</span>
              <span class="text-sm text-[var(--on-petrol-dim)]">Precios</span>
            </div>
            <a href="/admin" class="btn btn-ghost text-sm text-[var(--on-petrol-dim)] transition-colors">
              ← Volver
            </a>
          </div>
        </div>
      </header>

      <main class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
        <AdminPrecios client:load />
      </main>
    </div>
  </AdminRouteGuard>
</AdminLayout>
