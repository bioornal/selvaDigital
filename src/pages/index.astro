---
export const prerender = true;

import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import Portfolio from '../components/Portfolio.astro';
import ServicesV2 from '../components/ServicesV2.astro';
import AboutV2 from '../components/AboutV2.astro';
import Testimonios from '../components/Testimonios.astro';
import Precios from '../components/Precios.astro';
import FAQ from '../components/FAQ.astro';
import Contact from '../components/Contact';
import VisualBreak from '../components/VisualBreak.astro';
import { IMG } from '../lib/cloudinary';
import WhyWeb from '../components/WhyWeb.astro';
---

<Layout
  title="Selva Digital - Desarrollo web freelance para PyMEs en Argentina"
  description="Desarrollo sitios web, e-commerce, sistemas a medida y chatbots con IA para tu web que convierten visitantes en clientes. Precio fijo, pago único. Córdoba, Argentina."
>
  <!-- 1. La promesa -->
  <Hero />
  <!-- 1b. El argumento principal: por qué tu negocio necesita una web -->
  <WhyWeb />
  <!-- 2. La prueba: único lugar con proyectos y métricas -->
  <Portfolio />
  <!-- 3. Qué resuelvo (sin precios; chatbot web destacado) -->
  <ServicesV2 />
  <!-- 4. Cómo trabajo: persona + trato directo + proceso -->
  <AboutV2 />
  <!-- 5. Lo que dicen los clientes -->
  <Testimonios />
  <VisualBreak
    image={IMG.sepLive}
    title="Todo lo que ves acá está funcionando."
    href="#portfolio"
    cta="Abrir los trabajos"
  />
  <!-- 6. Precios: único lugar con cifras, 50/50 y hosting -->
  <Precios />
  <!-- 7. Preguntas que no se respondieron antes -->
  <FAQ />
  <!-- 8. Contacto -->
  <Contact client:visible />
</Layout>
