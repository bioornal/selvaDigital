---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import ServicesV2 from '../components/ServicesV2.astro';
import Portfolio from '../components/Portfolio.astro';
import Testimonios from '../components/Testimonios.astro';
import AIChatbots from '../components/AIChatbots.astro';
import Apps from '../components/Apps.astro';
import Precios from '../components/Precios.astro';
import FAQ from '../components/FAQ.astro';
import AboutV2 from '../components/AboutV2.astro';
import Manifiesto from '../components/Manifiesto.astro';
import Contact from '../components/Contact';
import SectionDivider from '../components/SectionDivider.astro';
---

<Layout 
  title="Selva Digital - Desarrollo web freelance para PyMEs en Argentina"
  description="Desarrollo sitios web, e-commerce, sistemas a medida y chatbots con IA que convierten visitantes en clientes. Presupuesto gratis. Córdoba, Argentina."
>
  <Hero />
  <ServicesV2 />
  <div class="md:hidden" style="height:1px; background:rgba(250,250,250,0.08);"></div>
  <Portfolio />
  <div class="md:hidden" style="height:1px; background:rgba(250,250,250,0.08);"></div>
  <Testimonios />
  <AIChatbots />
  <div class="md:hidden" style="height:1px; background:rgba(250,250,250,0.08);"></div>
  <Apps />
  <div class="md:hidden" style="height:1px; background:rgba(250,250,250,0.08);"></div>
  <Precios />
  <div class="md:hidden" style="height:1px; background:rgba(250,250,250,0.08);"></div>
  <FAQ />
  <div class="md:hidden" style="height:1px; background:rgba(250,250,250,0.08);"></div>
  <AboutV2 />
  <Manifiesto />
  <SectionDivider />
  <Contact client:load />
</Layout>
