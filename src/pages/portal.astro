---
import PortalFlow from '../components/client-portal/PortalFlow';
import '../styles/global.css';
import '../styles/portal.css';
---

<!DOCTYPE html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex, nofollow" />
    <title>Portal de Clientes | Selva Digital</title>
    <meta name="description" content="Sube la información y archivos requeridos para tu proyecto digital con Selva Digital de forma simple y segura." />
    <link rel="icon" type="image/webp" href="https://res.cloudinary.com/djtvjkcu6/image/upload/v1778600745/SelvaDigital/favicon_mamfqa.webp" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Archivo:wdth,wght@62..125,100..900&family=Martian+Mono:wdth,wght@87.5..112.5,400..500&display=swap" rel="stylesheet" />
  </head>
  <body class="portal-body min-h-screen">
    
    <PortalFlow client:load />
