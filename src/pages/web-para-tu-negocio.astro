---
// Landing para anuncios de Meta (Instagram/Facebook). Continúa el flyer
// «Tu web profesional, sin pagar todo de golpe.»: mismo titular, mismo precio,
// una sola acción (WhatsApp). Sin menú del sitio para que nadie se pierda.
export const prerender = true;

import Layout from '../layouts/Layout.astro';
import WaIcon from '../components/ui/WaIcon';
import { IMG, LOGO, cld, cldSrcset } from '../lib/cloudinary';
import { whatsappLink, WHATSAPP_URL } from '../lib/constants';
import { PLANES_WEB, CONDICIONES, TRANQUILIDAD, formatARS } from '../lib/pricing';
import { cargarPrecios } from '../lib/pricing-remoto';

// Mismos importes que la home (los edita /admin/precios).
await cargarPrecios();

const entrada = PLANES_WEB.find((p) => p.id === 'landing') ?? PLANES_WEB[0];
const tienda = PLANES_WEB.find((p) => p.id === 'ecommerce');

const MSG_ANUNCIO = '¡Hola Christian! Vengo del anuncio y quiero mi web. ¿Me contás cómo arrancamos?';
const WA = whatsappLink(MSG_ANUNCIO);
const waPlan = (p: (typeof PLANES_WEB)[number]) => whatsappLink(
  `¡Hola Christian! Vengo del anuncio. Me interesa el plan ${p.nombre} (${formatARS(p.abono.alta)} de alta y ${formatARS(p.abono.mensual)}/mes). ¿Me pasás más info?`,
);

// Capturas 16:10 desde arriba, como en Trabajos de la home.
const SHOT = 'c_fill,g_north,ar_16:10';
const shot = (path: string, w = 800) => cld(path, w, SHOT);
const shotSet = (path: string) => cldSrcset(path, [480, 800, 1200], SHOT);

// Visor del hero: webs reales que rotan.
const vitrina = [
  { nombre: 'Impasto Pizzería', dominio: 'impastopizzas.com', img: IMG.impasto },
  { nombre: 'Aruma Lodge', dominio: 'arumalodgeiguazu.com', img: IMG.aruma },
  { nombre: 'Vip Traslados Iguazú', dominio: 'Vip Traslados Iguazú · landing', img: IMG.vip },
];

// Trabajos: otros sitios, para no repetir capturas del hero.
const trabajos = [
  { nombre: 'Iguazú Falls Lodge', rubro: 'Hotel', img: IMG.iguazuFalls, url: 'https://www.iguazufallslodge.com/' },
  { nombre: 'La Casa del Lago', rubro: 'Cabañas', img: IMG.casaDelLago, url: 'https://lacasadellagouruguai.com/' },
  { nombre: 'Olietta Joyería', rubro: 'Joyería', img: IMG.olietta, url: 'https://olietta-joyeria.netlify.app/' },
  { nombre: 'MegaMuebles', rubro: 'Mueblería', img: IMG.megamuebles, url: 'https://megamueblessommiers.online' },
];

const pasos = [
  { titulo: 'Me escribís', detalle: 'Me contás de tu negocio por WhatsApp y te digo qué plan te conviene y cuánto cuesta.' },
  { titulo: 'Pagás el alta y arranco', detalle: 'Diseño tu web con tus textos, fotos y datos. Vos la revisás antes de publicarla.' },
  { titulo: 'Tu web online', detalle: 'Desde ahí pagás el abono mensual: hosting, cambios chicos y soporte, todo incluido.' },
];

const preguntas = [
  { q: '¿Qué pasa después de la permanencia mínima?', a: `${CONDICIONES.abono.baja} ${CONDICIONES.abono.pasarAUnico}` },
  { q: '¿De quién es el dominio?', a: CONDICIONES.abono.dominio },
  { q: '¿Qué cambios entran en el abono?', a: `${CONDICIONES.abono.incluye[1]}. Páginas nuevas, rediseños o funciones nuevas los cotizo aparte y arranco sólo con tu aprobación.` },
  { q: '¿El abono aumenta?', a: CONDICIONES.abono.ajuste },
  ...(tienda ? [{
    q: '¿Y si quiero vender online?',
    a: `Para eso está la ${tienda.nombre}: catálogo con carrito, cobro con Mercado Pago y panel para cargar productos. Arranca con ${formatARS(tienda.abono.alta)} de alta y ${formatARS(tienda.abono.mensual)} por mes, con un mínimo de ${tienda.abono.permanenciaMeses} meses, y ya incluye el asistente con IA.`,
  }] : []),
  { q: '¿Me garantizás más ventas?', a: `No. ${CONDICIONES.abono.noPromete} Lo que sí hago es que tu negocio se vea profesional y que escribirte sea fácil desde cualquier celular.` },
];
---

<Layout
  variant="landing"
  waMessage={MSG_ANUNCIO}
  title="Tu web profesional, sin pagar todo de golpe | Selva Digital"
  description={`Página web para tu negocio desde ${formatARS(entrada.abono.alta)} de alta y ${formatARS(entrada.abono.mensual)} por mes, con hosting, cambios y soporte incluidos. Desarrollo freelance para PyMEs de toda Argentina.`}
>
  <header slot="header" class="lp-header">
    <div class="wrap lp-header-row">
      <a href="/" class="lp-logo" aria-label="Selva Digital — ir al sitio completo">
        <img src={LOGO.horizontal} alt="Selva Digital" width="173" height="66" decoding="async" fetchpriority="high" />
      </a>
      <a href={WA} class="btn btn-primary lp-header-cta" target="_blank" rel="noopener noreferrer" data-wa-origen="landing-header">
        <WaIcon size={18} />Escribime
      </a>
    </div>
  </header>

  <!-- 1. La promesa del anuncio, con el precio -->
  <section class="lp-hero on-petrol" aria-labelledby="lp-title">
    <div class="wrap lp-hero-grid">
      <div class="lp-hero-copy">
        <h1 id="lp-title" class="lp-h1">
          <span class="mask-line">Tu web profesional,</span>
          <span class="mask-line"><span class="hl" data-text="sin pagar">sin pagar</span></span>
          <span class="mask-line"><span class="hl hl-2" data-text="todo de golpe.">todo de golpe.</span></span>
        </h1>
        <p class="lede lp-lede fade-late">Diseño y desarrollo la web de tu negocio. Arrancás con una entrada baja y después pagás un abono que incluye hosting, cambios y soporte.</p>
        <div class="lp-price fade-late">
          <p class="mono">Para arrancar</p>
          <p class="lp-price-row">
            <span class="dot-num lp-price-num">{formatARS(entrada.abono.alta)}</span>
            <span class="lp-price-month">+ {formatARS(entrada.abono.mensual)}<span>/mes</span></span>
          </p>
          <p class="lp-price-note">{entrada.nombre} · mínimo {entrada.abono.permanenciaMeses} meses · dominio a tu nombre, aparte</p>
        </div>
        <div class="lp-actions fade-late">
          <a href={WA} class="btn btn-primary lp-cta" target="_blank" rel="noopener noreferrer" data-wa-origen="landing-hero">
            <WaIcon size={19} />Quiero mi web
          </a>
          <a href="#planes" class="btn btn-ghost">Ver los planes</a>
        </div>
      </div>

      <figure class="lp-viewer fade-late" aria-label="Webs que ya hice, una por una">
        <div class="lp-viewer-bar">
          <span class="lp-dots" aria-hidden="true"><i></i><i></i><i></i></span>
          <span class="mono lp-viewer-url" aria-live="off" data-viewer-url>{vitrina[0].dominio}</span>
          <button type="button" class="mono lp-viewer-toggle" data-viewer-toggle aria-pressed="false">Pausar</button>
        </div>
        <div class="lp-viewer-stage">
          {vitrina.map((v, i) => (
            <img
              src={shot(v.img)}
              srcset={shotSet(v.img)}
              sizes="(min-width: 1024px) 46vw, 92vw"
              alt={`Web de ${v.nombre}`}
              width="800" height="500"
              class:list={['lp-shot', { 'is-on': i === 0 }]}
              data-url={v.dominio}
              loading={i === 0 ? 'eager' : 'lazy'}
              decoding="async"
            />
          ))}
        </div>
      </figure>
    </div>
  </section>

  <!-- 2. Prueba: webs reales que se pueden abrir -->
  <section class="section on-deep" aria-labelledby="lp-trabajos">
    <div class="wrap">
      <h2 id="lp-trabajos" class="h2 lp-section-title">Webs reales, online hoy.<br /><mark>Abrilas y probalas.</mark></h2>
      <ul class="lp-work" role="list">
        {trabajos.map((t) => (
          <li>
            <a href={t.url} class="lp-work-card" target="_blank" rel="noopener noreferrer">
              <span class="lp-work-frame">
                <img src={shot(t.img)} srcset={shotSet(t.img)} sizes="(min-width: 1024px) 31vw, (min-width: 640px) 46vw, 92vw" alt={`Web de ${t.nombre}`} width="800" height="500" loading="lazy" decoding="async" />
              </span>
              <span class="lp-work-meta">
                <span class="h3">{t.nombre}</span>
                <span class="mono">{t.rubro} · Abrir ↗</span>
              </span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- 3. Cómo funciona el abono: pasos + qué incluye -->
  <section class="section on-ice" aria-labelledby="lp-como">
    <div class="wrap">
      <h2 id="lp-como" class="h2 lp-section-title">Cómo funciona, sin letra chica.</h2>
      <ol class="lp-steps">
        {pasos.map((p, i) => (
          <li>
            <span class="dot-num" aria-hidden="true">{i + 1}</span>
            <strong>{p.titulo}</strong>
            <span>{p.detalle}</span>
          </li>
        ))}
      </ol>
      <div class="lp-include">
        <div>
          <h3 class="lp-include-title">Lo que paga el abono</h3>
          <ul>{CONDICIONES.abono.incluye.map((c) => <li>{c}</li>)}</ul>
        </div>
        <div>
          <h3 class="lp-include-title">Lo que se cotiza aparte</h3>
          <ul>{CONDICIONES.abono.excluye.map((c) => <li>{c}</li>)}</ul>
        </div>
      </div>
    </div>
  </section>

  <!-- 4. Planes: los mismos importes de la home -->
  <section id="planes" class="section on-petrol" aria-labelledby="lp-planes">
    <div class="wrap">
      <h2 id="lp-planes" class="h2 lp-section-title">Elegí cuánto necesita tu negocio.</h2>
      <ul class="lp-plans" role="list">
        {PLANES_WEB.map((p) => (
          <li class:list={['lp-plan', { 'is-featured': p.destacado }]}>
            <div class="lp-plan-name">
              <h3 class="h3">{p.nombre}</h3>
              <p class="mono">{p.destacado ? 'Mi recomendación' : (p.sub ?? `${p.features[0]}`)}</p>
            </div>
            <ul class="lp-plan-features">{p.features.slice(0, 3).map((f) => <li>{f}</li>)}</ul>
            <div class="lp-plan-price">
              <p><span class="dot-num">{formatARS(p.abono.alta)}</span><span class="mono">de alta</span></p>
              <p class="lp-plan-month">+ {formatARS(p.abono.mensual)}/mes · mínimo {p.abono.permanenciaMeses} meses</p>
            </div>
            <a href={waPlan(p)} class={`btn ${p.destacado ? 'btn-primary' : 'btn-ghost'}`} target="_blank" rel="noopener noreferrer" data-wa-origen={`landing-plan-${p.id}`}>
              <WaIcon size={18} />Quiero este plan<span class="sr-only">: {p.nombre}</span>
            </a>
          </li>
        ))}
      </ul>
      <p class="lp-reassure">{TRANQUILIDAD}</p>
    </div>
  </section>

  <!-- 5. Dudas de quien viene del anuncio -->
  <section class="section on-deep" aria-labelledby="lp-faq">
    <div class="wrap lp-faq-grid">
      <h2 id="lp-faq" class="h2 lp-section-title">Lo que me preguntan antes de arrancar.</h2>
      <div class="lp-faq">
        {preguntas.map((p) => (
          <details>
            <summary>{p.q}</summary>
            <p>{p.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- 6. Cierre: una sola acción -->
  <section class="section on-petrol lp-close" aria-labelledby="lp-cierre">
    <div class="wrap">
      <h2 id="lp-cierre" class="lp-close-title">Contame de tu negocio.</h2>
      <p class="lede">Te respondo con el plan que te conviene y lo que cuesta, sin vueltas.</p>
      <a href={WA} class="btn btn-primary lp-cta" target="_blank" rel="noopener noreferrer" data-wa-origen="landing-cierre">
        <WaIcon size={19} />Escribime por WhatsApp
      </a>
      <p class="lp-reassure">{TRANQUILIDAD}</p>
    </div>
  </section>

  <footer slot="footer" class="lp-footer on-petrol">
    <div class="wrap lp-footer-row mono">
      <p>© 2026 Selva Digital · Desarrollo web desde Iguazú, Misiones, para toda Argentina</p>
      <nav aria-label="Más de Selva Digital">
        <a class="link" href="/">Ver el sitio completo</a>
        <a class="link" href="https://www.instagram.com/selvadigital_creaciones/" target="_blank" rel="noopener noreferrer">Instagram ↗</a>
        <a class="link" href={WHATSAPP_URL} target="_blank" rel="noopener noreferrer" data-wa-origen="landing-footer">WhatsApp ↗</a>
      </nav>
    </div>
  </footer>
</Layout>

<script>
  // Visor del hero: cambia de web cada 3,2 s con un barrido. Se pausa con el botón,
  // con la pestaña oculta o si el usuario pidió menos movimiento.
  function initViewer() {
    const stage = document.querySelector<HTMLElement>('.lp-viewer-stage');
    if (!stage || stage.dataset.ready) return;
    stage.dataset.ready = '1';
    const shots = Array.from(stage.querySelectorAll<HTMLImageElement>('.lp-shot'));
    const url = document.querySelector<HTMLElement>('[data-viewer-url]');
    const toggle = document.querySelector<HTMLButtonElement>('[data-viewer-toggle]');
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)');
    let i = 0;
    let paused = reduce.matches;
    let timer: number | undefined;

    const show = (next: number) => {
      shots[i].classList.remove('is-on');
      shots[i].classList.add('is-off');
      const prev = shots[i];
      window.setTimeout(() => prev.classList.remove('is-off'), 900);
      i = next;
      shots[i].classList.add('is-on');
      if (url) url.textContent = shots[i].dataset.url ?? '';
    };
    const stop = () => { window.clearInterval(timer); timer = undefined; };
    const start = () => {
      stop();
      if (paused || document.hidden) return;
      timer = window.setInterval(() => show((i + 1) % shots.length), 3200);
    };
    const sync = () => {
      if (!toggle) return;
      toggle.textContent = paused ? 'Reproducir' : 'Pausar';
      toggle.setAttribute('aria-pressed', String(paused));
    };

    toggle?.addEventListener('click', () => { paused = !paused; sync(); start(); });
    document.addEventListener('visibilitychange', start);
    sync();
    start();
  }
  initViewer();
  document.addEventListener('astro:page-load', initViewer);
</script>

<style>
  .sr-only { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip: rect(0, 0, 0, 0); white-space: nowrap; border: 0; }

  /* Encabezado propio: logo (vuelve al sitio) + una acción */
  .lp-header { position: absolute; inset: 0 0 auto; z-index: 40; }
  .lp-header-row { display: flex; align-items: center; justify-content: space-between; height: var(--header-h); }
  .lp-logo img { display: block; height: var(--logo-h); width: auto; }
  .lp-header-cta { display: none; min-height: 48px; padding: 0 20px; }
  @media (min-width: 768px) { .lp-header-cta { display: inline-flex; } }

  /* Hero */
  .lp-hero { padding: calc(var(--header-h) + clamp(24px, 5vw, 64px)) 0 clamp(64px, 8vw, 112px); }
  .lp-hero-grid { display: grid; gap: clamp(40px, 5vw, 72px); align-items: center; }
  @media (min-width: 1024px) {
    .lp-hero { min-height: 100svh; display: flex; align-items: center; }
    .lp-hero-grid { grid-template-columns: minmax(0, 1.05fr) minmax(0, 1fr); }
    .lp-h1 { font-size: clamp(52px, 4.8vw, 84px); }
  }
  .lp-h1 {
    margin: 0 0 28px;
    /* «todo de golpe.» entra en una línea: en desktop el titular comparte el ancho con el visor */
    font-size: clamp(36px, 11.2vw, 72px);
    font-weight: 800;
    font-variation-settings: 'wdth' 116;
    letter-spacing: -0.035em;
    line-height: 0.95;
    text-wrap: initial;
  }
  .lp-h1 .mask-line { display: block; padding-bottom: .04em; }

  /* Marcador lima que barre detrás de «sin pagar todo de golpe» */
  .hl { position: relative; display: inline-block; padding: 0 .1em; margin-left: -.1em; }
  .hl::after {
    content: attr(data-text);
    position: absolute; inset: 0;
    padding: 0 .1em;
    background: var(--lime);
    color: var(--petrol);
    clip-path: inset(0 0 0 0);
  }
  @media (prefers-reduced-motion: no-preference) {
    :global(.js) .hl::after { clip-path: inset(0 100% 0 0); animation: lpSweep .75s cubic-bezier(0.77, 0, 0.175, 1) .75s forwards; }
    :global(.js) .hl-2::after { animation-delay: 1.05s; }
  }
  @keyframes lpSweep { to { clip-path: inset(0 0 0 0); } }

  .lp-lede { color: var(--on-petrol-soft); margin: 0 0 32px; }
  .lp-price { border-top: 1px solid var(--line-petrol); padding-top: 20px; margin-bottom: 32px; }
  .lp-price .mono { margin: 0 0 10px; color: var(--on-petrol-dim); }
  .lp-price-row { display: flex; flex-wrap: wrap; align-items: baseline; gap: 6px 18px; margin: 0 0 10px; }
  .lp-price-num { font-size: var(--fs-stat); letter-spacing: -0.02em; }
  .lp-price-month { font-size: var(--fs-title); font-weight: 700; }
  .lp-price-month span { color: var(--on-petrol-soft); font-weight: 600; }
  .lp-price-note { margin: 0; font-size: var(--fs-small); color: var(--on-petrol-soft); }
  .lp-actions { display: flex; flex-wrap: wrap; gap: 12px; }
  .lp-actions .btn { flex: 1 1 200px; }
  @media (min-width: 640px) { .lp-actions .btn { flex: 0 0 auto; } }
  .lp-cta { min-height: 56px; }

  /* Pulsar se siente: escala corta en todos los botones de la página */
  .btn { transition: background-color .2s var(--ease-out), box-shadow .2s var(--ease-out), transform .16s var(--ease-out); }
  .btn:active { transform: scale(0.97); }

  /* Visor de webs reales */
  .lp-viewer { margin: 0; border: 1px solid var(--line-petrol-strong); background: var(--petrol-deep); }
  .lp-viewer-bar { display: flex; align-items: center; gap: 14px; height: 44px; padding: 0 6px 0 14px; border-bottom: 1px solid var(--line-petrol); }
  .lp-dots { display: inline-flex; gap: 6px; }
  .lp-dots i { width: 8px; height: 8px; border-radius: 50%; background: var(--line-petrol-strong); }
  .lp-dots i:first-child { background: var(--lime); }
  .lp-viewer-url { flex: 1; min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; color: var(--on-petrol-soft); text-transform: none; }
  .lp-viewer-toggle { min-height: 44px; padding: 0 10px; color: var(--on-petrol-soft); transition: color .2s var(--ease-out); }
  .lp-viewer-toggle:hover { color: var(--ice); }
  .lp-viewer-stage { position: relative; aspect-ratio: 16 / 10; overflow: hidden; }
  .lp-shot { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; object-position: top; opacity: 0; }
  .lp-shot.is-on { opacity: 1; z-index: 2; }
  .lp-shot.is-off { opacity: 1; z-index: 1; }
  @media (prefers-reduced-motion: no-preference) {
    .lp-shot.is-on { animation: lpWipe .9s cubic-bezier(0.77, 0, 0.175, 1) both; }
    .lp-shot.is-on:first-child:not(.is-off) { animation: none; }
    .lp-shot.is-off { animation: lpDim .9s var(--ease-out) both; }
  }
  @keyframes lpWipe { from { clip-path: inset(0 0 100% 0); transform: scale(1.04); } to { clip-path: inset(0 0 0 0); transform: scale(1); } }
  @keyframes lpDim { to { transform: scale(.98); filter: brightness(.6); } }

  .lp-section-title { margin: 0 0 clamp(36px, 5vw, 64px); max-width: 18ch; }
  .lp-section-title mark { background: var(--lime); color: var(--petrol); padding: 0 .1em; box-decoration-break: clone; -webkit-box-decoration-break: clone; }

  /* Trabajos */
  .lp-work { list-style: none; padding: 0; margin: 0; display: grid; gap: 32px 20px; }
  @media (min-width: 640px) { .lp-work { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (min-width: 1200px) { .lp-work { grid-template-columns: repeat(4, minmax(0, 1fr)); } }
  .lp-work-card { display: block; text-decoration: none; color: inherit; }
  .lp-work-frame { display: block; aspect-ratio: 16 / 10; overflow: hidden; border: 1px solid var(--line-petrol); }
  .lp-work-frame img { width: 100%; height: 100%; object-fit: cover; object-position: top; transition: transform .5s var(--ease-out); }
  .lp-work-meta { display: flex; flex-wrap: wrap; align-items: baseline; justify-content: space-between; gap: 6px 16px; padding-top: 16px; }
  .lp-work-meta .mono { color: var(--on-petrol-soft); transition: color .2s var(--ease-out); }
  @media (hover: hover) and (pointer: fine) {
    .lp-work-card:hover .lp-work-frame img { transform: scale(1.025); }
    .lp-work-card:hover .mono { color: var(--lime); }
  }

  /* Cómo funciona */
  .lp-steps { list-style: none; padding: 0; margin: 0 0 clamp(48px, 6vw, 80px); display: grid; gap: 0; }
  .lp-steps li { display: grid; grid-template-columns: auto minmax(0, 1fr); column-gap: 20px; row-gap: 6px; padding: 24px 0; border-top: 2px solid var(--petrol); }
  .lp-steps .dot-num { grid-row: 1 / span 2; font-size: var(--fs-stat); color: var(--petrol); line-height: .9; }
  .lp-steps strong { font-size: var(--fs-title); line-height: 1.2; }
  .lp-steps li > span:last-child { color: var(--on-ice-soft); font-size: var(--fs-control); line-height: 1.5; max-width: 40ch; }
  @media (min-width: 900px) {
    .lp-steps { grid-template-columns: repeat(3, minmax(0, 1fr)); column-gap: clamp(20px, 3vw, 40px); }
  }
  .lp-include { display: grid; gap: 32px clamp(32px, 5vw, 72px); }
  @media (min-width: 768px) { .lp-include { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  .lp-include-title { font-size: var(--fs-title); font-weight: 700; margin: 0 0 12px; }
  .lp-include ul { list-style: none; padding: 0; margin: 0; }
  .lp-include li { padding: 14px 0; border-top: 1px solid var(--line-ice-strong); font-size: var(--fs-control); line-height: 1.5; color: var(--on-ice-soft); }

  /* Planes */
  .lp-plans { list-style: none; padding: 0; margin: 0; border-bottom: 1px solid var(--line-petrol); }
